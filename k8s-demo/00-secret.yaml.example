apiVersion: v1
kind: Secret
metadata:
  name: qldpkh-secrets
  namespace: k8s-hoteluneti
type: Opaque
stringData:
  # Đổi password trước khi copy thành 00-secret.yaml
  sa-password: "CHANGE_ME_StrongPassword@2025!"
  connection-string: "Server=mssql,1433;Database=QLyDatPhongKhachSanDB;User Id=sa;Password=CHANGE_ME_StrongPassword@2025!;TrustServerCertificate=True;MultipleActiveResultSets=true"
  # Chỉ dùng khi SeedSampleData=true; nếu không cần seed có thể bỏ key này.
  seed-admin-password: ""

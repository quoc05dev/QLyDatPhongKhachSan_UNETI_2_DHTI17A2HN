# Sao chep file nay thanh .env roi doi mat khau truoc khi deploy.
# (file .env da duoc .gitignore, khong bi commit len git)
MSSQL_SA_PASSWORD=Your_password123

# Cong host de truy cap web (mac dinh http://localhost:8080)
WEB_PORT=8080

# Cong host de ket noi SQL Server tu may ngoai (SSMS/Azure Data Studio)
DB_PORT=1433

# (Tuy chon) Image web de `docker compose pull` thay vi build tai cho.
# Tren server CD, GitHub Actions se tu dat bien nay; de trong khi chay local.
# Vi du: WEB_IMAGE=ghcr.io/quoc05dev/qldatphongkhachsan_uneti_2_dhti17a2hn-web:main
WEB_IMAGE=

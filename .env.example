# Sao chep file nay thanh .env roi dat mat khau manh truoc khi deploy.
# (file .env da duoc .gitignore, khong bi commit len git)
# BAT BUOC: docker compose se tu choi chay neu bien nay de trong.
MSSQL_SA_PASSWORD=

# Nap du lieu mau (mac dinh false). Chi bat khi can demo.
# Khi bat tren Production, BAT BUOC dat SEED_ADMIN_PASSWORD manh (>= 8 ky tu)
# de khong tao tai khoan admin/123456.
SEED_SAMPLE_DATA=false
SEED_ADMIN_PASSWORD=

# Danh sach Host header duoc phep (phan tach bang dau ;).
ALLOWED_HOSTS=uhotel.click;www.uhotel.click;dev.uhotel.click;localhost;127.0.0.1

# ---------------------------------------------------------------------------
# Cong host (PORT). KHI CHAY CUNG MOT VPS VOI DU AN CU (Managerment-rent-room)
# phai chon cong con trong, neu khong se trung va container khong len duoc.
# Da kiem tra tren server (ss -tlnp): 80/443/8080/8081/3100/3316/3306/1434/14333 dang bi chiem.
# ---------------------------------------------------------------------------
# Cong host de truy cap web (mac dinh 8080; VPS nay dung 8090)
WEB_PORT=8090

# Cong host de ket noi SQL Server (chi mo tren 127.0.0.1, khong ro ra Internet).
# Muon ket noi SSMS/Azure Data Studio tu may ngoai thi dung SSH tunnel:
#   ssh -L 14330:127.0.0.1:14330 root@<IP-server>   roi ket noi localhost:14330
# (mac dinh 1433; VPS nay dung 14330)
DB_PORT=14330

# ---------------------------------------------------------------------------
# (Tuy chon) Upstream cho nginx reverse proxy - chi dung khi da chuyen production
# sang Kubernetes. Neu de trong, setup-nginx.sh dan ve 127.0.0.1:WEB_PORT (Compose).
# Sau khi chuyen K8s (NodePort Service qldpkh-web = 30444):
PROXY_TARGET=127.0.0.1:30444
# ---------------------------------------------------------------------------

# (Tuy chon) Image web de `docker compose pull` thay vi build tai cho.
# Tren server CD, GitHub Actions se tu dat bien nay; de trong khi chay local.
# Vi du: WEB_IMAGE=ghcr.io/quoc05dev/qlydatphongkhachsan_uneti_2_dhti17a2hn-web:main
WEB_IMAGE=

# ---------------------------------------------------------------------------
# (Tuy chon) Dang nhap / dang ky bang Google OAuth.
# Tao OAuth 2.0 Client ID tai https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phai tro dung ve app, vi du:
#   https://your-domain/dang-nhap/google-callback
#   https://localhost:7141/dang-nhap/google-callback  (chay local bang profile https)
# De trong neu khong dung; nut Google se tu an tren giao dien.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

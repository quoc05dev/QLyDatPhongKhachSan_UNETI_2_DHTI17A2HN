@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Doanh thu & báo cáo (mục 9.4) theo bản thiết kế
    DesignProjectWithSuggestions: highlight, biểu đồ theo tháng, doanh thu theo
    hạng phòng, top phòng và chi tiết đơn trong kỳ. Dữ liệu giữ nguyên ThongKeController.
*@
@using System.Globalization

@{
    ViewData["Title"] = "Doanh thu & báo cáo";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "reports";

    var gD = CultureInfo.GetCultureInfo("vi-VN");
    var danhSachNam = (List<int>)ViewBag.DanhSachNam;
    var namChon = (int)ViewBag.NamChon;
    var thangChon = (int)ViewBag.ThangChon;
    var coDuLieu = (bool)ViewBag.CoDuLieuKyChon;

    var doanhThuKy = (decimal)ViewBag.DoanhThuKyChon;
    var soLuotDat = (int)ViewBag.SoLuotDatKyChon;
    var soLuotHuy = (int)ViewBag.SoLuotHuyKyChon;
    var tbMoiLuot = soLuotDat == 0 ? 0m : Math.Round(doanhThuKy / soLuotDat, 0);

    var doanhThuThang = (List<QLyDatPhongKhachSan.ViewModels.DoanhThuThangItem>)ViewBag.DoanhThuTheoThang;
    var giaTriThang = new decimal[13];
    foreach (var item in doanhThuThang)
    {
        if (item.Thang >= 1 && item.Thang <= 12) giaTriThang[item.Thang] = item.DoanhThu;
    }
    var maxThang = (decimal)Math.Max(giaTriThang.Max(), 1m);

    var doanhThuLoai = (List<QLyDatPhongKhachSan.ViewModels.LoaiPhongThongKeItem>)ViewBag.DoanhThuTheoLoai;
    var maxLoai = doanhThuLoai.Any() ? doanhThuLoai.Max(x => x.DoanhThu) : 0m;

    var topPhong = (List<QLyDatPhongKhachSan.ViewModels.PhongThongKeItem>)ViewBag.PhongDatNhieuNhat;
    var chiTietKy = (List<QLyDatPhongKhachSan.Models.DatPhong>)ViewBag.ChiTietKy;
}

@functions {
    string Tien(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("vi-VN"));
    string TienGon(decimal v)
    {
        if (v >= 1000000000) return (v / 1000000000m).ToString("0.#") + " tỷ";
        if (v >= 1000000) return (v / 1000000m).ToString("0.#") + "tr";
        if (v >= 1000) return (v / 1000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }
    string TenThang(int t) => t == 10 ? "Tháng 10" : $"Tháng {t}";
}

<style>
    .title-actions { display: flex; align-items: flex-end; gap: 10px; flex-wrap: nowrap; }
    .title-actions .filter-row { flex-wrap: nowrap; }
    .title-actions .field { min-width: 110px; }
    .title-actions .admin-primary,
    .title-actions .admin-secondary { white-space: nowrap; }
    @@media (max-width: 1360px) { .admin-title-row { flex-direction: column; align-items: stretch; } }
    @@media (max-width: 1200px) { .title-actions, .title-actions .filter-row { flex-wrap: wrap; } }
    .export-dropdown { position: relative; }
    .export-menu {
        position: absolute; right: 0; top: calc(100% + 8px); min-width: 200px;
        background: #fff; border: 1px solid #e4e7e9; border-radius: 10px;
        box-shadow: 0 14px 34px rgba(23, 36, 51, .14); padding: 6px; display: none; z-index: 40;
    }
    .export-menu.open { display: block; }
    .export-menu a {
        display: flex; align-items: center; gap: 10px; padding: 10px 12px;
        border-radius: 8px; color: #26333f; font-size: 13px; font-weight: 600; text-decoration: none;
    }
    .export-menu a:hover { background: #f2f5f7; }
    .export-menu a small { display: block; color: #6b7480; font-size: 10px; font-weight: 500; margin-top: 2px; }
</style>

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Tài chính</span>
        <h1>Doanh thu &amp; báo cáo</h1>
        <p>Thống kê doanh thu theo kỳ, hạng phòng và hiệu suất kinh doanh.</p>
    </div>
    <div class="title-actions">
        <form class="filter-row" method="get" asp-controller="ThongKe" asp-action="DoanhThu">
            <label class="field">
                <span style="display:block;margin-bottom:8px;color:var(--muted);font-size: 10px;font-weight:700;text-transform:uppercase;">Năm</span>
                <select name="nam">
                    @foreach (var y in danhSachNam)
                    {
                        <option value="@y" selected="@(y == namChon)">@y</option>
                    }
                </select>
            </label>
            <label class="field">
                <span style="display:block;margin-bottom:8px;color:var(--muted);font-size: 10px;font-weight:700;text-transform:uppercase;">Tháng</span>
                <select name="thang">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == thangChon)">@TenThang(m)</option>
                    }
                </select>
            </label>
            <button class="admin-primary" type="submit">
                <svg class="admin-icon" viewBox="0 0 24 24"><path d="M6 3v7M18 3v7M3 10h18" /><path d="M4 10v11h16V10" /></svg>
                Xem báo cáo
            </button>
            <a class="admin-secondary" asp-controller="ThongKe" asp-action="Dashboard">← Dashboard</a>
        </form>

        <div class="export-dropdown">
            <button type="button" class="admin-primary" id="btnXuatBaoCao" aria-haspopup="true" aria-expanded="false">
                <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M4 21h16" /></svg>
                Xuất báo cáo
            </button>
            <div class="export-menu" id="menuXuatBaoCao" role="menu">
                <a role="menuitem" href="#" id="menuPreview">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                    <span>Xem trước báo cáo<small>Xem đúng bản PDF sẽ xuất</small></span>
                </a>
                <a role="menuitem" asp-controller="ThongKe" asp-action="ExportPdf" asp-route-nam="@namChon" asp-route-thang="@thangChon">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>
                    <span>Xuất PDF<small>Tệp .pdf</small></span>
                </a>
                <a role="menuitem" asp-controller="ThongKe" asp-action="ExportExcel" asp-route-nam="@namChon" asp-route-thang="@thangChon">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="m9 13 6 6m0-6-6 6" /></svg>
                    <span>Xuất Excel<small>Tệp .xlsx</small></span>
                </a>
            </div>
        </div>
    </div>
</div>

@if (!coDuLieu)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid var(--gold-500);background:#fff;color:#5d666f;font-size: 13px;">
        Kỳ <strong>@TenThang(thangChon)/@namChon</strong> không có giao dịch nào còn hiệu lực,
        các con số bên dưới bằng 0. Chọn kỳ khác nếu cần xem dữ liệu.
    </p>
}

<div class="report-highlight">
    <div>
        <span>Doanh thu @TenThang(thangChon)</span>
        <strong>@Tien(doanhThuKy)₫</strong>
        <small>@TenThang(thangChon)/@namChon</small>
    </div>
    <div>
        <span>Số lượt đặt (có hiệu lực)</span>
        <strong>@soLuotDat</strong>
        <small>Bình quân @Tien(tbMoiLuot)₫ / lượt</small>
    </div>
    <div>
        <span>Số lượt hủy trong kỳ</span>
        <strong>@soLuotHuy</strong>
        <small>Đã loại khỏi doanh thu</small>
    </div>
</div>

@{
    var tomTatAI = (List<string>?)ViewBag.TomTatAI;
}
@if (tomTatAI != null && tomTatAI.Any())
{
    <article class="dashboard-card" style="padding:18px 22px;margin-bottom:18px;border-left:4px solid #b28c49;">
        <div class="card-heading" style="margin-bottom:10px;">
            <div>
                <span>Phân tích nhanh</span>
                <h2 style="font-size:15px;">AI tóm tắt kỳ báo cáo</h2>
            </div>
        </div>
        <ul style="margin:0;padding-left:18px;color:#3f4a55;font-size:13px;line-height:1.7;">
            @foreach (var cau in tomTatAI)
            {
                <li>@cau</li>
            }
        </ul>
    </article>
}

<div class="dashboard-grid report-grid">
    <article class="dashboard-card revenue-card">
        <div class="card-heading">
            <div><span>Xu hướng</span><h2>Doanh thu theo tháng · năm @namChon</h2></div>
            <span class="admin-select">Năm @namChon
                <svg class="admin-icon" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </span>
        </div>
        @if (doanhThuThang.Any(x => x.DoanhThu > 0))
        {
            <div class="bar-chart" aria-label="Biểu đồ doanh thu 12 tháng">
                @for (var m = 1; m <= 12; m++)
                {
                    var value = giaTriThang[m];
                    var height = value <= 0 ? 3 : (int)Math.Max(4, Math.Round(value / maxThang * 90));
                    <div class="bar-column">
                        <i style="height:@(height)%;">
                            @if (value > 0)
                            {
                                <span>@TienGon(value)</span>
                            }
                        </i>
                        <small>@(m == 10 ? "T10" : $"T{m}")</small>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-table" style="min-height:220px;">
                <strong>Chưa có doanh thu</strong>
                <span>Năm @namChon chưa phát sinh giao dịch có hiệu lực.</span>
            </div>
        }
    </article>

    <article class="dashboard-card">
        <div class="card-heading" style="padding:23px 23px 0;">
            <div><span>Cơ cấu doanh thu</span><h2>Theo hạng phòng</h2></div>
        </div>
        @if (doanhThuLoai.Any())
        {
            <div class="report-bars">
                @foreach (var item in doanhThuLoai)
                {
                    var width = maxLoai == 0 ? 0 : (int)Math.Max(3, Math.Round(item.DoanhThu / maxLoai * 100));
                    <div>
                        <p><span>@item.TenLoai</span><strong>@Tien(item.DoanhThu)₫</strong></p>
                        <i><b style="width:@(width)%;"></b></i>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-table" style="min-height:240px;">
                <strong>Không có doanh thu</strong>
                <span>Kỳ @TenThang(thangChon)/@namChon chưa có dữ liệu.</span>
            </div>
        }
    </article>
</div>

<article class="dashboard-card data-card">
    <div class="card-heading" style="padding:22px 24px;border-bottom:1px solid #e4e7e9;">
        <div><span>Top phòng</span><h2>Phòng được đặt nhiều nhất trong kỳ</h2></div>
    </div>
    @if (topPhong.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:60px;">Hạng</th>
                        <th>Phòng</th>
                        <th>Loại phòng</th>
                        <th>Số lượt đặt</th>
                        <th>Doanh thu</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var item in topPhong)
                    {
                        var medal = rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : rank.ToString();
                        <tr>
                            <td><strong>@medal</strong></td>
                            <td>@item.SoPhong</td>
                            <td>@item.TenLoai</td>
                            <td><strong>@item.SoLuotDat lượt</strong></td>
                            <td>@Tien(item.DoanhThu)₫</td>
                            <td><span class="row-action">•••</span></td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-table">
            <strong>Không có lượt đặt nào</strong>
            <span>Kỳ @TenThang(thangChon)/@namChon chưa phát sinh đặt phòng.</span>
        </div>
    }
</article>

<article class="dashboard-card" style="margin-top:18px;">
    <div class="card-heading" style="padding:22px 24px;border-bottom:1px solid #e4e7e9;">
        <div><span>Chi tiết kỳ</span><h2>Chi tiết các đơn đặt phòng trong kỳ</h2></div>
    </div>
    @if (chiTietKy.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Nhận phòng</th>
                        <th>Trả phòng</th>
                        <th>Số người</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dp in chiTietKy)
                    {
                        <tr>
                            <td><strong>#@dp.MaDatPhong</strong></td>
                            <td>@(dp.KhachHang?.HoTen ?? "—")</td>
                            <td>@(dp.KhachHang?.SoDienThoai ?? "—")</td>
                            <td>@dp.NgayNhan.ToString("dd/MM/yyyy")</td>
                            <td>@dp.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                            <td>@dp.SoNguoi</td>
                            <td><partial name="_TrangThaiBadge" model="@dp.TrangThai" /></td>
                            <td><strong>@Tien(dp.TongTien)₫</strong></td>
                            <td>
                                <a class="row-action" asp-controller="QuanLyDatPhong" asp-action="ChiTiet" asp-route-id="@dp.MaDatPhong" title="Xem chi tiết đơn @dp.MaDatPhong">•••</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-table">
            <strong>Không có đơn đặt phòng nào</strong>
            <span>Kỳ @TenThang(thangChon)/@namChon chưa có dữ liệu.</span>
        </div>
    }
</article>

<p style="margin-top:16px;color:#767e88;font-size: 10px;">
    Báo cáo dùng LINQ <code>GroupBy()</code>, <code>Sum()</code>, <code>Count()</code>,
    <code>OrderByDescending()</code>, <code>Any()</code> theo mục 9.4 của De_15.docx.
    Doanh thu chỉ tính các chi tiết chưa bị hủy.
</p>

@* Xem trước & chỉnh sửa báo cáo trước khi xuất PDF/Excel *@
<div class="modal-backdrop" id="preview-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="pv-title" style="grid-template-columns:1fr;width:min(1040px,96vw);">
        <button aria-label="Đóng" class="modal-close" id="pv-close" type="button" style="width:34px;height:34px;border:1px solid #e1e4e7;border-radius:50%;cursor:pointer;background:#fff;font-size:16px;line-height:1;z-index:2;">×</button>
        <div class="modal-content" style="padding:26px 28px 22px;">
            <div class="eyebrow" style="font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-500);">Xem trước bản chính thức</div>
            <h2 id="pv-title" style="font-size:24px;margin:8px 0 4px;">Bản PDF trước khi xuất</h2>
            <p style="color:var(--muted);font-size:13px;margin:0;">
                Kỳ <strong>Tháng @thangChon/@namChon</strong> — bên dưới là <strong>đúng file PDF sẽ tải về</strong>
                (mẫu văn bản chuẩn, <strong>@chiTietKy.Count</strong> đơn trong kỳ). Sửa dòng V/v/ghi chú rồi kiểm tra lại, ưng ý bấm "Xuất".
            </p>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px;">
                <label class="modal-field" style="margin:0;">
                    <span>Tiêu đề dòng V/v (sửa được)</span>
                    <input id="pv-tieude" type="text" maxlength="120" value="Tình hình doanh thu tháng @thangChon/@namChon" />
                </label>
                <label class="modal-field" style="margin:0;">
                    <span>Ghi chú — dưới dòng V/v (tùy chọn)</span>
                    <textarea id="pv-ghichu" rows="2" maxlength="500" style="width:100%;padding:10px 14px;border:1px solid var(--line);border-radius:2px;background:var(--white);outline:none;font-family:inherit;font-size:13px;resize:vertical;"></textarea>
                </label>
            </div>

            <div style="position:relative;margin-top:14px;">
                <iframe id="pv-frame" title="Xem trước báo cáo PDF" style="width:100%;height:min(52vh,520px);border:1px solid var(--line);background:#fff;display:block;"></iframe>
                <div id="pv-loading" style="position:absolute;inset:0;align-items:center;justify-content:center;background:rgba(255,255,255,.8);font-size:13px;color:var(--muted);display:none;">Đang tải bản xem trước…</div>
            </div>

            <div style="display:flex;gap:10px;margin-top:16px;">
                <a href="#" id="pv-pdf" class="admin-primary" style="flex:1;justify-content:center;text-decoration:none;">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M4 21h16" /></svg>
                    Xuất PDF (như đang xem)
                </a>
                <a href="#" id="pv-excel" class="admin-secondary" style="flex:1;justify-content:center;text-decoration:none;">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M4 21h16" /></svg>
                    Xuất Excel
                </a>
            </div>
            <small class="modal-note">Xem trước = đúng file PDF sẽ tải về. Excel không hiển thị trong trình duyệt — bấm "Xuất Excel" rồi mở bằng Excel.</small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('btnXuatBaoCao');
            var menu = document.getElementById('menuXuatBaoCao');
            if (!btn || !menu) { return; }

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = menu.classList.toggle('open');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            });

            document.addEventListener('click', function () {
                if (menu.classList.contains('open')) {
                    menu.classList.remove('open');
                    btn.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && menu.classList.contains('open')) {
                    menu.classList.remove('open');
                    btn.setAttribute('aria-expanded', 'false');
                }
            });
        })();

        // Xem trước đúng bản PDF sẽ xuất, rồi mới bấm Xuất
        (function () {
            var modal = document.getElementById('preview-modal');
            var openBtn = document.getElementById('menuPreview');
            if (!modal || !openBtn) { return; }

            var closeBtn = document.getElementById('pv-close');
            var inputTd = document.getElementById('pv-tieude');
            var inputGc = document.getElementById('pv-ghichu');
            var linkPdf = document.getElementById('pv-pdf');
            var linkExcel = document.getElementById('pv-excel');
            var frame = document.getElementById('pv-frame');
            var loading = document.getElementById('pv-loading');
            var debounce;
            var lanTai = 0;
            var urlPdf = '@Url.Action("ExportPdf", "ThongKe")';
            var urlExcel = '@Url.Action("ExportExcel", "ThongKe")';

            function truyVan() {
                return '?nam=@namChon&thang=@thangChon'
                    + '&tieuDe=' + encodeURIComponent(inputTd.value)
                    + '&ghiChu=' + encodeURIComponent(inputGc.value);
            }
            function capNhatLink() {
                linkPdf.href = urlPdf + truyVan();
                linkExcel.href = urlExcel + truyVan();
            }
            // Tải đúng file PDF sẽ xuất rồi nhúng vào modal để xem thử.
            function taiPreview() {
                capNhatLink();
                var so = ++lanTai;
                loading.style.display = 'flex';
                fetch(urlPdf + truyVan(), { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) { throw new Error('tai loi'); } return r.blob(); })
                    .then(function (b) {
                        if (so !== lanTai) { return; }
                        if (window.pvBlobUrl) { URL.revokeObjectURL(window.pvBlobUrl); }
                        window.pvBlobUrl = URL.createObjectURL(b);
                        frame.src = window.pvBlobUrl;
                        // Trình duyệt có thể không bắn event load với PDF plugin — ẩn lớp chờ sau 2,5s.
                        setTimeout(function () {
                            if (so === lanTai) { loading.style.display = 'none'; }
                        }, 2500);
                    })
                    .catch(function () {
                        if (so === lanTai) {
                            loading.style.display = 'none';
                            frame.removeAttribute('src');
                        }
                    });
            }
            function keoTiepTai() { clearTimeout(debounce); debounce = setTimeout(taiPreview, 500); }

            frame.addEventListener('load', function () { loading.style.display = 'none'; });

            function mo() { modal.hidden = false; taiPreview(); }
            function dong() { modal.hidden = true; }

            openBtn.addEventListener('click', function (e) { e.preventDefault(); mo(); });
            closeBtn.addEventListener('click', dong);
            modal.addEventListener('click', function (e) { if (e.target === modal) dong(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) dong(); });
            inputTd.addEventListener('input', keoTiepTai);
            inputGc.addEventListener('input', keoTiepTai);
        })();
    </script>
}



@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Dashboard tổng quan (mục 9.3) theo bản thiết kế
    DesignProjectWithSuggestions: thẻ chỉ số, biểu đồ doanh thu theo tháng,
    công suất phòng, đặt phòng mới nhất. Dữ liệu giữ nguyên từ ThongKeController.
*@
@using System.Globalization
@model QLyDatPhongKhachSan.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard tổng quan - Module 5";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "overview";
    var gD = CultureInfo.GetCultureInfo("vi-VN");
    var tyLeSuDung = (double)ViewBag.TyLeSuDungPhong;

    var doanhThuThang = new decimal[13];
    foreach (var item in Model.DoanhThuTheoThang)
    {
        if (item.Thang >= 1 && item.Thang <= 12) doanhThuThang[item.Thang] = item.DoanhThu;
    }
    var maxDoanhThuThang = (decimal)Math.Max(doanhThuThang.Max(), 1m);

    var today = DateTime.Today;
    var ngayChu = today.DayOfWeek switch
    {
        DayOfWeek.Monday => "Thứ Hai",
        DayOfWeek.Tuesday => "Thứ Ba",
        DayOfWeek.Wednesday => "Thứ Tư",
        DayOfWeek.Thursday => "Thứ Năm",
        DayOfWeek.Friday => "Thứ Sáu",
        DayOfWeek.Saturday => "Thứ Bảy",
        _ => "Chủ nhật"
    };
}

@functions {
    string FuncTien(decimal v)
    {
        if (v >= 1000000000) return (v / 1000000000m).ToString("0.#") + " tỷ";
        if (v >= 1000000) return (v / 1000000m).ToString("0.#") + "tr";
        if (v >= 1000) return (v / 1000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }
    string SoGanTien(decimal v)
    {
        return v.ToString("N0", new System.Globalization.CultureInfo("vi-VN"));
    }
    string TenThang(int t) => t == 10 ? "Tháng 10" : $"Tháng {t}";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Trung tâm vận hành</span>
        <h1>Dashboard tổng quan</h1>
        <p>Tổng quan hoạt động khách sạn, @ngayChu, ngày @today.ToString("dd/MM/yyyy").</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a class="admin-text-button" asp-controller="QuanLyDatPhong" asp-action="Index">Xem tiếp nhận →
            <svg class="admin-icon" viewBox="0 0 24 24" style="width:13px;transform:rotate(0);"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <a class="admin-primary" asp-controller="ThongKe" asp-action="DoanhThu">
            <svg class="admin-icon" viewBox="0 0 24 24"><path d="M3 3v18h18" /><path d="M18 17V9m-5 8V5m-5 12v-4" /></svg>
            Doanh thu &amp; báo cáo
        </a>
    </div>
</div>

<div class="stat-grid">
    <article class="stat-card stat-card--navy">
        <div class="stat-top"><span>Tổng số phòng</span><strong>@Model.SoPhongTrong sẵn sàng</strong></div>
        <b>@Model.TongSoPhong</b>
        <small>@Model.TongLoaiPhong loại phòng · @Model.SoPhongBaoTri phòng bảo trì</small>
    </article>
    <article class="stat-card stat-card--gold">
        <div class="stat-top"><span>Khách đang lưu trú</span><strong>@Model.SoPhongBaoTri bảo trì</strong></div>
        <b>@Model.SoPhongDangSuDung</b>
        <small>Phòng đang có khách sử dụng</small>
    </article>
    <article class="stat-card stat-card--blue">
        <div class="stat-top"><span>Đơn đang xử lý</span><strong>@Model.DonChoXuLy chờ duyệt</strong></div>
        <b>@(Model.DonChoXuLy + Model.DonDangXuLy)</b>
        <small>@Model.DonHoanThanh đơn hoàn thành · @Model.DonDaHuy đơn hủy</small>
    </article>
    <article class="stat-card stat-card--green">
        <div class="stat-top"><span>Doanh thu tháng nay</span><strong>@FuncTien(Model.DoanhThuThangNay)</strong></div>
        <b>@SoGanTien(Model.DoanhThuThangNay)₫</b>
        <small>Tổng tích lũy: @SoGanTien(Model.TongDoanhThu)₫</small>
    </article>
</div>

<div class="dashboard-grid">
    <article class="dashboard-card revenue-card">
        <div class="card-heading">
            <div><span>Hiệu suất kinh doanh</span><h2>Doanh thu theo tháng · năm @today.Year</h2></div>
            <span class="admin-select">Năm @today.Year
                <svg class="admin-icon" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </span>
        </div>
        @if (Model.DoanhThuTheoThang.Any(x => x.DoanhThu > 0))
        {
            <div class="bar-chart" aria-label="Biểu đồ doanh thu 12 tháng">
                @for (var m = 1; m <= 12; m++)
                {
                    var value = doanhThuThang[m];
                    var height = value <= 0 ? 3 : (int)Math.Max(4, Math.Round(value / maxDoanhThuThang * 90));
                    <div class="bar-column">
                        <i style="height:@(height)%;">
                            @if (value > 0)
                            {
                                <span>@FuncTien(value)</span>
                            }
                        </i>
                        <small>T@(m == 10 ? "10" : m.ToString())</small>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-table" style="min-height:220px;">
                <strong>Chưa có doanh thu</strong>
                <span>Năm @today.Year chưa phát sinh giao dịch có hiệu lực.</span>
            </div>
        }
    </article>

    <article class="dashboard-card occupancy-card">
        <div class="card-heading"><div><span>Công suất phòng</span><h2>Theo hạng phòng</h2></div></div>
        <div class="occupancy-ring" style="background: conic-gradient(#c9a35d 0 @tyLeSuDung%, #edf0f2 @tyLeSuDung% 100%);">
            <div><strong>@tyLeSuDung.ToString("0.#")%</strong><span>Trung bình</span></div>
        </div>
        <div class="occupancy-list">
            @if (Model.TyLeSuDungTheoLoai.Any())
            {
                foreach (var loai in Model.TyLeSuDungTheoLoai)
                {
                    <div><span><i></i>@loai.TenLoai</span><strong>@loai.TyLeSuDung.ToString("0.#")%</strong></div>
                }
            }
            else
            {
                <div><span><i></i>Chưa có dữ liệu</span><strong>—</strong></div>
            }
        </div>
    </article>
</div>

<article class="dashboard-card recent-card">
    <div class="card-heading">
        <div><span>Cập nhật gần đây</span><h2>Đặt phòng mới nhất</h2></div>
        <a class="admin-text-button" asp-controller="QuanLyDatPhong" asp-action="Index">Xem tất cả →</a>
    </div>
    @if (Model.DatPhongGanNhat.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đặt phòng</th>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dp in Model.DatPhongGanNhat)
                    {
                        var chiTiet = dp.ChiTietDatPhongs.FirstOrDefault();
                        var tenPhong = chiTiet?.Phong?.SoPhong ?? "—";
                        var tenLoai = chiTiet?.Phong?.LoaiPhong?.TenLoai;
                        <tr>
                            <td>
                                <strong>#@dp.MaDatPhong</strong>
                                <small>@dp.NgayNhan.ToString("dd/MM/yyyy") → @dp.NgayTraDuKien.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>@(dp.KhachHang?.HoTen ?? "—")</td>
                            <td>@tenPhong @(string.IsNullOrEmpty(tenLoai) ? "" : $"· {tenLoai}")</td>
                            <td><strong>@SoGanTien(dp.TongTien)₫</strong></td>
                            <td>
                                <partial name="_TrangThaiBadge" model="@dp.TrangThai" />
                            </td>
                            <td>
                                <a class="row-action" asp-controller="QuanLyDatPhong" asp-action="ChiTiet" asp-route-id="@dp.MaDatPhong" title="Xem chi tiết đơn @dp.MaDatPhong">•••</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-table">
            <strong>Không có đơn đặt phòng nào</strong>
            <span>Khi khách đặt phòng, đơn mới sẽ xuất hiện ở đây.</span>
        </div>
    }
</article>

<p class="admin-note" style="margin-top:16px;color:#929aa2;font-size:9px;">
    Số liệu tính bằng LINQ <code>GroupBy()</code>, <code>Sum()</code>, <code>Count()</code>, <code>Any()</code>
    theo yêu cầu mục 9.3 của De_15.docx. Doanh thu chỉ tính các chi tiết chưa bị hủy.
</p>
@model QLyDatPhongKhachSan.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - Bảng điều khiển tổng quan";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1 fw-bold">
                <i class="bi bi-speedometer2 text-primary me-2"></i>
                Dashboard
            </h1>
            <p class="text-muted mb-0">Tổng quan tình trạng khách sạn - Mục 9.3</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-lg-0">
            <a asp-controller="ThongKe" asp-action="DoanhThu" class="btn btn-outline-primary">
                <i class="bi bi-bar-chart-line me-1"></i>Báo cáo doanh thu
            </a>
            <a asp-controller="ThongKe" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </a>
        </div>
    </div>

    <!-- 1. Thẻ thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-grid-3x3-gap-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Tổng loại phòng</p>
                        <h4 class="mb-0 fw-bold">@Model.TongLoaiPhong</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                        <i class="bi bi-door-open-fill text-info fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Tổng số phòng</p>
                        <h4 class="mb-0 fw-bold">@Model.TongSoPhong</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <i class="bi bi-key-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Phòng đang sử dụng</p>
                        <h4 class="mb-0 fw-bold">@Model.SoPhongDangSuDung</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                        <i class="bi bi-door-closed-fill text-warning fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Phòng trống</p>
                        <h4 class="mb-0 fw-bold">@Model.SoPhongTrong</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-tools text-secondary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Phòng bảo trì</p>
                        <h4 class="mb-0 fw-bold">@Model.SoPhongBaoTri</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-people-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Tổng khách hàng</p>
                        <h4 class="mb-0 fw-bold">@Model.TongKhachHang</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                        <i class="bi bi-receipt-cutoff text-info fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Tổng đơn đặt phòng</p>
                        <h4 class="mb-0 fw-bold">@Model.TongDonDatPhong</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                        <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Đơn đã hủy</p>
                        <h4 class="mb-0 fw-bold">@Model.DonDaHuy</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Trạng thái giao dịch -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-warning border-3">
                <div class="card-body">
                    <p class="text-muted mb-0 small">Chờ xử lý</p>
                    <h4 class="mb-0 fw-bold">@Model.DonChoXuLy</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-info border-3">
                <div class="card-body">
                    <p class="text-muted mb-0 small">Đang xử lý</p>
                    <h4 class="mb-0 fw-bold">@Model.DonDangXuLy</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-3">
                <div class="card-body">
                    <p class="text-muted mb-0 small">Hoàn thành</p>
                    <h4 class="mb-0 fw-bold">@Model.DonHoanThanh</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-primary border-3">
                <div class="card-body">
                    <p class="text-muted mb-0 small">Tỷ lệ sử dụng phòng</p>
                    <h4 class="mb-0 fw-bold">@($"{ViewBag.TyLeSuDungPhong:F1}")%</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Doanh thu -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="mb-2 text-uppercase text-muted small fw-semibold">Tổng doanh thu</h6>
                    <h3 class="mb-0 fw-bold text-primary">@Model.TongDoanhThu.ToString("N0") <small>VNĐ</small></h3>
                    <small class="text-muted">Tất cả giao dịch không bị hủy</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="mb-2 text-uppercase text-muted small fw-semibold">Doanh thu tháng này</h6>
                    <h3 class="mb-0 fw-bold text-success">@Model.DoanhThuThangNay.ToString("N0") <small>VNĐ</small></h3>
                    <small class="text-muted">@DateTime.Now.ToString("MM/yyyy")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Phòng được đặt nhiều nhất -->
    <div class="row g-3">
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-trophy-fill text-warning me-1"></i>
                        Top phòng được đặt nhiều nhất
                    </h6>
                    <span class="badge bg-light text-dark">Tối đa 10</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.PhongDatNhieuNhat.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Số phòng</th>
                                        <th>Loại phòng</th>
                                        <th class="text-center">Số lượt đặt</th>
                                        <th class="text-end pe-4">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PhongDatNhieuNhat)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold">@item.SoPhong</td>
                                            <td class="text-muted">@item.TenLoai</td>
                                            <td class="text-center fw-semibold">@item.SoLuotDat</td>
                                            <td class="text-end pe-4">@item.DoanhThu.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block"></i>
                            Chưa có dữ liệu đặt phòng
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 5. Doanh thu theo tháng -->
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-graph-up text-success me-1"></i>
                        Doanh thu theo tháng (năm @DateTime.Now.Year)
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.DoanhThuTheoThang.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Tháng</th>
                                        <th class="text-center">Số lượt đặt</th>
                                        <th class="text-end pe-4">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.DoanhThuTheoThang)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold">Tháng @item.Thang</td>
                                            <td class="text-center">@item.SoLuotDat</td>
                                            <td class="text-end pe-4 text-success fw-semibold">@item.DoanhThu.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block"></i>
                            Chưa có doanh thu trong năm này
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 6. Tỷ lệ phòng theo loại -->
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-pie-chart-fill text-info me-1"></i>
                        Tỷ lệ phòng theo loại
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.TyLePhongTheoLoai.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Loại phòng</th>
                                        <th class="text-center">Số lượng phòng</th>
                                        <th>Tỷ lệ</th>
                                        <th class="pe-4">Biểu đồ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.TyLePhongTheoLoai)
                                    {
                                        var width = Math.Max(item.TyLe, 0);
                                        <tr>
                                            <td class="ps-4 fw-semibold">@item.TenLoai</td>
                                            <td class="text-center">@item.SoLuongPhong</td>
                                            <td>@item.TyLe.ToString("F1")%</td>
                                            <td class="pe-4">
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @width%" aria-valuenow="@item.TyLe" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block"></i>
                            Chưa có dữ liệu loại phòng
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="text-muted small mt-3">
        <i class="bi bi-info-circle me-1"></i>
        Dữ liệu thống kê được tính theo Entity Framework Core và LINQ (mục 9.3 - 9.4 của De_15.docx).
    </div>
</div>
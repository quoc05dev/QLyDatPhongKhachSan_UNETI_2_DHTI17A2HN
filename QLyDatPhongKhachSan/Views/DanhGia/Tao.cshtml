@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung: Form đánh giá đơn đã hoàn thành (chấm sao + cảm nhận).
*@
@model QLyDatPhongKhachSan.ViewModels.DanhGiaCreateViewModel
@{
    ViewData["Title"] = "Đánh giá đơn đặt phòng";
    Layout = "_AdminLayout";
    var maDon = (int)ViewBag.MaDatPhong;
}

<style>
    .dg-wrap { max-width: 560px; }
    .dg-stars { display: flex; gap: 4px; margin: 10px 0 16px; }
    .dg-stars input { display: none; }
    .dg-stars label { font-size: 30px; color: #d8dce0; cursor: pointer; transition: color .15s; }
    .dg-stars input:checked ~ label,
    .dg-stars label:hover,
    .dg-stars label:hover ~ label { color: #b28c49; }
    .dg-textarea { width: 100%; min-height: 120px; border: 1px solid #e4e7e9; border-radius: 6px; padding: 12px; font-size: 13px; font-family: inherit; resize: vertical; }
    .dg-textarea:focus { outline: none; border-color: #b28c49; }
    .dg-hint { font-size: 11px; color: #8a93a0; margin-top: 6px; }
</style>

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Đánh giá dịch vụ</span>
        <h1>Đánh giá đơn #@maDon.ToString("D4")</h1>
        <p>Chia sẻ cảm nhận của bạn — khách sạn phản hồi trong 24 giờ.</p>
    </div>
    <a class="admin-secondary" asp-controller="DatPhong" asp-action="LichSu" style="text-decoration:none;">← Lịch sử đặt phòng</a>
</div>

<article class="dashboard-card dg-wrap" style="padding:22px;">
    <form asp-action="Tao" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaDatPhong" />

        <div asp-validation-summary="ModelOnly" style="color:#c0392b;font-size:13px;margin-bottom:10px;"></div>

        <label style="font-size:13px;font-weight:600;">Số sao</label>
        <div class="dg-stars">
            @for (int s = 5; s >= 1; s--)
            {
                <input type="radio" name="SoSao" value="@s" id="star@s" @(Model.SoSao == s ? "checked" : null) />
                <label for="star@s" title="@s sao">★</label>
            }
        </div>
        <span asp-validation-for="SoSao" style="color:#c0392b;font-size:12px;"></span>

        <label style="font-size:13px;font-weight:600;" asp-for="BinhLuan">Cảm nhận của bạn</label>
        <textarea class="dg-textarea" asp-for="BinhLuan" placeholder="VD: Phòng sạch sẽ, nhân viên nhiệt tình, nhưng nước nóng hơi yếu..."></textarea>
        <div class="dg-hint">AI khách sạn sẽ đọc đánh giá của bạn và lễ tân phản hồi sớm nhất.</div>
        <span asp-validation-for="BinhLuan" style="color:#c0392b;font-size:12px;"></span>

        <div style="margin-top:16px;display:flex;gap:10px;">
            <button type="submit" class="admin-primary" style="border:none;cursor:pointer;">Gửi đánh giá</button>
            <a class="admin-secondary" asp-controller="DatPhong" asp-action="LichSu" style="text-decoration:none;">Để sau</a>
        </div>
    </form>
</article>

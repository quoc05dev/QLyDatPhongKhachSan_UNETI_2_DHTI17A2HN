@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Giao diện Thêm chi tiết đặt phòng & tính tiền (Module 5 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.ChiTietDatPhong

@{
    ViewData["Title"] = "Thêm chi tiết đặt phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "operations";
    var danhSachPhong = ViewBag.DanhSachPhong as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Tính tiền phòng</span>
        <h1>Thêm chi tiết đặt phòng</h1>
        <p>Chọn phòng, nhập khoảng thời gian lưu trú; thành tiền được tính tự động theo công thức Số ngày × Đơn giá.</p>
    </div>
    @if (Model.MaDatPhong > 0)
    {
        <a class="admin-secondary" asp-controller="QuanLyDatPhong" asp-action="ChiTiet" asp-route-id="@Model.MaDatPhong" style="text-decoration:none;">← Về đơn đặt phòng</a>
    }
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size: 13px;"></div>
        <input type="hidden" asp-for="MaDatPhong" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="MaPhong" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Phòng <span style="color:red;">*</span></label>
                <select asp-for="MaPhong" asp-items="danhSachPhong" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;">
                    <option value="">-- Chọn phòng --</option>
                </select>
                <span asp-validation-for="MaPhong" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="DonGia" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Đơn giá / ngày (VNĐ) <span style="color:red;">*</span></label>
                <input asp-for="DonGia" type="number" min="0" step="1000" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="DonGia" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="NgayNhan" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Ngày nhận phòng <span style="color:red;">*</span></label>
                <input asp-for="NgayNhan" type="date" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="NgayNhan" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="NgayTra" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Ngày trả phòng <span style="color:red;">*</span></label>
                <input asp-for="NgayTra" type="date" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="NgayTra" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="TrangThai" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Trạng thái chi tiết</label>
                <select asp-for="TrangThai" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;">
                    <option value="ChoNhan">Chờ nhận phòng</option>
                    <option value="DaNhan">Đã nhận phòng</option>
                    <option value="DaTra">Đã trả phòng</option>
                    <option value="DaHuy">Đã hủy</option>
                </select>
                <span asp-validation-for="TrangThai" style="color:#c0392b;font-size: 12px;"></span>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu &amp; tính tiền</button>
            @if (Model.MaDatPhong > 0)
            {
                <a class="admin-secondary" asp-controller="QuanLyDatPhong" asp-action="ChiTiet" asp-route-id="@Model.MaDatPhong" style="text-decoration:none;">Hủy bỏ</a>
            }
            else
            {
                <a class="admin-secondary" asp-controller="QuanLyDatPhong" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
            }
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

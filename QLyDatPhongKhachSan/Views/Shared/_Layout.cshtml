@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Layout chung tích hợp Bootstrap Icons, Navbar phẫn quyền & Session.
*@
@using QLyDatPhongKhachSan.Helpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Đặt Phòng Khách Sạn</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLyDatPhongKhachSan.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building me-2"></i>UNETI HOTEL
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="Phong" asp-action="Index">
                                <i class="bi bi-door-open me-1"></i>Danh sách phòng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="DichVu" asp-action="Index">
                                <i class="bi bi-concierge-bell me-1"></i>Dịch vụ
                            </a>
                        </li>
                        @* Module 3 - Sinh viên 23103100086: menu Đặt phòng của Khách hàng *@
                        @if (Context.Session.IsLoggedIn() && Context.Session.GetVaiTro() == "KhachHang")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="DatPhong" asp-action="Index">
                                    <i class="bi bi-calendar2-plus me-1"></i>Đặt phòng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="DatPhong" asp-action="LichSu">
                                    <i class="bi bi-clock-history me-1"></i>Lịch sử đặt phòng
                                </a>
                            </li>
                        }

                        @* Module 4 - Sinh viên 22103100118: menu Tiếp nhận đặt phòng *@
                        @if (Context.Session.IsLoggedIn() &&
                            (Context.Session.GetVaiTro() == "Admin" || Context.Session.GetVaiTro() == "NhanVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="QuanLyDatPhong" asp-action="Index">
                                    <i class="bi bi-calendar2-check me-1"></i>Tiếp nhận đặt phòng
                                </a>
                            </li>
                        }
                        @* Module 5 - Sinh viên 23103100069: menu Thống kê chỉ hiện cho Admin và Nhân viên *@
                        @if (Context.Session.IsLoggedIn() &&
                            (Context.Session.GetVaiTro() == "Admin" || Context.Session.GetVaiTro() == "NhanVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="ThongKe" asp-action="Dashboard">
                                    <i class="bi bi-bar-chart-line me-1"></i>Thống kê
                                </a>
                            </li>
                        }

                        @if (Context.Session.IsLoggedIn())
                        {
                            var userRole = Context.Session.GetVaiTro();
                            if (userRole == "Admin")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i>Quản trị (Admin)
                                    </a>
                                    <ul class="dropdown-menu shadow rounded-3" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item fw-semibold text-primary" asp-controller="TaiKhoan" asp-action="Index">
                                                <i class="bi bi-people-fill me-2"></i>Quản lý Tài khoản
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item fw-semibold" asp-controller="LoaiPhong" asp-action="Index">
                                                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Quản lý Loại phòng
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.IsLoggedIn())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-bold bg-white bg-opacity-10 rounded-3 px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@Context.Session.GetHoTen()
                                    <span class="badge bg-warning text-dark ms-1">@Context.Session.GetVaiTro()</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3" aria-labelledby="userDropdown">
                                    <li class="dropdown-header">Đã đăng nhập làm @Context.Session.GetTenDangNhap()</li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (Context.Session.GetVaiTro() == "KhachHang")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="KhachHang" asp-action="Profile">
                                                <i class="bi bi-person-vcard me-2"></i>Hồ sơ cá nhân
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="DatPhong" asp-action="LichSu">
                                                <i class="bi bi-calendar2-check me-2"></i>Lịch sử đặt phòng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="DangNhap" asp-action="DoiMatKhau">
                                            <i class="bi bi-key me-2"></i>Đổi mật khẩu
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger fw-semibold" asp-controller="DangNhap" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light rounded-3 fw-semibold" asp-controller="DangNhap" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning rounded-3 fw-bold text-dark" asp-controller="DangNhap" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light py-3 mt-5">
        <div class="container text-center">
            &copy; 2026 - Hệ thống Quản lý Đặt phòng Khách sạn UNETI - Bài Tập Lớn .NET Core MVC
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

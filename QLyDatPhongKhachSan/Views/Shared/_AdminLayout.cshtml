@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Layout quản trị theo bản thiết kế DesignProjectWithSuggestions
    (sidebar 6 module, header, bảng dữ liệu). Được dùng bởi các trang module 5.
*@
@using QLyDatPhongKhachSan.Helpers
@{
    var vaiTro = Context.Session.GetVaiTro();
    var isAdmin = vaiTro == "Admin";
    var isKhachHang = vaiTro == "KhachHang";

    var action = Context.Request.RouteValues["action"]?.ToString();
    var active = (string?)ViewData["AdminActive"]
        ?? (string.Equals(action, "DoanhThu", StringComparison.OrdinalIgnoreCase) ? "reports" : "overview");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Grand · Quản trị</title>
    <link rel="stylesheet" href="~/css/design.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-app">
        <aside class="admin-sidebar" id="admin-sidebar">
            <a class="admin-brand" asp-controller="ThongKe" asp-action="Dashboard">
                <span>U</span>
                <div><strong>UNETI GRAND</strong><small>HOTEL MANAGEMENT</small></div>
            </a>
            <div class="sidebar-section-label">Không gian làm việc</div>
            <nav>
                @if (isKhachHang)
                {
                    <a class="@(active == "customers" ? "is-active" : "")" asp-controller="DatPhong" asp-action="Index"><i>K</i><span>Đặt phòng</span></a>
                    <a class="@(active == "profile" ? "is-active" : "")" asp-controller="KhachHang" asp-action="Profile"><i>H</i><span>Hồ sơ cá nhân</span></a>
                }
                else
                {
                    <a class="@(active == "overview" ? "is-active" : "")" asp-controller="ThongKe" asp-action="Dashboard"><i>⌂</i><span>Tổng quan</span></a>
                    @if (isAdmin)
                    {
                        <a class="@(active == "accounts" ? "is-active" : "")" asp-controller="TaiKhoan" asp-action="Index"><i>A</i><span>Tài khoản &amp; loại phòng</span></a>
                    }
                    <a class="@(active == "rooms" ? "is-active" : "")" asp-controller="Phong" asp-action="Index"><i>P</i><span>Quản lý phòng</span></a>
                    <a class="@(active == "customers" ? "is-active" : "")" asp-controller="KhachHang" asp-action="Index"><i>K</i><span>Khách hàng &amp; đặt phòng</span></a>
                    <a class="@(active == "operations" ? "is-active" : "")" asp-controller="QuanLyDatPhong" asp-action="Index"><i>N</i><span>Tiếp nhận &amp; trạng thái</span></a>
                    <a class="@(active == "reviews" ? "is-active" : "")" asp-controller="DanhGia" asp-action="QuanLy"><i>★</i><span>Đánh giá &amp; khiếu nại</span></a>
                    <a class="@(active == "reports" ? "is-active" : "")" asp-controller="ThongKe" asp-action="DoanhThu"><i>B</i><span>Doanh thu &amp; báo cáo</span></a>
                }
            </nav>
            <a class="back-to-site" asp-controller="Home" asp-action="Index">← Về trang khách sạn</a>
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <button class="admin-menu" id="admin-menu-btn" aria-label="Mở menu" type="button">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <form class="global-search" method="get" asp-controller="@(isKhachHang ? "DatPhong" : "Phong")" asp-action="Index">
                    <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                    <input name="keyword" placeholder="@(isKhachHang ? "Tìm phòng theo số phòng, tiện nghi..." : "Tìm nhanh phòng (số phòng, loại, trạng thái)...")" />
                    <kbd>tìm</kbd>
                </form>
                <div class="admin-header-actions">
                    @if (isKhachHang)
                    {
                        <a class="notification" asp-controller="DatPhong" asp-action="LichSu" title="Lịch sử đặt phòng">
                            <svg class="admin-icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg>
                            <i></i>
                        </a>
                    }
                    else
                    {
                        @* Chuông thông báo: poll /HoatDong/ThongBao mỗi 15s — đơn đặt mới, đánh giá mới. *@
                        <div style="position:relative;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="notification" id="tb-bell" title="Thông báo" style="background:none;border:none;cursor:pointer;">
                                <svg class="admin-icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg>
                                <i id="tb-badge-dot" style="display:none;"></i>
                                <span id="tb-count" style="display:none;position:absolute;top:-4px;right:-4px;background:#c0392b;color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:8px;align-items:center;justify-content:center;padding:0 4px;"></span>
                            </button>
                            <div id="tb-dropdown" style="display:none;position:absolute;right:0;top:44px;width:340px;max-width:calc(100vw - 40px);background:#fff;border:1px solid #e4e7e9;border-radius:10px;box-shadow:0 18px 48px rgba(23,36,51,.18);z-index:9500;overflow:hidden;">
                                <div style="padding:10px 14px;border-bottom:1px solid #eef1f3;display:flex;justify-content:space-between;align-items:center;">
                                    <strong style="font-size:12px;">Thông báo mới</strong>
                                    <button type="button" id="tb-readall" style="background:none;border:none;color:#b28c49;font-size:11px;cursor:pointer;">Đã đọc tất cả</button>
                                </div>
                                <div id="tb-list" style="max-height:320px;overflow-y:auto;"></div>
                            </div>
                        </div>
                    }
                    <div class="admin-profile" title="@Context.Session.GetTenDangNhap()">
                        <span>
                            @{
                                var tenHienThi = Context.Session.GetHoTen();
                                var chuCai = string.IsNullOrWhiteSpace(tenHienThi) ? "U" : tenHienThi.Trim().Substring(0, 1).ToUpperInvariant();
                            }
                            @chuCai
                        </span>
                        <div>
                            <strong>@(string.IsNullOrWhiteSpace(tenHienThi) ? "Quản trị viên" : tenHienThi)</strong>
                            <small>@(string.IsNullOrWhiteSpace(vaiTro) ? "Khách" : vaiTro == "NhanVien" ? "Nhân viên" : vaiTro)</small>
                        </div>
                        <svg class="admin-icon" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
                    </div>
                    <a class="row-action" asp-controller="DangNhap" asp-action="Logout" title="Đăng xuất">
                        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                    </a>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
        <button class="admin-scrim" id="admin-scrim" aria-label="Đóng menu" type="button"></button>
    </div>

    <script>
        (function () {
            var sidebar = document.getElementById("admin-sidebar");
            var scrim = document.getElementById("admin-scrim");
            var menuBtn = document.getElementById("admin-menu-btn");
            function closeSidebar() {
                if (sidebar) sidebar.classList.remove("is-open");
                if (scrim) scrim.classList.remove("show");
            }
            if (menuBtn && sidebar) {
                menuBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("is-open");
                    if (scrim) scrim.classList.toggle("show", sidebar.classList.contains("is-open"));
                });
            }
            if (scrim) scrim.addEventListener("click", closeSidebar);

            // Resize lên desktop thì đóng drawer: tránh scrim .show còn sót
            // làm hiện màng đen khi thu nhỏ lại.
            window.addEventListener("resize", function () {
                if (window.innerWidth > 820) closeSidebar();
            });
        })();
    </script>
    @if (!isKhachHang)
    {
        <script>
            (function () {
                var bell = document.getElementById("tb-bell");
                var drop = document.getElementById("tb-dropdown");
                var list = document.getElementById("tb-list");
                var count = document.getElementById("tb-count");
                var dot = document.getElementById("tb-badge-dot");
                var readAll = document.getElementById("tb-readall");
                var token = document.querySelector('input[name="__RequestVerificationToken"]');

                function render(data) {
                    if (data.soLuong > 0) {
                        count.textContent = data.soLuong > 99 ? "99+" : data.soLuong;
                        count.style.display = "inline-flex";
                        dot.style.display = "block";
                    } else {
                        count.style.display = "none";
                        dot.style.display = "none";
                    }
                    list.innerHTML = data.danhSach.length === 0
                        ? '<div style="padding:18px;text-align:center;color:#8a93a0;font-size:12px;">Không có thông báo mới.</div>'
                        : data.danhSach.map(function (h) {
                            var link = h.loai === "DanhGia" ? "@Url.Action("QuanLy", "DanhGia")" : "@Url.Action("Index", "QuanLyDatPhong")";
                            return '<a href="' + link + '" style="display:block;padding:10px 14px;border-bottom:1px solid #f4f6f8;text-decoration:none;color:inherit;font-size:12px;line-height:1.5;">'
                                + '<strong style="color:#b28c49;">' + (h.loai === "DatPhong" ? "ĐẶT PHÒNG MỚI" : h.loai === "DanhGia" ? "ĐÁNH GIÁ MỚI" : h.loai) + '</strong> '
                                + '<span style="color:#8a93a0;font-size:10px;margin-left:6px;">' + h.thoiGian + '</span>'
                                + '<div style="color:#3f4a55;">' + h.moTa + '</div></a>';
                        }).join("");
                }

                function load() {
                    fetch("@Url.Action("ThongBao", "HoatDong")", { credentials: "same-origin" })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (d) { if (d) render(d); })
                        .catch(function () { });
                }

                bell.addEventListener("click", function (e) {
                    e.stopPropagation();
                    drop.style.display = drop.style.display === "block" ? "none" : "block";
                });
                document.addEventListener("click", function (e) {
                    if (!drop.contains(e.target)) drop.style.display = "none";
                });
                readAll.addEventListener("click", function (e) {
                    e.stopPropagation();
                    var fd = new FormData();
                    fd.append("__RequestVerificationToken", token ? token.value : "");
                    fetch("@Url.Action("DanhDauDaDoc", "HoatDong")", { method: "POST", body: fd, credentials: "same-origin" })
                        .then(function () { drop.style.display = "none"; render({ soLuong: 0, danhSach: [] }); });
                });

                load();
                setInterval(load, 15000);
            })();
        </script>
    }
    @await Html.PartialAsync("_ChatbotWidget")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
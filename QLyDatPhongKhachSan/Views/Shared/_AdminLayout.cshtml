@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Layout quản trị theo bản thiết kế DesignProjectWithSuggestions
    (sidebar 6 module, header, bảng dữ liệu). Được dùng bởi các trang module 5.
*@
@using QLyDatPhongKhachSan.Helpers
@{
    var vaiTro = Context.Session.GetVaiTro();
    var isAdmin = vaiTro == "Admin";
    var isKhachHang = vaiTro == "KhachHang";

    var action = Context.Request.RouteValues["action"]?.ToString();
    var active = (string?)ViewData["AdminActive"]
        ?? (string.Equals(action, "DoanhThu", StringComparison.OrdinalIgnoreCase) ? "reports" : "overview");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Grand · Quản trị</title>
    <link rel="stylesheet" href="~/css/design.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-app">
        <aside class="admin-sidebar" id="admin-sidebar">
            <a class="admin-brand" asp-controller="ThongKe" asp-action="Dashboard">
                <span>U</span>
                <div><strong>UNETI GRAND</strong><small>HOTEL MANAGEMENT</small></div>
            </a>
            <div class="sidebar-section-label">Không gian làm việc</div>
            <nav>
                <a class="@(active == "overview" ? "is-active" : "")" asp-controller="ThongKe" asp-action="Dashboard"><i>⌂</i><span>Tổng quan</span></a>
                @if (isAdmin)
                {
                    <a class="@(active == "accounts" ? "is-active" : "")" asp-controller="TaiKhoan" asp-action="Index"><i>A</i><span>Tài khoản &amp; loại phòng</span><small>SV 1</small></a>
                }
                <a class="@(active == "rooms" ? "is-active" : "")" asp-controller="Phong" asp-action="Index"><i>P</i><span>Quản lý phòng</span><small>SV 2</small></a>
                @if (isKhachHang)
                {
                    <a class="@(active == "customers" ? "is-active" : "")" asp-controller="DatPhong" asp-action="Index"><i>K</i><span>Khách hàng &amp; đặt phòng</span><small>SV 3</small></a>
                }
                @if (!isKhachHang)
                {
                    <a class="@(active == "operations" ? "is-active" : "")" asp-controller="QuanLyDatPhong" asp-action="Index"><i>N</i><span>Tiếp nhận &amp; trạng thái</span><small>SV 4</small></a>
                }
                <a class="@(active == "reports" ? "is-active" : "")" asp-controller="ThongKe" asp-action="DoanhThu"><i>B</i><span>Doanh thu &amp; báo cáo</span><small>SV 5</small></a>
            </nav>
            <div class="sidebar-help">
                <span>?</span>
                <div><strong>Module 5 · SV5</strong><small>Dashboard &amp; thống kê doanh thu</small></div>
            </div>
            <a class="back-to-site" asp-controller="Home" asp-action="Index">← Về trang khách sạn</a>
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <button class="admin-menu" id="admin-menu-btn" aria-label="Mở menu" type="button">
                    <svg class="admin-icon" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <form class="global-search" method="get" asp-controller="Phong" asp-action="Index">
                    <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                    <input name="keyword" placeholder="Tìm nhanh phòng (số phòng, loại, trạng thái)..." />
                    <kbd>tìm</kbd>
                </form>
                <div class="admin-header-actions">
                    <a class="notification" asp-controller="QuanLyDatPhong" asp-action="Index" title="Việc tiếp nhận">
                        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg>
                        <i></i>
                    </a>
                    <div class="admin-profile" title="@Context.Session.GetTenDangNhap()">
                        <span>
                            @{
                                var tenHienThi = Context.Session.GetHoTen();
                                var chuCai = string.IsNullOrWhiteSpace(tenHienThi) ? "U" : tenHienThi.Trim().Substring(0, 1).ToUpperInvariant();
                            }
                            @chuCai
                        </span>
                        <div>
                            <strong>@(string.IsNullOrWhiteSpace(tenHienThi) ? "Quản trị viên" : tenHienThi)</strong>
                            <small>@(string.IsNullOrWhiteSpace(vaiTro) ? "Khách" : vaiTro == "NhanVien" ? "Nhân viên" : vaiTro)</small>
                        </div>
                        <svg class="admin-icon" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
                    </div>
                    <a class="row-action" asp-controller="DangNhap" asp-action="Logout" title="Đăng xuất">
                        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                    </a>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
        <button class="admin-scrim" id="admin-scrim" aria-label="Đóng menu" type="button"></button>
    </div>

    <script>
        (function () {
            var sidebar = document.getElementById("admin-sidebar");
            var scrim = document.getElementById("admin-scrim");
            var menuBtn = document.getElementById("admin-menu-btn");
            function closeSidebar() {
                if (sidebar) sidebar.classList.remove("is-open");
                if (scrim) scrim.classList.remove("show");
            }
            if (menuBtn && sidebar) {
                menuBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("is-open");
                    if (scrim) scrim.classList.toggle("show", sidebar.classList.contains("is-open"));
                });
            }
            if (scrim) scrim.addEventListener("click", closeSidebar);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@*
    Chatbot CSKH — widget nổi góc phải dưới.
    Tự chứa (CSS/JS inline) để gắn vào bất kỳ layout nào không mất style.
*@
@using QLyDatPhongKhachSan.Helpers
@{
    var laNhanVien = Context.Session.GetVaiTro() is "Admin" or "NhanVien";
}
<style>
    #cb-fab {
        position: fixed; right: 22px; bottom: 22px; z-index: 9000;
        width: 54px; height: 54px; border-radius: 50%; border: none; cursor: pointer;
        background: #1f3a5f; color: #fff; font-size: 22px;
        box-shadow: 0 8px 24px rgba(31, 58, 95, .35);
        display: flex; align-items: center; justify-content: center;
    }
    #cb-fab:hover { background: #b28c49; }
    #cb-panel {
        position: fixed; right: 22px; bottom: 88px; z-index: 9000;
        width: 340px; max-width: calc(100vw - 44px); height: 460px; max-height: calc(100vh - 130px);
        background: #fff; border: 1px solid #e4e7e9; border-radius: 14px;
        box-shadow: 0 18px 48px rgba(23, 36, 51, .22);
        display: none; flex-direction: column; overflow: hidden;
        font-family: "DM Sans", sans-serif;
    }
    #cb-panel.open { display: flex; }
    .cb-head { background: #1f3a5f; color: #fff; padding: 13px 16px; }
    .cb-head strong { display: block; font-size: 14px; }
    .cb-head small { opacity: .75; font-size: 11px; }
    .cb-msgs { flex: 1; overflow-y: auto; padding: 12px; background: #f7f9fa; }
    .cb-msg { max-width: 88%; margin-bottom: 8px; padding: 9px 12px; border-radius: 10px; font-size: 13px; line-height: 1.45; white-space: pre-line; }
    .cb-bot { background: #fff; border: 1px solid #e4e7e9; color: #26333f; border-bottom-left-radius: 3px; }
    .cb-user { background: #1f3a5f; color: #fff; margin-left: auto; border-bottom-right-radius: 3px; }
    .cb-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 12px 10px; background: #f7f9fa; }
    .cb-chips button {
        border: 1px solid #d9c08a; background: #fff; color: #8a6d33;
        border-radius: 999px; padding: 5px 11px; font-size: 11px; cursor: pointer;
    }
    .cb-chips button:hover { background: #faf4e6; }
    .cb-input { display: flex; gap: 8px; padding: 10px; border-top: 1px solid #e4e7e9; background: #fff; }
    .cb-input input { flex: 1; border: 1px solid #dce0e3; border-radius: 8px; padding: 9px 12px; font-size: 13px; outline: none; }
    .cb-input input:focus { border-color: #b28c49; }
    .cb-input button { border: none; background: #b28c49; color: #fff; border-radius: 8px; padding: 0 16px; cursor: pointer; font-size: 13px; }
    .cb-input button:disabled { opacity: .5; cursor: default; }
</style>

<button id="cb-fab" type="button" title="Hỏi đáp cùng trợ lý ảo" aria-label="Mở chatbot">💬</button>

<div id="cb-panel" role="dialog" aria-label="Trợ lý ảo UNETI Grand">
    <div class="cb-head">
        <strong>Trợ lý ảo UNETI Grand</strong>
        <small>Hỏi giá phòng, phòng trống, dịch vụ, đơn đặt...</small>
    </div>
    <div class="cb-msgs" id="cb-msgs">
        <div class="cb-msg cb-bot">Xin chào! Mình có thể hỗ trợ bạn về giá phòng, phòng trống, dịch vụ và theo dõi đơn đặt phòng.</div>
    </div>
    <div class="cb-chips" id="cb-chips">
        @if (laNhanVien)
        {
            <button type="button">Hôm nay có gì?</button>
        }
        <button type="button">Giá phòng bao nhiêu?</button>
        <button type="button">Còn phòng trống không?</button>
        <button type="button">Có dịch vụ gì?</button>
        <button type="button">Chính sách hủy thế nào?</button>
    </div>
    <form class="cb-input" id="cb-form">
        <input id="cb-text" type="text" placeholder="Nhập câu hỏi..." maxlength="300" autocomplete="off" />
        <button id="cb-send" type="submit">Gửi</button>
    </form>
</div>

<script>
    (function () {
        var fab = document.getElementById("cb-fab");
        var panel = document.getElementById("cb-panel");
        var msgs = document.getElementById("cb-msgs");
        var form = document.getElementById("cb-form");
        var input = document.getElementById("cb-text");
        var send = document.getElementById("cb-send");
        var chips = document.getElementById("cb-chips");
        var busy = false;

        fab.addEventListener("click", function () {
            panel.classList.toggle("open");
            if (panel.classList.contains("open")) input.focus();
        });

        function addMsg(text, cls) {
            var div = document.createElement("div");
            div.className = "cb-msg " + cls;
            div.textContent = text;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function ask(question) {
            if (busy || !question) return;
            busy = true;
            send.disabled = true;
            addMsg(question, "cb-user");
            fetch("@Url.Action("Hoi", "Chatbot")", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ cauHoi: question })
            })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (res) {
                    addMsg(res.ok && res.d.cauTraLoi ? res.d.cauTraLoi : "Xin lỗi, đã có lỗi xảy ra. Bạn thử lại sau nhé.", "cb-bot");
                })
                .catch(function () {
                    addMsg("Không kết nối được máy chủ. Bạn thử lại sau nhé.", "cb-bot");
                })
                .finally(function () {
                    busy = false;
                    send.disabled = false;
                    input.focus();
                });
        }

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            var q = input.value.trim();
            input.value = "";
            ask(q);
        });

        chips.addEventListener("click", function (e) {
            if (e.target.tagName === "BUTTON") ask(e.target.textContent);
        });
    })();
</script>

@*
    Giao diện Trang chủ Khách sạn UNETI Grand Hotel & Spa - Chuẩn Sang Trọng & Hài Hòa 2026.
*@
@{
    ViewData["Title"] = "Trang Chủ - UNETI Grand Hotel & Spa";
}

<!-- Hero Banner Sang Trọng & Hài Hòa -->
<div class="position-relative rounded-4 overflow-hidden mb-5 shadow-lg" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #0f172a 100%);">
    <!-- Overlay Họa Tiết Sang Trọng -->
    <div class="py-5 px-4 px-md-5 text-center my-4 position-relative z-1">
        <span class="badge bg-gold px-4 py-2 rounded-pill fw-bold mb-3 shadow-sm text-uppercase tracking-wider">
            <i class="bi bi-star-fill me-1"></i>KHÁCH SẠN NGHỈ DƯỠNG QUỐC TẾ 5 SAO
        </span>
        
        <h1 class="display-3 fw-bold text-white mb-3 tracking-tight" style="text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);">
            UNETI GRAND HOTEL & SPA
        </h1>
        
        <p class="lead max-width-600 mx-auto text-white-50 mb-4 fs-5 fw-light opacity-90" style="max-width: 680px;">
            Tận hưởng không gian nghỉ dưỡng đẳng cấp thượng hạng, không gian yên bình và ẩm thực tinh tế giữa lòng thành phố.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Phong" asp-action="Index" class="btn btn-gold btn-lg rounded-pill fw-bold px-5 py-3 shadow-lg">
                <i class="bi bi-calendar-check me-2"></i>KÍCH HOẠT TÌM PHÒNG NGAY
            </a>
            <a href="#loai-phong" class="btn btn-outline-light btn-lg rounded-pill fw-semibold px-4 py-3 border-2">
                <i class="bi bi-compass me-2"></i>Khám Phá Hạng Phòng
            </a>
        </div>
    </div>
</div>

<!-- Thanh Tìm Kiếm Đặt Phòng Nhanh (Booking Bar) Hài Hòa -->
<div class="card border-0 shadow-lg rounded-4 p-4 mb-5 bg-white border border-light-subtle" style="margin-top: -60px; z-index: 10; position: relative;">
    <form asp-controller="Phong" asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-calendar-event me-1 text-gold"></i>Ngày nhận phòng</label>
            <input type="date" class="form-control form-control-lg rounded-3 fs-6 border-light-subtle" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-calendar-check me-1 text-gold"></i>Ngày trả phòng</label>
            <input type="date" class="form-control form-control-lg rounded-3 fs-6 border-light-subtle" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-people me-1 text-gold"></i>Số khách lưu trú</label>
            <select class="form-select form-select-lg rounded-3 fs-6 border-light-subtle">
                <option value="1">1 Người lớn</option>
                <option value="2" selected>2 Người lớn</option>
                <option value="3">3 - 4 Người lớn</option>
                <option value="5">Gia đình (> 4 người)</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-dark btn-lg rounded-3 w-100 fw-bold py-3 shadow-sm" style="background-color: #0f172a;">
                <i class="bi bi-search me-2 text-gold"></i>TÌM PHÒNG TRỐNG
            </button>
        </div>
    </form>
</div>

<!-- Khám Phá Hạng Phòng Sang Trọng & Đồng Bộ Sắc Màu -->
<div id="loai-phong" class="mb-5 pt-3">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-gold fw-bold text-uppercase tracking-wider small"><i class="bi bi-gem me-1"></i>HẠNG PHÒNG NỔI BẬT</span>
            <h2 class="fw-bold text-dark mb-0">Không Gian Nghỉ Dưỡng Thượng Hạng</h2>
        </div>
        <a asp-controller="Phong" asp-action="Index" class="btn btn-link text-primary text-decoration-none fw-bold p-0 fs-6">
            Xem tất cả phòng <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        <!-- Card 1: Deluxe Room -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift bg-white">
                <div class="p-5 text-center text-white position-relative" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                    <i class="bi bi-door-closed display-3 text-light"></i>
                    <span class="badge bg-gold text-white position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">1,200,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2 text-dark">Phòng Deluxe Hướng Biển</h5>
                    <p class="text-muted small mb-3">Diện tích 35m², ban công hướng biển tuyệt đẹp, giường King-size cao cấp, đầy đủ tiện nghi chuẩn 5 sao.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1 text-gold"></i>Tối đa 2 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Executive Suite -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift bg-white">
                <div class="p-5 text-center text-white position-relative" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                    <i class="bi bi-building display-3 text-gold"></i>
                    <span class="badge bg-gold text-white position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">2,500,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2 text-dark">Executive Suite Cao Cấp</h5>
                    <p class="text-muted small mb-3">Diện tích 65m², phòng khách riêng biệt, bồn tắm ngâm khoáng ngắm toàn cảnh thành phố rực rỡ.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1 text-gold"></i>Tối đa 4 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Presidential Suite -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift bg-white">
                <div class="p-5 text-center text-white position-relative" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                    <i class="bi bi-gem display-3 text-light"></i>
                    <span class="badge bg-gold text-white position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">5,000,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2 text-dark">Presidential Suite Thượng Hạng</h5>
                    <p class="text-muted small mb-3">Căn hộ Penthouse 120m², hồ bơi vô cực riêng, dịch vụ quản gia cá nhân butler 24/7 chuyên nghiệp.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1 text-gold"></i>Tối đa 6 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dịch Vụ & Tiện Ích Đỉnh Cao -->
<div class="bg-white rounded-4 p-5 mb-5 shadow-sm border border-light-subtle">
    <div class="text-center mb-4">
        <span class="text-gold fw-bold text-uppercase tracking-wider small">TRẢI NGHIỆM ĐẮNG CẤP</span>
        <h2 class="fw-bold text-dark">Tiện Ích & Dịch Vụ Khách Sạn</h2>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="p-4 bg-light rounded-4 h-100 hover-lift">
                <div class="p-3 bg-white rounded-circle d-inline-block shadow-sm mb-3">
                    <i class="bi bi-water text-primary fs-2"></i>
                </div>
                <h6 class="fw-bold text-dark">Bể Bơi Vô Cực</h6>
                <p class="text-muted small mb-0">Hồ bơi nước ấm tầng thượng ngắm toàn cảnh thành phố.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-light rounded-4 h-100 hover-lift">
                <div class="p-3 bg-white rounded-circle d-inline-block shadow-sm mb-3">
                    <i class="bi bi-cup-hot-fill text-gold fs-2"></i>
                </div>
                <h6 class="fw-bold text-dark">Nhà Hàng 5 Sao</h6>
                <p class="text-muted small mb-0">Ẩm thực Á-Âu chế biến bởi các đầu bếp nổi tiếng.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-light rounded-4 h-100 hover-lift">
                <div class="p-3 bg-white rounded-circle d-inline-block shadow-sm mb-3">
                    <i class="bi bi-flower1 text-primary fs-2"></i>
                </div>
                <h6 class="fw-bold text-dark">Spa & Wellness</h6>
                <p class="text-muted small mb-0">Liệu trình trị liệu thư giãn tinh thần và sức khỏe.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-light rounded-4 h-100 hover-lift">
                <div class="p-3 bg-white rounded-circle d-inline-block shadow-sm mb-3">
                    <i class="bi bi-car-front-fill text-gold fs-2"></i>
                </div>
                <h6 class="fw-bold text-dark">Đưa Đón Sân Bay</h6>
                <p class="text-muted small mb-0">Dịch vụ xe đưa đón sang trọng, an toàn 24/7.</p>
            </div>
        </div>
    </div>
</div>

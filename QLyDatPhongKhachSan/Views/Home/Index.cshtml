@*
    Giao diện Trang chủ Khách sạn UNETI Grand Hotel & Spa - Chuẩn UI/UX 2026 Tinh Tế & Sang Trọng (Tone Xanh Navy / Platinum / Deep Indigo).
*@
@{
    ViewData["Title"] = "Trang Chủ - UNETI Grand Hotel & Spa";
}

<!-- Hero Section Sang Trọng Tone Navy & Platinum UI/UX 2026 -->
<div class="position-relative rounded-4 overflow-hidden mb-5 shadow-lg bg-gradient text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);">
    <div class="py-5 px-4 px-md-5 text-center my-4 position-relative z-1">
        <span class="badge bg-white bg-opacity-15 text-white border border-white border-opacity-25 px-4 py-2 rounded-pill fw-semibold mb-3 shadow-sm">
            <i class="bi bi-star-fill text-light me-2"></i>KHÁCH SẠN NGHỈ DƯỠNG QUỐC TẾ 5 SAO
        </span>
        <h1 class="display-3 fw-bold mb-3 text-white tracking-tight">UNETI GRAND HOTEL & SPA</h1>
        <p class="lead max-width-600 mx-auto text-light opacity-90 mb-4 fs-5 fw-light">
            Tận hưởng không gian nghỉ dưỡng đẳng cấp, dịch vụ thượng hạng và trải nghiệm ẩm thực đỉnh cao giữa lòng thành phố.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Phong" asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-bold px-5 py-3 shadow-lg text-primary">
                <i class="bi bi-calendar-check me-2"></i>TÌM & ĐẶT PHÒNG NGAY
            </a>
            <a href="#loai-phong" class="btn btn-outline-light btn-lg rounded-pill fw-semibold px-4 py-3 border-2">
                <i class="bi bi-compass me-2"></i>Khám Phá Hạng Phòng
            </a>
        </div>
    </div>
</div>

<!-- Thanh Tìm Kiếm Phòng Nhanh (Booking Bar) -->
<div class="card border-0 shadow-lg rounded-4 p-4 mb-5 bg-white" style="margin-top: -60px; z-index: 10; position: relative;">
    <form asp-controller="Phong" asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-calendar-event me-1 text-primary"></i>Ngày nhận phòng</label>
            <input type="date" class="form-control form-control-lg rounded-3 fs-6 border-light-subtle" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-calendar-check me-1 text-primary"></i>Ngày trả phòng</label>
            <input type="date" class="form-control form-control-lg rounded-3 fs-6 border-light-subtle" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold text-secondary small"><i class="bi bi-people me-1 text-primary"></i>Số khách lưu trú</label>
            <select class="form-select form-select-lg rounded-3 fs-6 border-light-subtle">
                <option value="1">1 Người lớn</option>
                <option value="2" selected>2 Người lớn</option>
                <option value="3">3 - 4 Người lớn</option>
                <option value="5">Gia đình (> 4 người)</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary btn-lg rounded-3 w-100 fw-bold py-3 shadow-sm bg-gradient">
                <i class="bi bi-search me-2"></i>TÌM PHÒNG TRỐNG
            </button>
        </div>
    </form>
</div>

<!-- Khám Phá Hạng Phòng Sang Trọng -->
<div id="loai-phong" class="mb-5 pt-3">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase tracking-wider small">HẠNG PHÒNG NỔI BẬT</span>
            <h2 class="fw-bold text-dark mb-0">Không Gian Nghỉ Dưỡng Đẳng Cấp</h2>
        </div>
        <a asp-controller="Phong" asp-action="Index" class="btn btn-link text-primary text-decoration-none fw-bold p-0 fs-6">
            Xem tất cả phòng <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        <!-- Card 1: Deluxe Room -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-primary bg-gradient p-5 text-center text-white position-relative">
                    <i class="bi bi-door-closed display-3"></i>
                    <span class="badge bg-white text-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">1,200,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2">Phòng Deluxe Hướng Biển</h5>
                    <p class="text-muted small mb-3">Diện tích 35m², ban công riêng, giường King-size cao cấp, đầy đủ tiện nghi chuẩn 5 sao.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1"></i>Tối đa 2 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Executive Suite -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-dark bg-gradient p-5 text-center text-white position-relative">
                    <i class="bi bi-building display-3 text-info"></i>
                    <span class="badge bg-info text-dark position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">2,500,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2">Executive Suite Cao Cấp</h5>
                    <p class="text-muted small mb-3">Diện tích 65m², phòng khách riêng biệt, bồn tắm ngâm khoáng ngắm toàn cảnh thành phố.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1"></i>Tối đa 4 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Presidential Suite -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-slate p-5 text-center text-white position-relative" style="background-color: #0f172a;">
                    <i class="bi bi-gem display-3 text-light"></i>
                    <span class="badge bg-light text-dark position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm">5,000,000 VNĐ / Đêm</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2">Presidential Suite Thượng Hạng</h5>
                    <p class="text-muted small mb-3">Căn hộ Penthouse 120m², hồ bơi vô cực riêng, dịch vụ butler 24/7 chuyên nghiệp.</p>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <small class="text-secondary"><i class="bi bi-people me-1"></i>Tối đa 6 người</small>
                        <a asp-controller="Phong" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dịch Vụ & Tiện Ích Đổi Mới UI/UX 2026 -->
<div class="bg-light rounded-4 p-5 mb-5 shadow-sm border border-light-subtle">
    <div class="text-center mb-4">
        <span class="text-primary fw-bold text-uppercase tracking-wider small">TRẢI NGHIỆM THƯỢNG HẠNG</span>
        <h2 class="fw-bold text-dark">Tiện Ích & Dịch Vụ Đi Kèm</h2>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                <i class="bi bi-water text-primary display-4 mb-3 d-block"></i>
                <h6 class="fw-bold">Bể Bơi Vô Cực</h6>
                <p class="text-muted small mb-0">Hồ bơi nước ấm tầng thượng ngắm hoàng hôn ngút ngàn.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                <i class="bi bi-cup-hot-fill text-primary display-4 mb-3 d-block"></i>
                <h6 class="fw-bold">Nhà Hàng 5 Sao</h6>
                <p class="text-muted small mb-0">Ẩm thực Á-Âu được chế biến bởi các đầu bếp hàng đầu.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                <i class="bi bi-flower1 text-primary display-4 mb-3 d-block"></i>
                <h6 class="fw-bold">Spa & Wellness</h6>
                <p class="text-muted small mb-0">Liệu trình trị liệu thảo dược thư giãn tinh thần trọn vẹn.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                <i class="bi bi-car-front-fill text-primary display-4 mb-3 d-block"></i>
                <h6 class="fw-bold">Đưa Đón Sân Bay</h6>
                <p class="text-muted small mb-0">Dịch vụ xe sang đưa đón tận nơi 24/7 an toàn và nhanh chóng.</p>
            </div>
        </div>
    </div>
</div>

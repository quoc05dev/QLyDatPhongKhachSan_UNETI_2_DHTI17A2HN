@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Trang chủ công khai theo bản thiết kế
    DesignProjectWithSuggestions; hạng phòng lấy dữ liệu thật từ Phong/LoaiPhong.
*@
@using System.Globalization
@model QLyDatPhongKhachSan.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_HomeLayout";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrow = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var isNhanVien = Model.VaiTro == "Admin" || Model.VaiTro == "NhanVien";
    var activeFilter = Model.LoaiPhongFilter;
    var gD = CultureInfo.GetCultureInfo("vi-VN");
}

<main id="top">
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="#top" aria-label="UNETI Grand Hotel trang chủ">
                <span class="brand-mark">U</span>
                <span>
                    <strong>UNETI GRAND</strong>
                    <small>HOTEL &amp; SPA</small>
                </span>
            </a>

            <nav class="main-nav" id="main-nav">
                <a href="#top" class="is-active">Trang chủ</a>
                <a href="#rooms">Hạng phòng</a>
                <a href="#experience">Trải nghiệm</a>
                <a href="#story">Về chúng tôi</a>
                @if (Model.IsLoggedIn && isNhanVien)
                {
                    <a class="nav-admin-link" asp-controller="ThongKe" asp-action="Dashboard">Quản trị</a>
                }
                else if (Model.IsLoggedIn && Model.VaiTro == "KhachHang")
                {
                    <a class="nav-admin-link" asp-controller="DatPhong" asp-action="Index">Lịch sử đặt phòng</a>
                }
            </nav>

            <div class="nav-actions">
                @if (Model.IsLoggedIn)
                {
                    <span class="button button--ghost desktop-action">
                        <i style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#7dd3a0;margin-right:6px;"></i>@(Model.HoTen ?? Model.VaiTro)
                    </span>
                    <a class="button button--ghost desktop-action" asp-controller="DangNhap" asp-action="Logout">
                        Đăng xuất
                    </a>
                }
                else
                {
                    <a class="button button--ghost desktop-action" asp-controller="DangNhap" asp-action="Login">
                        <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Đăng nhập
                    </a>
                }
                <a class="button button--gold desktop-action" href="#booking">Đặt phòng</a>
                <button aria-label="Mở menu" class="button button--icon menu-button" id="menu-button" type="button">
                    <svg class="icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </div>
    </header>

    <section class="hero" id="hero">
        <img class="hero-image"
             src="https://images.unsplash.com/photo-1668277155756-0ebb2801f6b4?auto=format&fit=crop&w=2200&q=90"
             alt="Không gian nghỉ dưỡng nhìn ra biển lúc hoàng hôn" />
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <div class="eyebrow light"><span></span> Trải nghiệm nghỉ dưỡng 5 sao</div>
            <h1>Nơi mỗi khoảnh khắc<br />trở thành <em>di sản.</em></h1>
            <p>
                Vẻ đẹp tinh tuyển, lòng hiếu khách chân thành và những trải nghiệm
                được thiết kế riêng cho bạn.
            </p>
            <div class="hero-actions">
                <a class="button button--gold" href="#booking">Khám phá kỳ nghỉ
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                </a>
                <a class="text-link text-link--light" href="#rooms">Xem hạng phòng
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                </a>
            </div>
        </div>
        <div class="hero-index"><span>01</span><i></i><small>03</small></div>
    </section>

    <section class="booking-shell" id="booking">
        <div class="container">
            <form class="booking-panel" method="get" asp-controller="DatPhong" asp-action="Index" id="booking-form">
                <div class="booking-heading">
                    <span class="booking-icon">
                        <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m12 3 1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3Z" /><path d="m19 15 .7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7L19 15Z" /></svg>
                    </span>
                    <div>
                        <small>Đặt phòng trực tiếp</small>
                        <strong>Giá tốt nhất được đảm bảo</strong>
                    </div>
                </div>

                <div class="field">
                    <label for="checkin">Ngày nhận phòng</label>
                    <div class="input-wrap">
                        <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>
                        <input id="checkin" name="ngayNhan" type="date" value="@today" min="@today" required />
                    </div>
                </div>
                <div class="field">
                    <label for="checkout">Ngày trả phòng</label>
                    <div class="input-wrap">
                        <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>
                        <input id="checkout" name="ngayTra" type="date" value="@tomorrow" min="@tomorrow" required />
                    </div>
                </div>
                <div class="field guest-field">
                    <label>Số khách lưu trú</label>
                    <div class="guest-control">
                        <span class="guest-btn" id="guest-minus" role="button" aria-label="Giảm số khách">
                            <svg class="icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /></svg>
                        </span>
                        <span class="guest-value" id="guest-value">
                            <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" /></svg>
                            2 khách
                        </span>
                        <span class="guest-btn" id="guest-plus" role="button" aria-label="Tăng số khách">
                            <svg class="icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                        </span>
                    </div>
                </div>
                <button class="button button--navy search-button" type="submit" id="search-button">
                    <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                    Tìm phòng trống
                </button>
            </form>
        </div>
    </section>

    <section class="section rooms-section" id="rooms">
        <div class="container">
            <div class="search-status" id="search-status" role="status" style="display:@(activeFilter != null ? "flex" : "none");">
                <span>
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m5 12 4 4L19 6" /></svg>
                </span>
                <span id="search-status-text">
                    Hiển thị <strong>@Model.Phongs.Count</strong> hạng phòng thuộc loại <span id="search-status-loai">@activeFilter</span>.
                </span>
                <a class="text-link filter-btn" data-loai="all" href="#rooms" style="display:inline-flex;align-items:center;gap:6px;font-size: 12px;margin-left:8px;">
                    Xem tất cả
                    <svg class="icon" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </a>
            </div>

            <div class="section-header">
                <div>
                    <div class="eyebrow"><span></span> Hạng phòng nổi bật</div>
                    <h2>Không gian nghỉ dưỡng<br /><em>thượng hạng</em></h2>
                </div>
                <p>
                    Mỗi căn phòng là một không gian riêng tư, nơi từng chi tiết được
                    hoàn thiện để mang đến cảm giác thư thái trọn vẹn.
                </p>
            </div>

            <div class="filters" id="room-filters" aria-label="Lọc hạng phòng">
                <button type="button" class="button button--light filter-btn @(activeFilter == null ? "is-selected" : "")" data-loai="all">Tất cả</button>
                @foreach (var loai in Model.LoaiPhongs)
                {
                    var selected = activeFilter != null && string.Equals(activeFilter, loai, StringComparison.OrdinalIgnoreCase);
                    <button type="button" class="button button--light filter-btn @(selected ? "is-selected" : "")" data-loai="@loai">@loai</button>
                }
            </div>

            @if (Model.Phongs.Any())
            {
                <div class="room-grid">
                    @foreach (var card in Model.Phongs)
                    {
                        <article class="room-card" data-loai="@card.TenLoai">
                            <div class="room-media @(string.IsNullOrEmpty(card.HinhAnh) ? "room-media--placeholder" : "")">
                                @if (!string.IsNullOrEmpty(card.HinhAnh))
                                {
                                    <img src="@card.HinhAnh" alt="Phòng @card.SoPhong" />
                                }
                                else
                                {
                                    <span class="media-monogram">@card.TenLoai.Substring(0, 1)</span>
                                    <span class="media-caption">Phòng @card.SoPhong</span>
                                }
                                <span class="room-label">@card.Label</span>
                            </div>
                            <div class="room-body">
                                <div class="room-title-row">
                                    <div>
                                        <span class="room-type">@card.TenLoai</span>
                                        <h3>Phòng @card.SoPhong</h3>
                                    </div>
                                    <div class="rating">
                                        <svg class="icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9L12 2.8Z" /></svg>
                                        4.9
                                    </div>
                                </div>
                                <p class="room-meta">@card.Meta</p>
                                <p class="room-description">@card.MoTa</p>
                                <div class="room-footer">
                                    <div class="price">
                                        <small>Chỉ từ</small>
                                        <strong>@card.DonGia.ToString("N0", gD)₫</strong>
                                        <span>/ đêm</span>
                                    </div>
                                    <div class="room-actions">
                                        <button type="button" class="room-detail-link open-detail"
                                                data-ma-phong="@card.MaPhong"
                                                data-ten-loai="@card.TenLoai"
                                                data-so-phong="@card.SoPhong"
                                                data-meta="@card.Meta"
                                                data-mota="@card.MoTa"
                                                data-gia="@card.DonGia.ToString(CultureInfo.InvariantCulture)"
                                                data-img="@card.HinhAnh"
                                                data-images="@string.Join("|", card.DanhSachAnh)">
                                            Xem chi tiết phòng
                                        </button>
                                        <a class="button button--navy open-booking"
                                           href="javascript:void(0);"
                                           data-ma-phong="@card.MaPhong"
                                           data-ten-loai="@card.TenLoai"
                                           data-so-phong="@card.SoPhong"
                                           data-meta="@card.Meta"
                                           data-gia="@card.DonGia.ToString(CultureInfo.InvariantCulture)"
                                           data-don-vi="đêm">
                                            Chọn phòng
                                            <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p style="padding:60px 0;text-align:center;color:var(--muted);">
                    Không tìm thấy hạng phòng phù hợp. Vui lòng chọn loại phòng khác.
                </p>
            }
        </div>
    </section>

    <section class="section experience-section" id="experience">
        <div class="container experience-layout">
            <div class="experience-copy">
                <div class="eyebrow light"><span></span> Trải nghiệm tinh tuyển</div>
                <h2>Hơn cả một<br />kỳ nghỉ.</h2>
                <p>
                    Chạm đến sự cân bằng trong từng khoảnh khắc — từ làn nước xanh
                    trên tầng cao đến liệu trình trị liệu được cá nhân hóa.
                </p>
                <a class="text-link text-link--gold" href="#story">Khám phá tiện ích
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                </a>
            </div>
            <div class="experience-grid">
                <article class="experience-card card-1">
                    <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=1200&q=86" alt="Hồ bơi chân mây" />
                    <div class="experience-gradient"></div>
                    <div>
                        <small>01</small>
                        <h3>Hồ bơi chân mây</h3>
                        <p>Mở cửa hằng ngày · 06:00—22:00</p>
                    </div>
                </article>
                <article class="experience-card card-2">
                    <img src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=1200&q=86" alt="Serene Spa" />
                    <div class="experience-gradient"></div>
                    <div>
                        <small>02</small>
                        <h3>Serene Spa</h3>
                        <p>Liệu trình thư giãn từ thảo mộc bản địa</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="story-section" id="story">
        <div class="container story-grid">
            <div class="story-image">
                <img src="https://images.unsplash.com/photo-1428515613728-6b4607e44363?auto=format&fit=crop&w=1200&q=86" alt="Không gian ẩm thực riêng tư" />
                <div class="seal"><span>U</span><small>Since 2008</small></div>
            </div>
            <div class="story-copy">
                <div class="eyebrow"><span></span> Câu chuyện UNETI Grand</div>
                <h2>Lòng hiếu khách,<br /><em>được nâng tầm.</em></h2>
                <p class="lead">
                    “Chúng tôi tin rằng sự sang trọng đích thực không nằm ở những gì
                    hào nhoáng, mà ở cảm giác được thấu hiểu.”
                </p>
                <p>
                    Từ lời chào đầu tiên đến từng chi tiết nhỏ trong căn phòng, đội
                    ngũ của chúng tôi luôn hiện diện để biến kỳ nghỉ của bạn thành một
                    ký ức đáng trân trọng.
                </p>
                <div class="stats">
                    <div><strong>18+</strong><span>Năm kiến tạo<br />trải nghiệm</span></div>
                    <div><strong>4.9</strong><span>Điểm đánh giá<br />trung bình</span></div>
                    <div><strong>24/7</strong><span>Dịch vụ<br />tận tâm</span></div>
                </div>
            </div>
        </div>
    </section>

    <footer id="contact">
        <div class="container footer-main">
            <div>
                <a class="brand brand--footer" href="#top">
                    <span class="brand-mark">U</span>
                    <span><strong>UNETI GRAND</strong><small>HOTEL &amp; SPA</small></span>
                </a>
                <p>Nơi vẻ đẹp tinh tuyển gặp gỡ<br />lòng hiếu khách chân thành.</p>
            </div>
            <div class="footer-links">
                <div>
                    <strong>Khám phá</strong>
                    <a href="#rooms">Hạng phòng</a>
                    <a asp-controller="DichVu" asp-action="Index">Ẩm thực &amp; Spa</a>
                    <a href="#story">Về chúng tôi</a>
                </div>
                <div>
                    <strong>Hỗ trợ</strong>
                    <a href="#booking">Đặt phòng</a>
                    <a href="#contact">Liên hệ</a>
                    <a asp-controller="Home" asp-action="Privacy">Chính sách</a>
                </div>
                <div>
                    <strong>Liên hệ</strong>
                    <span>353 Trần Hưng Đạo, Hà Nội</span>
                    <span>+84 24 5555 8888</span>
                    <span>hello@unetigrand.vn</span>
                </div>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>© 2026 UNETI Grand Hotel &amp; Spa</span>
            <span>Được tạo nên với sự tận tâm.</span>
        </div>
    </footer>

    @* Modal đặt phòng *@
    <div class="modal-backdrop" id="booking-modal" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title">
            <button aria-label="Đóng" class="button button--icon modal-close" id="modal-close" type="button">
                <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
            <div id="modal-image-wrap">
                <img id="modal-image" src="" alt="" style="display:none;" />
                <div id="modal-monogram" class="room-media room-media--placeholder" style="display:none;height:220px;"></div>
            </div>
            <div class="modal-content">
                <div class="eyebrow"><span></span> Yêu cầu đặt phòng</div>
                <h2 id="booking-modal-title">Phòng</h2>
                <p id="modal-meta"></p>
                <div class="modal-summary">
                    <span id="modal-dates"></span>
                    <strong id="modal-total"></strong>
                </div>
                <a id="modal-cta" class="button button--gold modal-submit" href="#">
                    Tiếp tục đặt phòng
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                </a>
                <small class="modal-note">Đặt phòng sẽ được yêu cầu xác nhận với lễ tân. Chưa cần thanh toán ở bước này.</small>
            </div>
        </div>
    </div>

    @* Modal xem chi tiết phòng (gallery + mô tả, không bắt buộc đăng nhập) *@
    <div class="modal-backdrop" id="detail-modal" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="detail-modal-title">
            <button aria-label="Đóng" class="button button--icon modal-close" id="detail-close" type="button">
                <svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>

            <div class="detail-gallery">
                <img id="detail-main-img" src="" alt="" />
                <div class="detail-thumbs" id="detail-thumbs"></div>
            </div>

            <div class="modal-content">
                <div class="eyebrow"><span></span> Chi tiết hạng phòng</div>
                <h2 id="detail-modal-title">Phòng</h2>
                <p id="detail-meta"></p>
                <p id="detail-desc"></p>
                <div class="modal-summary">
                    <span id="detail-price-label">Giá mỗi đêm</span>
                    <strong id="detail-price"></strong>
                </div>
                <a id="detail-cta" class="button button--gold modal-submit" href="#">
                    Đặt phòng ngay
                    <svg class="icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></svg>
                </a>
                <small class="modal-note">Chọn ngày nhận / trả phòng ở bước tiếp theo. Chưa cần thanh toán ngay.</small>
            </div>
        </div>
    </div>
</main>

<script>
    (function () {
        var gD = new Intl.NumberFormat("vi-VN");

        function fmt(v) { return gD.format(v) + "₫"; }

        // Menu di động
        var nav = document.getElementById("main-nav");
        var menuBtn = document.getElementById("menu-button");
        if (menuBtn && nav) {
            menuBtn.addEventListener("click", function () {
                nav.classList.toggle("is-open");
            });
        }

        // Bộ đếm số khách
        var guestValue = document.getElementById("guest-value");
        var guests = 2;
        var guestMinus = document.getElementById("guest-minus");
        var guestPlus = document.getElementById("guest-plus");
        function renderGuests() {
            if (guestValue) guestValue.innerHTML = '<svg class="icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg> ' + guests + ' khách';
        }
        if (guestMinus) guestMinus.addEventListener("click", function () { if (guests > 1) { guests--; renderGuests(); } });
        if (guestPlus) guestPlus.addEventListener("click", function () { if (guests < 6) { guests++; renderGuests(); } });

        // Ngày trả phải lớn hơn ngày nhận
        var checkin = document.getElementById("checkin");
        var checkout = document.getElementById("checkout");
        if (checkin && checkout) {
            checkin.addEventListener("change", function () {
                var next = new Date(checkin.value);
                next.setDate(next.getDate() + 1);
                checkout.min = next.toISOString().split("T")[0];
                if (checkout.value && new Date(checkout.value) <= new Date(checkin.value)) {
                    checkout.value = checkout.min;
                }
            });
        }

        // Modal đặt phòng
        var modal = document.getElementById("booking-modal");
        var modalClose = document.getElementById("modal-close");
        function closeModal() { if (modal) modal.hidden = true; }
        if (modalClose) modalClose.addEventListener("click", closeModal);
        if (modal) {
            modal.addEventListener("mousedown", function (e) { if (e.target === modal) closeModal(); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeModal(); });
        }

        function openModal(btn) {
            if (!modal) return;
            var maPhong = btn.getAttribute("data-ma-phong");
            var tenLoai = btn.getAttribute("data-ten-loai");
            var soPhong = btn.getAttribute("data-so-phong");
            var meta = btn.getAttribute("data-meta");
            var gia = parseFloat(btn.getAttribute("data-gia") || "0");
            var soDem = 1;
            if (checkin && checkout && checkin.value && checkout.value) {
                var diff = (new Date(checkout.value) - new Date(checkin.value)) / 86400000;
                if (diff > 0) soDem = diff;
            }
            document.getElementById("booking-modal-title").textContent = tenLoai + " · Phòng " + soPhong;
            document.getElementById("modal-meta").textContent = meta;
            var imgWrap = document.getElementById("modal-image-wrap");
            var img = document.getElementById("modal-image");
            var mono = document.getElementById("modal-monogram");
            if (img && imgWrap && mono) {
                var src = btn.getAttribute("data-img");
                if (src) { img.src = src; img.alt = "Phòng " + soPhong; img.style.display = "block"; mono.style.display = "none"; }
                else { mono.style.display = "block"; mono.innerHTML = '<span class="media-monogram">' + tenLoai.substring(0, 1) + '</span><span class="media-caption">Phòng ' + soPhong + '</span>'; img.style.display = "none"; }
            }
            var dCheckin = new Date(checkin ? checkin.value : "");
            var dCheckout = new Date(checkout ? checkout.value : "");
            var dateText = "Vui lòng chọn ngày";
            if (dCheckin.getTime() && dCheckout.getTime()) {
                dateText = dCheckin.toLocaleDateString("vi-VN") + " — " + dCheckout.toLocaleDateString("vi-VN") + " (" + soDem + " đêm)";
            }
            document.getElementById("modal-dates").textContent = dateText;
            document.getElementById("modal-total").textContent = fmt(gia * soDem);
            var cta = document.getElementById("modal-cta");
            cta.href = "/DatPhong/Book?maPhong=" + maPhong + (checkin && checkin.value ? "&ngayNhan=" + encodeURIComponent(checkin.value) : "") + (checkout && checkout.value ? "&ngayTra=" + encodeURIComponent(checkout.value) : "");
            modal.hidden = false;
        }

        var openers = document.querySelectorAll(".open-booking");
        Array.prototype.forEach.call(openers, function (btn) {
            btn.addEventListener("click", function () { openModal(btn); });
        });

        // Đưa ảnh phòng lên nút mở modal nếu có
        var cards = document.querySelectorAll(".room-card");
        Array.prototype.forEach.call(cards, function (card) {
            var imgEl = card.querySelector(".room-media img");
            if (imgEl) {
                var btn = card.querySelector(".open-booking");
                if (btn) btn.setAttribute("data-img", imgEl.getAttribute("src"));
            }
        });

        // Xem chi tiết phòng: gallery ảnh + mô tả, không bắt buộc đăng nhập
        var detailModal = document.getElementById("detail-modal");
        var detailClose = document.getElementById("detail-close");
        var detailMain = document.getElementById("detail-main-img");
        var detailThumbs = document.getElementById("detail-thumbs");

        function closeDetail() { if (detailModal) detailModal.hidden = true; }
        if (detailClose) detailClose.addEventListener("click", closeDetail);
        if (detailModal) {
            detailModal.addEventListener("mousedown", function (e) { if (e.target === detailModal) closeDetail(); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDetail(); });
        }

        function renderThumbs(images) {
            if (!detailThumbs) return;
            detailThumbs.innerHTML = "";
            images.forEach(function (src, i) {
                var img = document.createElement("img");
                img.src = src;
                img.alt = "Ảnh phòng " + (i + 1);
                if (i === 0) img.classList.add("is-active");
                img.addEventListener("click", function () {
                    if (detailMain) detailMain.src = src;
                    Array.prototype.forEach.call(detailThumbs.querySelectorAll("img"), function (el) { el.classList.remove("is-active"); });
                    img.classList.add("is-active");
                });
                detailThumbs.appendChild(img);
            });
        }

        function openDetail(btn) {
            if (!detailModal) return;
            var maPhong = btn.getAttribute("data-ma-phong");
            var tenLoai = btn.getAttribute("data-ten-loai");
            var soPhong = btn.getAttribute("data-so-phong");
            var meta = btn.getAttribute("data-meta");
            var mota = btn.getAttribute("data-mota");
            var gia = parseFloat(btn.getAttribute("data-gia") || "0");

            var raw = btn.getAttribute("data-images") || "";
            var images = raw ? raw.split("|").filter(function (s) { return s; }) : [];
            var fallback = btn.getAttribute("data-img");
            if (!images.length && fallback) { images = [fallback]; }

            document.getElementById("detail-modal-title").textContent = tenLoai + " · Phòng " + soPhong;
            document.getElementById("detail-meta").textContent = meta;
            document.getElementById("detail-desc").textContent = mota;
            document.getElementById("detail-price-label").textContent = "Chỉ từ";
            document.getElementById("detail-price").textContent = fmt(gia) + " / đêm";

            if (detailMain && images.length) {
                detailMain.src = images[0];
                detailMain.alt = "Phòng " + soPhong;
            }
            renderThumbs(images);

            var cta = document.getElementById("detail-cta");
            if (cta) cta.setAttribute("data-ma-phong", maPhong);

            detailModal.hidden = false;
        }

        var detailOpeners = document.querySelectorAll(".open-detail");
        Array.prototype.forEach.call(detailOpeners, function (btn) {
            btn.addEventListener("click", function () { openDetail(btn); });
        });

        // Chuyển từ "Xem chi tiết" sang bước đặt phòng của cùng phòng.
        var detailCta = document.getElementById("detail-cta");
        if (detailCta) {
            detailCta.addEventListener("click", function (e) {
                e.preventDefault();
                var maPhong = detailCta.getAttribute("data-ma-phong");
                closeDetail();
                var opener = document.querySelector('.open-booking[data-ma-phong="' + maPhong + '"]');
                if (opener) openModal(opener);
            });
        }

        // Lọc hạng phòng không reload / không cuộn trang
        var filterBtns = document.querySelectorAll(".filter-btn");
        var searchStatus = document.getElementById("search-status");
        var searchStatusText = document.getElementById("search-status-text");

        function filterRooms(targetLoai) {
            var visibleCount = 0;
            filterBtns.forEach(function (btn) {
                if (btn.getAttribute("data-loai") === targetLoai) {
                    btn.classList.add("is-selected");
                } else {
                    btn.classList.remove("is-selected");
                }
            });

            cards.forEach(function (card) {
                var cardLoai = card.getAttribute("data-loai");
                if (targetLoai === "all" || cardLoai === targetLoai) {
                    card.style.display = "";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });

            if (searchStatus && searchStatusText) {
                if (targetLoai === "all") {
                    searchStatus.style.display = "none";
                } else {
                    searchStatus.style.display = "flex";
                    searchStatusText.innerHTML = 'Hiển thị <strong>' + visibleCount + '</strong> hạng phòng thuộc loại ' + targetLoai + '.';
                }
            }
        }

        filterBtns.forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();
                var targetLoai = btn.getAttribute("data-loai");
                filterRooms(targetLoai);
                var newUrl = targetLoai === "all" ? window.location.pathname + "#rooms" : window.location.pathname + "?loai=" + encodeURIComponent(targetLoai) + "#rooms";
                history.replaceState(null, "", newUrl);
            });
        });

        var urlParams = new URLSearchParams(window.location.search);
        var initialLoai = urlParams.get("loai");
        if (initialLoai) {
            filterRooms(initialLoai);
        }
    })();
</script>
<style>
    .guest-btn { cursor: pointer; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; color: var(--gold-500); }
    .guest-btn:hover { background: rgba(201, 163, 93, 0.12); }
    .guest-value { display: inline-flex !important; }

    /* Khu nút của thẻ phòng: "Xem chi tiết phòng" cạnh "Chọn phòng" */
    .room-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 14px; }
    .room-detail-link {
        background: none; border: 0; padding: 0; cursor: pointer; font: inherit;
        font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
        color: #1f3a5f; border-bottom: 1px solid var(--gold-500); line-height: 1.7; white-space: nowrap;
    }
    .room-detail-link:hover { color: var(--gold-500); }

    /* Modal xem chi tiết phòng */
    .detail-gallery { display: flex; flex-direction: column; background: var(--navy-950); }
    .detail-gallery > img { display: block; width: 100%; height: 380px; object-fit: cover; }
    .detail-thumbs { display: flex; gap: 8px; padding: 12px; overflow-x: auto; }
    .detail-thumbs img {
        flex: 0 0 auto; width: 74px; height: 54px; object-fit: cover; cursor: pointer;
        opacity: 0.5; border: 2px solid transparent; transition: opacity 0.2s ease, border-color 0.2s ease;
    }
    .detail-thumbs img:hover, .detail-thumbs img.is-active { opacity: 1; border-color: var(--gold-500); }
    #detail-meta { margin-top: 14px; }
    #detail-desc { margin-top: 12px; line-height: 1.7; }

    /* Đúng các breakpoint của .modal trong design.css (modal xếp dọc trên mobile) */
    @@media (max-width: 820px) {
        .detail-gallery > img { height: 250px; }
        .room-actions { justify-content: flex-start; }
    }
    @@media (max-width: 620px) {
        .detail-gallery > img { height: 180px; }
        .detail-thumbs img { width: 62px; height: 46px; }
    }
</style>
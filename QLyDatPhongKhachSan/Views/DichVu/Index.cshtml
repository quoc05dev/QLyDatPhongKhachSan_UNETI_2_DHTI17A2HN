@{
    ViewData["Title"] = "Danh sách dịch vụ";
}

<h1 class="h3 mb-3">Danh sách dịch vụ</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên dịch vụ</th>
            <th class="text-end">Giá (VNĐ)</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dv in Model)
        {
            <tr>
                <td>@dv.MaDichVu</td>
                <td>@dv.TenDichVu</td>
                <td class="text-end">@dv.Gia.ToString("N0")</td>
                <td>@dv.MoTa</td>
                <td>
                    @if (dv.TrangThai)
                    {
                        <span class="badge text-bg-success">Đang phục vụ</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Ngừng phục vụ</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@dv.MaDichVu">Xem</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-muted">Chưa có dịch vụ nào.</p>
}

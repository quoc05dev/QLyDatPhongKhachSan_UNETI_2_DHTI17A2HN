@*
    Họ và tên: Đặng Minh Quốc
    Mã sinh viên: 23103100069
    Nội dung thực hiện: Giao diện Xóa Dịch vụ (Module 5 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.DichVu

@{
    ViewData["Title"] = "Xóa dịch vụ";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "reports";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Thao tác xóa dịch vụ</span>
        <h1>Xóa dịch vụ: @Model.TenDichVu</h1>
        <p>Xác nhận xóa dịch vụ khỏi danh mục phục vụ của khách sạn.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 650px;">
    <div style="padding:14px 18px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size: 13px;border-radius:2px;line-height:1.6;">
        <strong style="display:block;margin-bottom:4px;font-size:13px;">🚨 Báo xác nhận xóa:</strong>
        Bạn có chắc chắn muốn xóa dịch vụ <strong>@Model.TenDichVu</strong> (#@Model.MaDichVu) không? Thao tác này không thể hoàn tác.
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:20px 0;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2;">
        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Tên dịch vụ</small>
            <strong style="font-size:15px;color:var(--navy-950);">@Model.TenDichVu</strong>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Giá dịch vụ</small>
            <span style="font-size:14px;color:#b28c49;font-weight:600;">@Model.Gia.ToString("N0")₫</span>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Trạng thái</small>
            <span style="font-size:14px;color:#334155;">@(Model.TrangThai ? "Đang phục vụ" : "Ngừng phục vụ")</span>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Mô tả</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "—" : Model.MoTa)</span>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.MaDichVu" method="post" style="margin-top:24px;display:flex;gap:12px;">
        <input type="hidden" asp-for="MaDichVu" />
        <button type="submit" class="admin-primary" style="background:#e74c3c;color:#fff;">Xác nhận xóa dịch vụ</button>
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ &amp; Quay lại</a>
    </form>
</article>

@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Chi tiết Loại phòng cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.LoaiPhong

@{
    ViewData["Title"] = "Chi tiết loại phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Hồ sơ loại phòng</span>
        <h1>Chi tiết: @Model.TenLoai</h1>
        <p>Thông tin niêm yết loại phòng và danh sách phòng đang áp dụng.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
        <a class="admin-primary" asp-action="Edit" asp-route-id="@Model.MaLoaiPhong" style="text-decoration:none;">Sửa thông tin</a>
    </div>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 900px;">
    <div style="display:flex;align-items:center;gap:16px;padding-bottom:20px;border-bottom:1px solid #edf0f2;margin-bottom:20px;">
        <div style="width:54px;height:54px;border-radius:50%;background:var(--navy-900);color:var(--gold-400);display:grid;place-items:center;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;">
            @Model.TenLoai.Trim().Substring(0, 1).ToUpperInvariant()
        </div>
        <div>
            <strong style="font-size:18px;color:var(--navy-950);display:block;">@Model.TenLoai</strong>
            <span style="font-size: 13px;color:#5d666f;">Mã loại phòng: #@Model.MaLoaiPhong · Sức chứa tối đa: <b style="color:#b28c49;">@Model.SoNguoiToiDa người</b></span>
        </div>
        <div style="margin-left:auto;">
            @if (Model.TrangThai)
            {
                <span class="status-badge status-badge--success"><i></i>Đang kinh doanh</span>
            }
            else
            {
                <span class="status-badge status-badge--warning"><i></i>Ngừng kinh doanh</span>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Đơn giá theo ngày</small>
            <strong style="font-size:16px;color:#b28c49;">@Model.DonGiaNgay.ToString("N0")₫</strong>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Hình ảnh đại diện</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "—" : Model.HinhAnh)</span>
        </div>

        <div style="grid-column: span 2;">
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Mô tả</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "—" : Model.MoTa)</span>
        </div>
    </div>

    <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;">
        <strong style="font-size:13px;color:var(--navy-900);display:block;margin-bottom:12px;">Danh sách phòng thuộc loại này (@(Model.Phongs?.Count ?? 0))</strong>
        @if (Model.Phongs != null && Model.Phongs.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Số phòng</th>
                            <th>Tầng</th>
                            <th>Hướng</th>
                            <th>Đơn giá</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Phongs)
                        {
                            <tr>
                                <td><strong>@p.SoPhong</strong></td>
                                <td>Tầng @p.Tang</td>
                                <td>@(string.IsNullOrWhiteSpace(p.HuongPhong) ? "—" : p.HuongPhong)</td>
                                <td>@p.DonGia.ToString("N0")₫</td>
                                <td>@TrangThaiHelper.HienThi(p.TrangThai)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-table">
                <strong>Chưa có phòng nào</strong>
                <span>Loại phòng này hiện chưa được gán cho phòng nào.</span>
            </div>
        }
    </div>
</article>

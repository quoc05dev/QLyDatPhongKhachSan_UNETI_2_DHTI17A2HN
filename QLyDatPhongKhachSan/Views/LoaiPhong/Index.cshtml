@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Quản lý danh sách Loại phòng cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.ViewModels.LoaiPhongListViewModel

@{
    ViewData["Title"] = "Quản lý Loại phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Quản trị hệ thống</span>
        <h1>Quản lý loại phòng</h1>
        <p>Định nghĩa loại phòng, sức chứa, đơn giá niêm yết và trạng thái kinh doanh.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-controller="TaiKhoan" asp-action="Index" style="text-decoration:none;">← Tài khoản</a>
        <a class="admin-primary" asp-action="Create" style="text-decoration:none;">
            <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            Thêm loại phòng
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding:12px 16px;background:#eef6f2;border-left:4px solid #46785e;color:#2e5340;margin-bottom:20px;font-size: 13px;border-radius:2px;">
        ✓ @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size: 13px;border-radius:2px;">
        ⚠️ @TempData["ErrorMessage"]
    </div>
}

<article class="dashboard-card data-card">
    <form method="get" asp-action="Index">
        <div class="table-toolbar" style="flex-wrap:wrap;gap:12px;">
            <div class="admin-search" style="min-width:260px;">
                <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Tên loại phòng..." />
            </div>

            <select name="statusFilter">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true" selected="@(Model.StatusFilter == true)">Đang kinh doanh</option>
                <option value="false" selected="@(Model.StatusFilter == false)">Ngừng kinh doanh</option>
            </select>

            <select name="sortOrder">
                <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên A → Z</option>
                <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Đơn giá tăng dần</option>
                <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Đơn giá giảm dần</option>
                <option value="capacity_desc" selected="@(Model.SortOrder == "capacity_desc")">Sức chứa giảm dần</option>
            </select>

            <button type="submit" class="admin-primary" style="min-height:42px;padding:0 20px;">Lọc</button>
            <a asp-action="Index" class="admin-secondary" style="min-height:42px;padding:0 16px;text-decoration:none;">Xóa lọc</a>
        </div>
    </form>

    <div class="table-result-row">
        <span>Hiển thị danh sách loại phòng hệ thống</span>
        <strong>Tổng số: @Model.TotalItems loại phòng (Trang @Model.PageIndex / @Model.TotalPages)</strong>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên loại phòng</th>
                        <th>Số người tối đa</th>
                        <th>Đơn giá / ngày</th>
                        <th>Số phòng</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><strong>#@item.MaLoaiPhong</strong></td>
                            <td><strong style="color:var(--navy-900);">@item.TenLoai</strong></td>
                            <td>@item.SoNguoiToiDa người</td>
                            <td><strong style="color:#b28c49;">@item.DonGiaNgay.ToString("N0")₫</strong></td>
                            <td>@(item.Phongs?.Count ?? 0) phòng</td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="status-badge status-badge--success"><i></i>Đang kinh doanh</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--warning"><i></i>Ngừng kinh doanh</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div class="table-actions">
                                    <a class="admin-secondary" asp-action="Details" asp-route-id="@item.MaLoaiPhong">Chi tiết</a>
                                    <a class="admin-primary" asp-action="Edit" asp-route-id="@item.MaLoaiPhong">Sửa</a>
                                    <a class="admin-secondary" style="color:#c0392b;border-color:#f5c6cb;" asp-action="Delete" asp-route-id="@item.MaLoaiPhong">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-sortOrder="@Model.SortOrder" style="text-decoration:none;">
                        <button type="button" class="@(p == Model.PageIndex ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Không tìm thấy loại phòng</strong>
            <span>Vui lòng kiểm tra lại điều kiện lọc hoặc từ khóa tìm kiếm.</span>
        </div>
    }
</article>

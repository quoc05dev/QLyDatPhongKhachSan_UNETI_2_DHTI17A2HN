@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Quản lý Dữ liệu nền - Loại phòng cho Admin (Tìm kiếm, Lọc, Phân trang LINQ).
*@
@model IEnumerable<QLyDatPhongKhachSan.Models.LoaiPhong>

@{
    ViewData["Title"] = "Quản lý Loại phòng";
    int pageIndex = ViewBag.PageIndex ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string searchTerm = ViewBag.SearchTerm ?? "";
    bool? statusFilter = ViewBag.StatusFilter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-grid-3x3-gap-fill me-2"></i>QUẢN LÝ LOẠI PHÒNG (DỮ LIỆU NỀN)</h2>
        <p class="text-muted mb-0">Xem danh sách, tìm kiếm, lọc, thêm mới và quản lý trạng thái các hạng phòng</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Thêm Loại Phòng Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Khối Tìm kiếm & Bộ Lọc Dữ liệu nền -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-secondary fw-semibold">Tìm kiếm loại phòng</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tên loại phòng, mô tả..." value="@searchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-secondary fw-semibold">Trạng thái</label>
                <select name="statusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(statusFilter == true)">Hoạt động</option>
                    <option value="false" selected="@(statusFilter == false)">Khóa / Tạm dừng</option>
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="bi bi-filter me-1"></i>Lọc Dữ Liệu
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng Danh Sách Loại Phòng -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4"># Mã</th>
                        <th>Tên Loại Phòng</th>
                        <th>Sức Chứa Tối Đa</th>
                        <th>Đơn Giá / Ngày</th>
                        <th>Mô Tả Chi Tiết</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu loại phòng phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.MaLoaiPhong</td>
                                <td class="fw-bold text-primary">@item.TenLoai</td>
                                <td><span class="badge bg-light text-dark border px-3 py-1"><i class="bi bi-people me-1"></i>@item.SoNguoiToiDa Người</span></td>
                                <td class="fw-bold text-success">@item.DonGiaNgay.ToString("N0") VNĐ</td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(item.MoTa) ? "-" : item.MoTa)</small></td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.MaLoaiPhong" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaLoaiPhong" class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.MaLoaiPhong" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(item.TrangThai ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(item.TrangThai ? "Khóa loại phòng" : "Mở khóa loại phòng")">
                                                <i class="bi @(item.TrangThai ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@item.MaLoaiPhong" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <small class="text-muted">
                    Hiển thị <strong>@(Model?.Count() ?? 0)</strong> / tổng số <strong>@totalItems</strong> loại phòng (Trang @pageIndex / @totalPages)
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex - 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">&laquo; Trước</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == pageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">@i</a>
                            </li>
                        }
                        <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex + 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Sửa Loại phòng cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.LoaiPhong

@{
    ViewData["Title"] = "Sửa loại phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Cập nhật loại phòng</span>
        <h1>Sửa loại phòng: @Model.TenLoai</h1>
        <p>Cập nhật tên loại phòng, sức chứa, đơn giá niêm yết hoặc trạng thái kinh doanh.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size: 13px;"></div>
        <input type="hidden" asp-for="MaLoaiPhong" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="grid-column: span 2;display:flex;flex-direction:column;gap:6px;">
                <label asp-for="TenLoai" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Tên loại phòng <span style="color:red;">*</span></label>
                <input asp-for="TenLoai" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="TenLoai" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="SoNguoiToiDa" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Số người tối đa <span style="color:red;">*</span></label>
                <input asp-for="SoNguoiToiDa" type="number" min="1" max="20" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="SoNguoiToiDa" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="DonGiaNgay" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Đơn giá theo ngày (VNĐ) <span style="color:red;">*</span></label>
                <input asp-for="DonGiaNgay" type="number" min="0" step="1000" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="DonGiaNgay" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="grid-column: span 2;display:flex;flex-direction:column;gap:6px;">
                <label asp-for="MoTa" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Mô tả</label>
                <textarea asp-for="MoTa" rows="3" style="padding:10px 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;font-family:inherit;"></textarea>
                <span asp-validation-for="MoTa" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="grid-column: span 2;display:flex;flex-direction:column;gap:6px;">
                <label asp-for="HinhAnh" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Hình ảnh đại diện</label>
                <input asp-for="HinhAnh" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="HinhAnh" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="grid-column: span 2;margin-top:6px;">
                <label style="display:flex;align-items:center;gap:10px;font-size: 13px;color:var(--navy-900);cursor:pointer;">
                    <input type="checkbox" asp-for="TrangThai" style="accent-color:var(--gold-500);width:16px;height:16px;" />
                    <strong>Đang kinh doanh (hoạt động)</strong>
                </label>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu thay đổi</button>
            <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

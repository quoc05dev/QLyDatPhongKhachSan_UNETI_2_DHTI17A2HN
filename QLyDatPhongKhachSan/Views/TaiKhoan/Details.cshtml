@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Chi tiết TaiKhoan dành cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.TaiKhoan

@{
    ViewData["Title"] = "Chi tiết tài khoản";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Hồ sơ tài khoản</span>
        <h1>Chi tiết: @Model.TenDangNhap</h1>
        <p>Chi tiết thông tin đăng nhập, vai trò hệ thống và liên kết thông tin khách hàng.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
        <a class="admin-primary" asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" style="text-decoration:none;">Sửa thông tin</a>
    </div>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <div style="display:flex;align-items:center;gap:16px;padding-bottom:20px;border-bottom:1px solid #edf0f2;margin-bottom:20px;">
        <div style="width:54px;height:54px;border-radius:50%;background:var(--navy-900);color:var(--gold-400);display:grid;place-items:center;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;">
            @(string.IsNullOrWhiteSpace(Model.HoTen) ? Model.TenDangNhap.Substring(0, 1).ToUpperInvariant() : Model.HoTen.Trim().Substring(0, 1).ToUpperInvariant())
        </div>
        <div>
            <strong style="font-size:18px;color:var(--navy-950);display:block;">@(string.IsNullOrWhiteSpace(Model.HoTen) ? Model.TenDangNhap : Model.HoTen)</strong>
            <span style="font-size: 13px;color:#5d666f;">Mã tài khoản: #@Model.MaTaiKhoan · Vai trò: <b style="color:#b28c49;">@Model.VaiTro</b></span>
        </div>
        <div style="margin-left:auto;">
            @if (Model.TrangThai)
            {
                <span class="status-badge status-badge--success"><i></i>Hoạt động</span>
            }
            else
            {
                <span class="status-badge status-badge--warning"><i></i>Đã bị khóa</span>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Tên đăng nhập</small>
            <strong style="font-size:14px;color:var(--navy-950);">@Model.TenDangNhap</strong>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Họ và tên</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.HoTen) ? "—" : Model.HoTen)</span>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Email liên hệ</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</span>
        </div>

        <div>
            <small style="color:#6b7480;font-size: 10px;text-transform:uppercase;font-weight:600;display:block;">Số điện thoại</small>
            <span style="font-size:14px;color:#334155;">@(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "—" : Model.SoDienThoai)</span>
        </div>
    </div>

    @if (Model.KhachHang != null)
    {
        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;">
            <strong style="font-size:13px;color:var(--navy-900);display:block;margin-bottom:12px;">Thông tin Hồ sơ Khách hàng liên kết</strong>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size: 13px;background:#f8fafc;padding:14px;border-radius:4px;">
                <div><span>Mã khách hàng:</span> <strong>#@Model.KhachHang.MaKhachHang</strong></div>
                <div><span>CCCD / Passport:</span> <strong>@(Model.KhachHang.CCCD ?? "—")</strong></div>
                <div><span>Địa chỉ:</span> <strong>@(Model.KhachHang.DiaChi ?? "—")</strong></div>
                <div><span>Quốc tịch:</span> <strong>@(Model.KhachHang.QuocTich ?? "Việt Nam")</strong></div>
            </div>
        </div>
    }
</article>

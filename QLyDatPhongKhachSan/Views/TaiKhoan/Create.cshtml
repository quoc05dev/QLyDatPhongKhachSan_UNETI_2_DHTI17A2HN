@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Thêm mới TaiKhoan dành cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.TaiKhoan

@{
    ViewData["Title"] = "Thêm mới tài khoản";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 1 · Khởi tạo tài khoản</span>
        <h1>Thêm mới tài khoản hệ thống</h1>
        <p>Khai báo thông tin tài khoản, phân quyền vai trò và khởi tạo trạng thái.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size:12px;"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="TenDangNhap" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Tên đăng nhập <span style="color:red;">*</span></label>
                <input asp-for="TenDangNhap" placeholder="Nhập tên đăng nhập..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;" />
                <span asp-validation-for="TenDangNhap" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="MatKhau" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Mật khẩu <span style="color:red;">*</span></label>
                <input asp-for="MatKhau" type="password" placeholder="Nhập mật khẩu..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;" />
                <span asp-validation-for="MatKhau" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="HoTen" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Họ và tên</label>
                <input asp-for="HoTen" placeholder="Nhập họ và tên đầy đủ..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;" />
                <span asp-validation-for="HoTen" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="Email" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Email</label>
                <input asp-for="Email" type="email" placeholder="example@gmail.com" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;" />
                <span asp-validation-for="Email" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="SoDienThoai" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Số điện thoại</label>
                <input asp-for="SoDienThoai" placeholder="09xxxxxxxx" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;" />
                <span asp-validation-for="SoDienThoai" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="VaiTro" style="font-size:10px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Vai trò hệ thống <span style="color:red;">*</span></label>
                <select asp-for="VaiTro" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:12px;">
                    <option value="Admin">Admin (Quản trị hệ thống)</option>
                    <option value="NhanVien">NhanVien (Lễ tân / Vận hành)</option>
                    <option value="KhachHang" selected>KhachHang (Khách đặt phòng)</option>
                </select>
                <span asp-validation-for="VaiTro" style="color:#c0392b;font-size:11px;"></span>
            </div>

            <div style="grid-column: span 2; margin-top:6px;">
                <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--navy-900);cursor:pointer;">
                    <input type="checkbox" asp-for="TrangThai" checked style="accent-color:var(--gold-500);width:16px;height:16px;" />
                    <strong>Kích hoạt tài khoản (Cho phép đăng nhập ngay)</strong>
                </label>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu tài khoản</button>
            <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Sửa thông tin TaiKhoan cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Cập nhật tài khoản</span>
        <h1>Sửa tài khoản: @Model.TenDangNhap</h1>
        <p>Cập nhật vai trò, họ tên, email, số điện thoại hoặc trạng thái khóa/mở khóa.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size: 13px;"></div>
        <input type="hidden" asp-for="MaTaiKhoan" />
        <input type="hidden" asp-for="TenDangNhap" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Tên đăng nhập</label>
                <input value="@Model.TenDangNhap" disabled style="min-height:42px;padding:0 12px;background:#f5f7f9;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;color:#5d666f;" />
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="VaiTro" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Vai trò hệ thống <span style="color:red;">*</span></label>
                <select asp-for="VaiTro" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;">
                    <option value="Admin">Admin (Quản trị hệ thống)</option>
                    <option value="NhanVien">NhanVien (Lễ tân / Vận hành)</option>
                    <option value="KhachHang">KhachHang (Khách đặt phòng)</option>
                </select>
                <span asp-validation-for="VaiTro" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="HoTen" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Họ và tên</label>
                <input asp-for="HoTen" placeholder="Nhập họ và tên..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="HoTen" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="Email" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Email</label>
                <input asp-for="Email" type="email" placeholder="example@gmail.com" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="Email" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="SoDienThoai" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Số điện thoại</label>
                <input asp-for="SoDienThoai" placeholder="09xxxxxxxx" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="SoDienThoai" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label for="MatKhauMoi" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Mật khẩu mới (để trống nếu không đổi)</label>
                <input type="password" id="MatKhauMoi" name="MatKhauMoi" minlength="6" maxlength="128" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                @Html.ValidationMessage("MatKhauMoi", new { style = "color:#c0392b;font-size: 12px;" })
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;justify-content:center;">
                <label style="display:flex;align-items:center;gap:10px;font-size: 13px;color:var(--navy-900);cursor:pointer;margin-top:16px;">
                    <input type="checkbox" asp-for="TrangThai" style="accent-color:var(--gold-500);width:16px;height:16px;" />
                    <strong>Trạng thái tài khoản (Hoạt động)</strong>
                </label>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu thay đổi</button>
            <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Quản lý danh sách Tài khoản cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.ViewModels.TaiKhoanListViewModel

@{
    ViewData["Title"] = "Quản lý Tài khoản";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 1 · Quản trị hệ thống</span>
        <h1>Quản lý tài khoản người dùng</h1>
        <p>Phân quyền truy cập, quản lý trạng thái tài khoản Admin, Lễ tân và Khách hàng.</p>
    </div>
    <a class="admin-primary" asp-action="Create" style="text-decoration:none;">
        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
        Thêm tài khoản mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding:12px 16px;background:#eef6f2;border-left:4px solid #46785e;color:#2e5340;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ✓ @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚠️ @TempData["ErrorMessage"]
    </div>
}

<article class="dashboard-card data-card">
    <form method="get" asp-action="Index">
        <div class="table-toolbar" style="flex-wrap:wrap;gap:12px;">
            <div class="admin-search" style="min-width:260px;">
                <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Tên đăng nhập, họ tên, email..." />
            </div>

            <select name="roleFilter">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin (Quản trị)</option>
                <option value="NhanVien" selected="@(Model.RoleFilter == "NhanVien")">Nhân viên Lễ tân</option>
                <option value="KhachHang" selected="@(Model.RoleFilter == "KhachHang")">Khách hàng</option>
            </select>

            <select name="statusFilter">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true" selected="@(Model.StatusFilter == true)">Hoạt động</option>
                <option value="false" selected="@(Model.StatusFilter == false)">Bị khóa</option>
            </select>

            <button type="submit" class="admin-primary" style="min-height:42px;padding:0 20px;">Lọc</button>
            <a asp-action="Index" class="admin-secondary" style="min-height:42px;padding:0 16px;text-decoration:none;">Xóa lọc</a>
        </div>
    </form>

    <div class="table-result-row">
        <span>Hiển thị danh sách tài khoản hệ thống</span>
        <strong>Tổng số: @Model.TotalItems tài khoản (Trang @Model.PageIndex / @Model.TotalPages)</strong>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã TK</th>
                        <th>Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var roleBadge = item.VaiTro switch
                        {
                            "Admin" => "background:#fbf4e8;color:#a17732;",
                            "NhanVien" => "background:#edf4fa;color:#416d96;",
                            _ => "background:#eff1f3;color:#737d87;"
                        };

                        <tr>
                            <td><strong>#@item.MaTaiKhoan</strong></td>
                            <td><strong style="color:var(--navy-900);">@item.TenDangNhap</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(item.HoTen) ? "—" : item.HoTen)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</td>
                            <td>
                                <span style="display:inline-block;padding:3px 8px;border-radius:4px;font-size:9px;font-weight:700;@roleBadge">
                                    @item.VaiTro
                                </span>
                            </td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="status-badge status-badge--success"><i></i>Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--warning"><i></i>Đã bị khóa</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:6px;">
                                    <a class="admin-secondary" style="min-height:30px;padding:0 8px;font-size:9px;text-decoration:none;" asp-action="Details" asp-route-id="@item.MaTaiKhoan">Chi tiết</a>
                                    <a class="admin-primary" style="min-height:30px;padding:0 8px;font-size:9px;text-decoration:none;" asp-action="Edit" asp-route-id="@item.MaTaiKhoan">Sửa</a>
                                    <form asp-action="ToggleLock" asp-route-id="@item.MaTaiKhoan" method="post" style="display:inline;">
                                        @if (item.TrangThai)
                                        {
                                            <button type="submit" class="admin-secondary" style="min-height:30px;padding:0 8px;font-size:9px;color:#c0392b;border-color:#f5c6cb;" title="Khóa tài khoản">Khóa</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-secondary" style="min-height:30px;padding:0 8px;font-size:9px;color:#27ae60;border-color:#abebc6;" title="Mở khóa tài khoản">Mở khóa</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter" asp-route-statusFilter="@Model.StatusFilter" style="text-decoration:none;">
                        <button type="button" class="@(p == Model.PageIndex ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Không tìm thấy tài khoản</strong>
            <span>Vui lòng kiểm tra lại điều kiện lọc hoặc từ khóa tìm kiếm.</span>
        </div>
    }
</article>

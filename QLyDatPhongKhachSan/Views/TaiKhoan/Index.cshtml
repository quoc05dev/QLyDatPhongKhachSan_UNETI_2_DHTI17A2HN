@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Quản lý danh sách Tài khoản cho Admin (Tìm kiếm, Lọc, Khóa/Mở khóa, Phân trang LINQ).
*@
@model QLyDatPhongKhachSan.ViewModels.TaiKhoanListViewModel

@{
    ViewData["Title"] = "Quản lý Tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-people-fill me-2"></i>QUẢN LÝ TÀI KHOẢN</h2>
        <p class="text-muted mb-0">Xem danh sách, tìm kiếm, lọc, phân quyền và quản lý trạng thái tài khoản</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-person-plus me-1"></i>Thêm Tài Khoản Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Khối Tìm kiếm & Bộ Lọc -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <label class="form-label small text-muted fw-semibold">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tên đăng nhập, họ tên, email..." value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold">Vai trò</label>
                <select name="roleFilter" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="NhanVien" selected="@(Model.RoleFilter == "NhanVien")">Nhân viên quản lý</option>
                    <option value="KhachHang" selected="@(Model.RoleFilter == "KhachHang")">Khách hàng</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted fw-semibold">Trạng thái</label>
                <select name="statusFilter" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="true" selected="@(Model.StatusFilter == true)">Hoạt động</option>
                    <option value="false" selected="@(Model.StatusFilter == false)">Bị khóa</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-secondary w-100 rounded-3">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng Danh Sách Tài Khoản -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4"># Mã</th>
                        <th>Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy tài khoản phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.MaTaiKhoan</td>
                                <td class="fw-bold text-primary">@item.TenDangNhap</td>
                                <td>@item.HoTen</td>
                                <td>@item.Email</td>
                                <td>@(string.IsNullOrEmpty(item.SoDienThoai) ? "-" : item.SoDienThoai)</td>
                                <td>
                                    @if (item.VaiTro == "Admin")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-shield-lock me-1"></i>Admin</span>
                                    }
                                    else if (item.VaiTro == "NhanVien")
                                    {
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-person-badge me-1"></i>Nhân viên</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-person me-1"></i>Khách hàng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>Bị khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Form Khóa/Mở khóa -->
                                        <form asp-action="ToggleStatus" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(item.TrangThai ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(item.TrangThai ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="bi @(item.TrangThai ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân Trang (Pagination) -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <small class="text-muted">
                    Hiển thị <strong>@(Model.Items?.Count ?? 0)</strong> / tổng số <strong>@Model.TotalItems</strong> tài khoản (Trang @Model.PageIndex / @Model.TotalPages)
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageIndex - 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-roleFilter="@Model.RoleFilter"
                               asp-route-statusFilter="@Model.StatusFilter">
                                &laquo; Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-roleFilter="@Model.RoleFilter"
                                   asp-route-statusFilter="@Model.StatusFilter">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageIndex + 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-roleFilter="@Model.RoleFilter"
                               asp-route-statusFilter="@Model.StatusFilter">
                                Sau &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

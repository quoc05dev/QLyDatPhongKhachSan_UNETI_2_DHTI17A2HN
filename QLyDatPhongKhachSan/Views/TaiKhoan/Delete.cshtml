@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Xóa TaiKhoan dành cho Admin (Module 1 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.TaiKhoan

@{
    ViewData["Title"] = "Xóa tài khoản";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "accounts";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 1 · Thao tác xóa tài khoản</span>
        <h1>Xóa tài khoản: @Model.TenDangNhap</h1>
        <p>Xác nhận thao tác xóa hoặc khóa dữ liệu người dùng khỏi hệ thống.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 650px;">
    <div style="padding:14px 18px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;line-height:1.6;">
        <strong style="display:block;margin-bottom:4px;font-size:13px;">🚨 Báo xác nhận xóa:</strong>
        Bạn có chắc chắn muốn xóa tài khoản <strong>@Model.TenDangNhap</strong> (#@Model.MaTaiKhoan) không? Thao tác này có thể ảnh hưởng đến lịch sử giao dịch liên quan.
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:20px 0;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2;">
        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tên đăng nhập</small>
            <strong style="font-size:15px;color:var(--navy-950);">@Model.TenDangNhap</strong>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Vai trò</small>
            <span style="font-size:14px;color:#b28c49;font-weight:600;">@Model.VaiTro</span>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Họ và tên</small>
            <span style="font-size:13px;">@(string.IsNullOrWhiteSpace(Model.HoTen) ? "—" : Model.HoTen)</span>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Email</small>
            <span style="font-size:13px;">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</span>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.MaTaiKhoan" method="post" style="margin-top:24px;display:flex;gap:12px;">
        <input type="hidden" asp-for="MaTaiKhoan" />
        <button type="submit" class="admin-primary" style="background:#e74c3c;color:#fff;">Xác nhận xóa tài khoản</button>
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ &amp; Quay lại</a>
    </form>
</article>

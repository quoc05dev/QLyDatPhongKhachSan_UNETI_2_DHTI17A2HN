@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Xác nhận xóa / khóa Khách hàng (Restyle UI - bảo toàn dữ liệu)
// ==========================================
*@

@model QLyDatPhongKhachSan.Models.KhachHang

@{
    ViewData["Title"] = $"Xóa khách hàng #{Model.MaKhachHang:D4}";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
    bool daCoDonDatPhong = Model.DatPhongs != null && Model.DatPhongs.Any();
    int soDonDatPhong = Model.DatPhongs?.Count ?? 0;
    string rowLabel = "display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #edf0f2;font-size: 13px;";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Xác nhận #@Model.MaKhachHang.ToString("D4")</span>
        <h1>@(daCoDonDatPhong ? "Xác nhận khóa khách hàng" : "Xác nhận xóa khách hàng")</h1>
        <p>Vui lòng kiểm tra kỹ thông tin trước khi thực hiện thao tác không thể hoàn tác.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Danh sách</a>
</div>

<article class="dashboard-card" style="padding:28px;max-width:720px;">
    @if (daCoDonDatPhong)
    {
        <div style="padding:16px 18px;border-left:3px solid #c9a35d;background:#fbf7ef;color:#6b5a36;font-size:12.5px;line-height:1.6;margin-bottom:22px;">
            <strong style="display:block;margin-bottom:4px;color:#8a6a2f;">Bảo vệ toàn vẹn dữ liệu giao dịch</strong>
            Khách hàng <strong>@Model.HoTen</strong> đã phát sinh <strong>@soDonDatPhong đơn đặt phòng</strong>.
            Theo quy định bảo toàn dữ liệu, hệ thống sẽ <strong>khóa / vô hiệu hóa</strong> hồ sơ thay vì xóa cứng để bảo tồn lịch sử giao dịch.
        </div>
    }
    else
    {
        <div style="padding:16px 18px;border-left:3px solid #c0392b;background:#fdecea;color:#a93226;font-size:12.5px;line-height:1.6;margin-bottom:22px;">
            <strong style="display:block;margin-bottom:4px;">Cảnh báo thao tác xóa</strong>
            Bạn có chắc chắn muốn xóa vĩnh viễn khách hàng <strong>@Model.HoTen</strong> (#@Model.MaKhachHang.ToString("D4"))? Hành động này không thể hoàn tác.
        </div>
    }

    <div style="border:1px solid #edf0f2;padding:6px 18px;">
        <div style="@rowLabel"><span style="color:#5d666f;">Mã khách hàng</span><span style="color:#172433;font-weight:600;">#@Model.MaKhachHang.ToString("D4")</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Họ và tên</span><span style="color:#172433;font-weight:600;">@Model.HoTen</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Số CCCD</span><span style="color:#172433;font-weight:600;">@Model.CCCD</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Số điện thoại</span><span style="color:#172433;font-weight:600;">@Model.SoDienThoai</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Email</span><span style="color:#172433;font-weight:600;">@(string.IsNullOrEmpty(Model.Email) ? "Chưa có" : Model.Email)</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Quốc tịch</span><span style="color:#172433;font-weight:600;">@(string.IsNullOrEmpty(Model.QuocTich) ? "Việt Nam" : Model.QuocTich)</span></div>
        <div style="@rowLabel"><span style="color:#5d666f;">Trạng thái hiện tại</span><span style="color:#172433;font-weight:600;">@(Model.TrangThai ? "Đang hoạt động" : "Bị khóa")</span></div>
        <div style="@rowLabel;border-bottom:0;"><span style="color:#5d666f;">Số đơn đặt phòng</span><span style="color:#172433;font-weight:600;">@soDonDatPhong đơn</span></div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaKhachHang" />
        <button type="submit" class="admin-primary" style="background:@(daCoDonDatPhong ? "#b28c49" : "#c0392b");border-color:@(daCoDonDatPhong ? "#b28c49" : "#c0392b");">
            @(daCoDonDatPhong ? "Xác nhận khóa tài khoản" : "Xác nhận xóa khách hàng")
        </button>
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
    </form>
</article>

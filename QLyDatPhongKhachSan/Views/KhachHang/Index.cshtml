@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Danh sách Khách hàng (Restyle UI: CRUD, Tìm kiếm, Lọc, Phân trang LINQ)
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.KhachHangListViewModel

@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Khách hàng</span>
        <h1>Quản lý khách hàng</h1>
        <p>Theo dõi hồ sơ khách hàng, tiếp nhận khách vãng lai, liên kết tài khoản và lịch sử giao dịch.</p>
    </div>
    <a class="admin-primary" asp-action="Create">
        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
        Thêm khách hàng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #4f8068;background:#eef6f2;color:#37614b;font-size: 13px;">
        ✓ @TempData["SuccessMessage"]
    </p>
}

@if (TempData["ErrorMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #c0392b;background:#fdecea;color:#a93226;font-size: 13px;">
        ⚠ @TempData["ErrorMessage"]
    </p>
}

<div class="stat-grid">
    <article class="stat-card stat-card--navy">
        <div class="stat-top"><span>Tổng khách hàng</span></div>
        <b>@Model.TongKhachHang</b>
        <small>Toàn bộ hồ sơ trong hệ thống</small>
    </article>
    <article class="stat-card stat-card--green">
        <div class="stat-top"><span>Đang hoạt động</span></div>
        <b>@Model.SoKhachHoatDong</b>
        <small>Hồ sơ được phép giao dịch</small>
    </article>
    <article class="stat-card stat-card--gold">
        <div class="stat-top"><span>Bị khóa</span></div>
        <b>@Model.SoKhachBiKhoa</b>
        <small>Tạm dừng / vô hiệu hóa</small>
    </article>
    <article class="stat-card stat-card--blue">
        <div class="stat-top"><span>Có tài khoản online</span></div>
        <b>@Model.SoKhachCoTaiKhoan</b>
        <small>Liên kết tài khoản khách hàng</small>
    </article>
    <article class="stat-card stat-card--navy">
        <div class="stat-top"><span>Khách vãng lai</span></div>
        <b>@Model.SoKhachVangLai</b>
        <small>Đặt phòng trực tiếp tại quầy</small>
    </article>
</div>

<article class="dashboard-card data-card">
    <form method="get" asp-action="Index">
        <input type="hidden" name="page" value="1" />
        <div class="table-toolbar" style="flex-wrap:wrap;gap:12px;">
            <div class="admin-search" style="min-width:260px;">
                <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Họ tên, CCCD, SĐT, Email, địa chỉ..." />
            </div>

            <select name="gioiTinhFilter">
                <option value="">-- Giới tính --</option>
                <option value="Nam" selected="@(Model.GioiTinhFilter == "Nam" ? "selected" : null)">Nam</option>
                <option value="Nữ" selected="@(Model.GioiTinhFilter == "Nữ" ? "selected" : null)">Nữ</option>
                <option value="Khác" selected="@(Model.GioiTinhFilter == "Khác" ? "selected" : null)">Khác</option>
            </select>

            <select name="statusFilter">
                <option value="">-- Trạng thái --</option>
                <option value="true" selected="@(Model.StatusFilter == true ? "selected" : null)">Hoạt động</option>
                <option value="false" selected="@(Model.StatusFilter == false ? "selected" : null)">Bị khóa</option>
            </select>

            <select name="coTaiKhoanFilter">
                <option value="">-- Loại khách --</option>
                <option value="co" selected="@(Model.CoTaiKhoanFilter == "co" ? "selected" : null)">Có tài khoản</option>
                <option value="khong" selected="@(Model.CoTaiKhoanFilter == "khong" ? "selected" : null)">Khách vãng lai</option>
            </select>

            <select name="sortOrder">
                <option value="id_desc" selected="@(Model.SortOrder == "id_desc" ? "selected" : null)">Mã KH: Mới nhất</option>
                <option value="id_asc" selected="@(Model.SortOrder == "id_asc" ? "selected" : null)">Mã KH: Cũ nhất</option>
                <option value="name_asc" selected="@(Model.SortOrder == "name_asc" ? "selected" : null)">Tên khách hàng: A-Z</option>
                <option value="name_desc" selected="@(Model.SortOrder == "name_desc" ? "selected" : null)">Tên khách hàng: Z-A</option>
            </select>

            <button type="submit" class="admin-primary" style="min-height:42px;padding:0 20px;">Lọc</button>
            <a asp-action="Index" class="admin-secondary" style="min-height:42px;padding:0 16px;text-decoration:none;">Xóa lọc</a>
        </div>
    </form>

    <div class="table-result-row">
        <span>Hiển thị @Model.Items.Count / @Model.TotalItems khách hàng phù hợp</span>
        <strong>Trang @Model.PageIndex / @Model.TotalPages</strong>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách hàng</th>
                        <th>CCCD / Hộ chiếu</th>
                        <th>Liên hệ</th>
                        <th>Quốc tịch</th>
                        <th>Loại khách</th>
                        <th>Lịch sử đặt</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model.Items)
                    {
                        var avatarLetter = !string.IsNullOrWhiteSpace(kh.HoTen) ? kh.HoTen.Trim().Substring(0, 1).ToUpper() : "K";
                        var bookingCount = kh.DatPhongs?.Count ?? 0;

                        <tr>
                            <td><strong>#@kh.MaKhachHang.ToString("D4")</strong></td>
                            <td>
                                <strong>@kh.HoTen</strong>
                                <small>
                                    @(kh.GioiTinh ?? "Chưa rõ")@(kh.NgaySinh.HasValue ? $" · {kh.NgaySinh.Value:dd/MM/yyyy}" : "")
                                </small>
                            </td>
                            <td>@kh.CCCD</td>
                            <td>
                                <span>@kh.SoDienThoai</span>
                                @if (!string.IsNullOrWhiteSpace(kh.Email))
                                {
                                    <small>@kh.Email</small>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(kh.QuocTich) ? "Việt Nam" : kh.QuocTich)</td>
                            <td>
                                @if (kh.TaiKhoan != null)
                                {
                                    <span class="status-badge status-badge--info"><i></i>Có TK</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--muted"><i></i>Vãng lai</span>
                                }
                            </td>
                            <td>@bookingCount đơn</td>
                            <td>
                                @if (kh.TrangThai)
                                {
                                    <span class="status-badge status-badge--success"><i></i>Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--muted"><i></i>Bị khóa</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:8px;">
                                    <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;text-decoration:none;" asp-action="Details" asp-route-id="@kh.MaKhachHang">Chi tiết</a>
                                    <a class="admin-primary" style="min-height:32px;padding:0 10px;font-size: 11px;text-decoration:none;" asp-action="Edit" asp-route-id="@kh.MaKhachHang">Sửa</a>
                                    <form asp-action="ToggleStatus" asp-route-id="@kh.MaKhachHang" method="post" style="display:inline;">
                                        <button type="submit" class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;"
                                                title="@(kh.TrangThai ? "Khóa khách hàng" : "Mở khóa khách hàng")"
                                                onclick="return confirm('Bạn có chắc muốn @(kh.TrangThai ? "khóa" : "mở khóa") khách hàng @kh.HoTen?');">
                                            @(kh.TrangThai ? "Khóa" : "Mở")
                                        </button>
                                    </form>
                                    <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;color:#c0392b;border-color:#f5c6cb;text-decoration:none;" asp-action="Delete" asp-route-id="@kh.MaKhachHang">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index"
                       asp-route-page="@p"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-gioiTinhFilter="@Model.GioiTinhFilter"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-coTaiKhoanFilter="@Model.CoTaiKhoanFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       style="text-decoration:none;">
                        <button type="button" class="@(p == Model.PageIndex ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Không tìm thấy khách hàng phù hợp</strong>
            <span>Vui lòng thử thay đổi từ khóa hoặc điều kiện lọc.</span>
        </div>
    }
</article>

@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Chỉnh sửa Khách hàng (Restyle UI - Admin & Lễ tân)
// ==========================================
*@

@model QLyDatPhongKhachSan.Models.KhachHang

@{
    ViewData["Title"] = $"Chỉnh sửa khách hàng #{Model.MaKhachHang:D4}";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
    var taiKhoans = ViewBag.TaiKhoans as List<QLyDatPhongKhachSan.Models.TaiKhoan> ?? new List<QLyDatPhongKhachSan.Models.TaiKhoan>();
    var labelStyle = "font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;";
    var inputStyle = "min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;";
    var errorStyle = "color:#c0392b;font-size: 12px;";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Chỉnh sửa khách hàng #@Model.MaKhachHang.ToString("D4")</span>
        <h1>Chỉnh sửa hồ sơ khách hàng</h1>
        <p>Cập nhật thông tin cá nhân, liên hệ, liên kết tài khoản và trạng thái hoạt động.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-action="Details" asp-route-id="@Model.MaKhachHang" style="text-decoration:none;">Chi tiết</a>
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Danh sách</a>
    </div>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 900px;">
    <form asp-action="Edit" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaKhachHang" />
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size: 13px;"></div>

        <div style="font-size: 12px;font-weight:700;color:var(--navy-900);letter-spacing:0.06em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #edf0f2;margin-bottom:18px;">1. Thông tin cá nhân</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="HoTen" style="@labelStyle">Họ và tên <span style="color:red;">*</span></label>
                <input asp-for="HoTen" placeholder="VD: Nguyễn Văn A" style="@inputStyle" />
                <span asp-validation-for="HoTen" style="@errorStyle"></span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="GioiTinh" style="@labelStyle">Giới tính</label>
                <select asp-for="GioiTinh" style="@inputStyle">
                    <option value="Nam" selected="@(Model.GioiTinh == "Nam")">Nam</option>
                    <option value="Nữ" selected="@(Model.GioiTinh == "Nữ")">Nữ</option>
                    <option value="Khác" selected="@(Model.GioiTinh == "Khác")">Khác</option>
                </select>
                <span asp-validation-for="GioiTinh" style="@errorStyle"></span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="NgaySinh" style="@labelStyle">Ngày sinh</label>
                <input asp-for="NgaySinh" type="date" style="@inputStyle" />
                <span asp-validation-for="NgaySinh" style="@errorStyle"></span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="CCCD" style="@labelStyle">CCCD / Hộ chiếu <span style="color:red;">*</span></label>
                <input asp-for="CCCD" placeholder="12 số CCCD hoặc số hộ chiếu" style="@inputStyle" />
                <span asp-validation-for="CCCD" style="@errorStyle"></span>
            </div>
        </div>

        <div style="font-size: 12px;font-weight:700;color:var(--navy-900);letter-spacing:0.06em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #edf0f2;margin-bottom:18px;">2. Thông tin liên hệ</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="SoDienThoai" style="@labelStyle">Số điện thoại <span style="color:red;">*</span></label>
                <input asp-for="SoDienThoai" placeholder="VD: 0912345678" style="@inputStyle" />
                <span asp-validation-for="SoDienThoai" style="@errorStyle"></span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="Email" style="@labelStyle">Email</label>
                <input asp-for="Email" type="email" placeholder="VD: khachhang@gmail.com" style="@inputStyle" />
                <span asp-validation-for="Email" style="@errorStyle"></span>
            </div>
            <div style="grid-column: span 2;display:flex;flex-direction:column;gap:6px;">
                <label asp-for="DiaChi" style="@labelStyle">Địa chỉ thường trú / tạm trú</label>
                <input asp-for="DiaChi" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" style="@inputStyle" />
                <span asp-validation-for="DiaChi" style="@errorStyle"></span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="QuocTich" style="@labelStyle">Quốc tịch</label>
                <input asp-for="QuocTich" style="@inputStyle" />
                <span asp-validation-for="QuocTich" style="@errorStyle"></span>
            </div>
        </div>

        <div style="font-size: 12px;font-weight:700;color:var(--navy-900);letter-spacing:0.06em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid #edf0f2;margin-bottom:18px;">3. Cấu hình hệ thống &amp; ghi chú</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="MaTaiKhoan" style="@labelStyle">Liên kết tài khoản trực tuyến</label>
                <select asp-for="MaTaiKhoan" style="@inputStyle">
                    <option value="">-- Không liên kết (khách vãng lai) --</option>
                    @foreach (var tk in taiKhoans)
                    {
                        <option value="@tk.MaTaiKhoan" selected="@(Model.MaTaiKhoan == tk.MaTaiKhoan ? "selected" : null)">@tk.TenDangNhap - @tk.HoTen (@(string.IsNullOrEmpty(tk.Email) ? "chưa có email" : tk.Email))</option>
                    }
                </select>
                <span style="@errorStyle">Khi liên kết, Họ tên / Email / SĐT sẽ đồng bộ sang tài khoản trực tuyến.</span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label style="@labelStyle">Trạng thái hoạt động</label>
                <label style="display:flex;align-items:center;gap:10px;min-height:42px;font-size: 13px;color:#414c57;">
                    <input asp-for="TrangThai" type="checkbox" style="width:18px;height:18px;" />
                    Cho phép khách hàng giao dịch trên hệ thống
                </label>
            </div>
            <div style="grid-column: span 2;display:flex;flex-direction:column;gap:6px;">
                <label asp-for="GhiChu" style="@labelStyle">Ghi chú / yêu cầu đặc biệt</label>
                <textarea asp-for="GhiChu" rows="3" placeholder="Ghi chú về thói quen, sở thích phòng, lưu ý phục vụ..." style="padding:10px 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;"></textarea>
                <span asp-validation-for="GhiChu" style="@errorStyle"></span>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu thay đổi</button>
            <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Chi tiết Khách hàng & Lịch sử đặt phòng (Restyle UI)
// ==========================================
*@

@model QLyDatPhongKhachSan.Models.KhachHang

@{
    ViewData["Title"] = $"Chi tiết khách hàng - {Model.HoTen}";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
    string avatarLetter = !string.IsNullOrWhiteSpace(Model.HoTen) ? Model.HoTen.Trim().Substring(0, 1).ToUpper() : "K";
    var danhSachDatPhong = Model.DatPhongs?.OrderByDescending(dp => dp.NgayDat).ToList() ?? new List<QLyDatPhongKhachSan.Models.DatPhong>();
    decimal tongChiTieu = danhSachDatPhong.Where(dp => dp.TrangThai != "DaHuy").Sum(dp => dp.TongTien);
    string rowLabel = "display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #edf0f2;font-size:12px;";
    string rowLabelText = "color:#737d87;";
    string rowValueText = "color:#172433;font-weight:600;text-align:right;";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 3 · Hồ sơ khách hàng #@Model.MaKhachHang.ToString("D4")</span>
        <h1>@Model.HoTen</h1>
        <p>Thông tin nhân thân, liên hệ và toàn bộ lịch sử giao dịch đặt phòng của khách hàng.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-primary" asp-action="Edit" asp-route-id="@Model.MaKhachHang" style="text-decoration:none;">Chỉnh sửa hồ sơ</a>
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Danh sách</a>
    </div>
</div>

<div class="report-highlight" style="grid-template-columns:repeat(3,1fr);">
    <div>
        <span>Số lần đặt phòng</span>
        <strong>@danhSachDatPhong.Count</strong>
        <small>Tổng số đơn đã phát sinh</small>
    </div>
    <div>
        <span>Tổng chi tiêu (không tính đơn hủy)</span>
        <strong>@tongChiTieu.ToString("N0")₫</strong>
        <small>Doanh thu tích lũy từ khách hàng</small>
    </div>
    <div>
        <span>Trạng thái hồ sơ</span>
        <strong style="font-size:19px;">@(Model.TrangThai ? "Đang hoạt động" : "Bị khóa")</strong>
        <small>@(Model.TaiKhoan != null ? "Có tài khoản trực tuyến" : "Khách vãng lai")</small>
    </div>
</div>

<div class="dashboard-grid report-grid">
    <article class="dashboard-card revenue-card">
        <div class="card-heading">
            <div><span>Hồ sơ</span><h2>Thông tin chi tiết</h2></div>
            <span class="status-badge @(Model.TrangThai ? "status-badge--success" : "status-badge--muted")"><i></i>@(Model.TrangThai ? "Hoạt động" : "Bị khóa")</span>
        </div>

        <div style="margin-top:18px;">
            <div style="display:flex;align-items:center;gap:14px;padding-bottom:16px;border-bottom:1px solid #edf0f2;">
                <div style="width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#102943;color:#e2c894;font-family:'Playfair Display',serif;font-size:22px;font-weight:700;">@avatarLetter</div>
                <div>
                    <div style="font-weight:700;color:#172433;font-size:14px;">@Model.HoTen</div>
                    <div style="color:#737d87;font-size:11px;">Mã khách hàng: #@Model.MaKhachHang.ToString("D4")</div>
                </div>
            </div>

            <div style="@rowLabel"><span style="@rowLabelText">Số CCCD / Hộ chiếu</span><span style="@rowValueText">@Model.CCCD</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Giới tính</span><span style="@rowValueText">@(Model.GioiTinh ?? "Chưa rõ")</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Ngày sinh</span><span style="@rowValueText">@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Quốc tịch</span><span style="@rowValueText">@(string.IsNullOrEmpty(Model.QuocTich) ? "Việt Nam" : Model.QuocTich)</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Số điện thoại</span><span style="@rowValueText">@Model.SoDienThoai</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Email</span><span style="@rowValueText">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</span></div>
            <div style="@rowLabel"><span style="@rowLabelText">Địa chỉ</span><span style="@rowValueText">@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</span></div>

            @if (Model.TaiKhoan != null)
            {
                <div style="@rowLabel"><span style="@rowLabelText">Tài khoản hệ thống</span><span style="@rowValueText">@Model.TaiKhoan.TenDangNhap · @Model.TaiKhoan.VaiTro</span></div>
                <div style="@rowLabel;border-bottom:0;"><span style="@rowLabelText">Ngày tạo tài khoản</span><span style="@rowValueText">@Model.TaiKhoan.NgayTao.ToString("dd/MM/yyyy HH:mm")</span></div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <div style="margin-top:16px;padding:12px 14px;border-left:3px solid #c9a35d;background:#fbf7ef;color:#6b5a36;font-size:12px;">
                <strong style="display:block;margin-bottom:3px;">Ghi chú nội bộ</strong>@Model.GhiChu
            </div>
        }
    </article>

    <article class="dashboard-card" style="display:flex;flex-direction:column;">
        <div class="card-heading" style="padding:23px 23px 0;">
            <div><span>Phân hạng</span><h2>Tóm tắt giao dịch</h2></div>
        </div>
        <div style="padding:18px 23px 24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#f7f9fa;border:1px solid #edf0f2;">
                <span style="font-size:11px;color:#737d87;">Số đơn hợp lệ</span>
                <strong style="font-family:'Playfair Display',serif;font-size:22px;color:#102943;">@danhSachDatPhong.Count(dp => dp.TrangThai != "DaHuy")</strong>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#f7f9fa;border:1px solid #edf0f2;border-top:0;">
                <span style="font-size:11px;color:#737d87;">Đơn đã hủy</span>
                <strong style="font-family:'Playfair Display',serif;font-size:22px;color:#a17732;">@danhSachDatPhong.Count(dp => dp.TrangThai == "DaHuy")</strong>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#eef6f2;border:1px solid #d9ebe1;border-top:0;">
                <span style="font-size:11px;color:#37614b;">Tổng chi tiêu</span>
                <strong style="font-family:'Playfair Display',serif;font-size:20px;color:#37614b;">@tongChiTieu.ToString("N0")₫</strong>
            </div>
            <a class="admin-secondary" asp-controller="DatPhong" asp-action="Index" style="display:block;text-align:center;margin-top:16px;text-decoration:none;">Đặt phòng mới cho khách →</a>
        </div>
    </article>
</div>

<article class="dashboard-card data-card" style="margin-top:18px;">
    <div class="card-heading" style="padding:22px 24px;border-bottom:1px solid #e4e7e9;">
        <div><span>Lịch sử đặt phòng</span><h2>Danh sách đơn đặt phòng (@danhSachDatPhong.Count)</h2></div>
    </div>

    @if (danhSachDatPhong.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Thời gian lưu trú</th>
                        <th>Phòng đã đặt</th>
                        <th>Số khách</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dp in danhSachDatPhong)
                    {
                        var soDem = (dp.NgayTraDuKien.Date - dp.NgayNhan.Date).Days;
                        if (soDem < 1) { soDem = 1; }
                        <tr>
                            <td>
                                <strong>#@dp.MaDatPhong.ToString("D4")</strong>
                                <small>Đặt: @dp.NgayDat.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <span>@dp.NgayNhan.ToString("dd/MM/yyyy") → @dp.NgayTraDuKien.ToString("dd/MM/yyyy")</span>
                                <small>@soDem đêm</small>
                            </td>
                            <td>
                                @if (dp.ChiTietDatPhongs != null && dp.ChiTietDatPhongs.Any())
                                {
                                    foreach (var ct in dp.ChiTietDatPhongs)
                                    {
                                        <span class="status-badge status-badge--info" style="margin-right:4px;"><i></i>Phòng @(ct.Phong?.SoPhong ?? ct.MaPhong.ToString())</span>
                                    }
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@dp.SoNguoi</td>
                            <td>
                                <strong>@dp.TongTien.ToString("N0")₫</strong>
                                @if (dp.TienCoc > 0)
                                {
                                    <small>Cọc: @dp.TienCoc.ToString("N0")₫</small>
                                }
                            </td>
                            <td><partial name="_TrangThaiBadge" model="@dp.TrangThai" /></td>
                            <td style="text-align:right;">
                                <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size:10px;text-decoration:none;" asp-controller="DatPhong" asp-action="Details" asp-route-id="@dp.MaDatPhong">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-table">
            <strong>Chưa có lịch sử đặt phòng</strong>
            <span>Khách hàng này chưa thực hiện đơn đặt phòng nào trong hệ thống.</span>
        </div>
    }
</article>

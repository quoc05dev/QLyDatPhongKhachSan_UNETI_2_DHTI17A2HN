@*
    Họ và tên: Đậu Đức Lưu
    Mã sinh viên: 23103100114
    Nội dung thực hiện: CRUD cơ bản quản lý Phòng - Màn hình sửa (Module 2 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.Phong

@{
    ViewData["Title"] = "Sửa phòng " + Model.SoPhong;
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "rooms";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Cập nhật phòng</span>
        <h1>Sửa thông tin Phòng @Model.SoPhong</h1>
        <p>Cập nhật số phòng, đơn giá, hạng phòng và lịch bảo trì hiện tại.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 800px;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#c0392b;margin-bottom:16px;font-size: 13px;"></div>
        <input type="hidden" asp-for="MaPhong" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="SoPhong" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Số phòng <span style="color:red;">*</span></label>
                <input asp-for="SoPhong" placeholder="Ví dụ: 101, 202..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="SoPhong" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="MaLoaiPhong" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Loại phòng <span style="color:red;">*</span></label>
                <select asp-for="MaLoaiPhong" asp-items="ViewBag.MaLoaiPhong" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;">
                    <option value="">-- Chọn loại phòng --</option>
                </select>
                <span asp-validation-for="MaLoaiPhong" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="Tang" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Tầng <span style="color:red;">*</span></label>
                <input asp-for="Tang" type="number" placeholder="Nhập tầng..." min="1" max="100" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="Tang" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="HuongPhong" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Hướng phòng</label>
                <input asp-for="HuongPhong" placeholder="Hướng biển, Hướng thành phố,..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="HuongPhong" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="DonGia" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Đơn giá ngày (₫) <span style="color:red;">*</span></label>
                <input asp-for="DonGia" type="number" step="1000" placeholder="Đơn giá lưu trú..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="DonGia" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="TrangThai" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Trạng thái phòng <span style="color:red;">*</span></label>
                <select asp-for="TrangThai" asp-items="ViewBag.TrangThai" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;"></select>
                <span asp-validation-for="TrangThai" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="grid-column: span 2; display:flex;flex-direction:column;gap:6px;">
                <label asp-for="TienNghi" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Tiện nghi trang bị</label>
                <input asp-for="TienNghi" placeholder="Điều hòa, Smart TV, Bồn tắm, Ban công..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="TienNghi" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="grid-column: span 2; display:flex;flex-direction:column;gap:6px;">
                <label asp-for="GhiChu" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Ghi chú chung</label>
                <textarea asp-for="GhiChu" rows="2" placeholder="Ghi chú về phòng nếu có..." style="padding:10px 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;"></textarea>
                <span asp-validation-for="GhiChu" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="NgayBaoTri" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Ngày bảo trì</label>
                <input asp-for="NgayBaoTri" type="date" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="NgayBaoTri" style="color:#c0392b;font-size: 12px;"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                <label asp-for="GhiChuBaoTri" style="font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;">Ghi chú bảo trì</label>
                <input asp-for="GhiChuBaoTri" placeholder="Nội dung bảo trì..." style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 13px;" />
                <span asp-validation-for="GhiChuBaoTri" style="color:#c0392b;font-size: 12px;"></span>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #edf0f2;display:flex;gap:12px;">
            <button type="submit" class="admin-primary">Lưu thay đổi</button>
            <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ</a>
        </div>
    </form>
</article>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@*
    Họ và tên: Đậu Đức Lưu
    Mã sinh viên: 23103100114
    Nội dung thực hiện: CRUD cơ bản quản lý Phòng - Màn hình xóa (Module 2 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.Phong

@{
    ViewData["Title"] = "Xóa phòng " + Model.SoPhong;
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "rooms";
    bool hasHistory = ViewBag.HasHistory ?? false;
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 2 · Thao tác xóa phòng</span>
        <h1>Xóa Phòng @Model.SoPhong</h1>
        <p>Xác nhận thao tác xóa thông tin phòng khỏi danh mục hệ thống khách sạn.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

<article class="dashboard-card" style="padding: 28px; max-width: 700px;">
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (hasHistory)
    {
        <div style="padding:14px 18px;background:#fff9eb;border-left:4px solid #f39c12;color:#b27b16;margin-bottom:20px;font-size:12px;border-radius:2px;line-height:1.6;">
            <strong style="display:block;margin-bottom:4px;font-size:13px;">⚠️ Cảnh báo toàn vẹn dữ liệu:</strong>
            Phòng này đã phát sinh lịch sử đặt phòng trong hệ thống. Việc xóa phòng bị chặn để bảo đảm toàn vẹn báo cáo &amp; thống kê.
        </div>
    }
    else
    {
        <div style="padding:14px 18px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;line-height:1.6;">
            <strong style="display:block;margin-bottom:4px;font-size:13px;">🚨 Báo xác nhận xóa:</strong>
            Bạn có chắc chắn muốn xóa <strong>Phòng @Model.SoPhong</strong> không? Thao tác này không thể hoàn tác.
        </div>
    }

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:20px 0;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2;">
        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Số phòng</small>
            <strong style="font-size:16px;color:var(--navy-950);">Phòng @Model.SoPhong</strong>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Loại phòng</small>
            <span style="font-size:14px;color:#b28c49;font-weight:600;">@(Model.LoaiPhong != null ? Model.LoaiPhong.TenLoai : "—")</span>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tầng</small>
            <span style="font-size:13px;">Tầng @Model.Tang</span>
        </div>

        <div>
            <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Đơn giá</small>
            <strong style="font-size:14px;color:#c9a35d;">@Model.DonGia.ToString("N0")₫ / đêm</strong>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.MaPhong" method="post" style="margin-top:24px;display:flex;gap:12px;">
        <input type="hidden" asp-for="MaPhong" />

        @if (!hasHistory)
        {
            <button type="submit" class="admin-primary" style="background:#e74c3c;color:#fff;">Xác nhận xóa phòng</button>
        }

        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">Hủy bỏ &amp; Quay lại</a>
    </form>
</article>

@model QLyDatPhongKhachSan.Models.Phong

@{
    ViewData["Title"] = "Xóa phòng";
    bool hasHistory = ViewBag.HasHistory ?? false;
}

<h1>Xóa phòng</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (hasHistory)
{
    <div class="alert alert-warning">
        <strong>Cảnh báo:</strong> Phòng này đã có lịch sử đặt phòng trong hệ thống. Việc xóa phòng sẽ gây mất toàn vẹn dữ liệu. 
        Bạn không thể thực hiện thao tác xóa đối với phòng này!
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Bạn có chắc chắn muốn xóa phòng này không?</strong> Thao tác này không thể hoàn tác.
    </div>
}

<div>
    <h4>Phòng @Model.SoPhong</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.SoPhong)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SoPhong)
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MaLoaiPhong)
        </dt>
        <dd class="col-sm-9">
            @(Model.LoaiPhong != null ? Model.LoaiPhong.TenLoai : "Không xác định")
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Tang)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Tang)
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DonGia)
        </dt>
        <dd class="col-sm-9">
            @Model.DonGia.ToString("N0") VNĐ
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.GhiChuBaoTri)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.GhiChuBaoTri)
        </dd>
    </dl>
    
    <form asp-action="Delete" asp-route-id="@Model.MaPhong" method="post">
        <input type="hidden" asp-for="MaPhong" />
        
        @if (!hasHistory)
        {
            <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        }
        
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </form>
</div>

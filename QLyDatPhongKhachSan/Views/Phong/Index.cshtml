@model QLyDatPhongKhachSan.ViewModels.PhongListViewModel

@{
    ViewData["Title"] = "Danh sách phòng";
}

<h1>Danh sách phòng</h1>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Thêm phòng</a>

    <form method="get" asp-action="Index" class="d-flex">
        <input type="text" name="keyword" class="form-control me-2" value="@Model.Keyword" placeholder="Tìm theo số phòng hoặc loại phòng..." style="width: 300px;" />
        <button type="submit" class="btn btn-success me-2">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-secondary">Xóa tìm kiếm</a>
    </form>
</div>

@if (Model.Phongs != null && Model.Phongs.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Số phòng</th>
                <th>Loại phòng</th>
                <th>Tầng</th>
                <th>Hướng phòng</th>
                <th>Đơn giá</th>
                <th>Trạng thái</th>
                <th>Ngày bảo trì</th>
                <th>Ghi chú bảo trì</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Phongs)
            {
                <tr>
                    <td>@item.SoPhong</td>
                    <td>@(item.LoaiPhong != null ? item.LoaiPhong.TenLoai : "")</td>
                    <td>@item.Tang</td>
                    <td>@item.HuongPhong</td>
                    <td>@item.DonGia.ToString("N0") VNĐ</td>
                    <td>@item.TrangThai</td>
                    <td>@(item.NgayBaoTri.HasValue ? item.NgayBaoTri.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>@item.GhiChuBaoTri</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaPhong" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MaPhong" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.MaPhong" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <text>Không tìm thấy phòng phù hợp.</text>
        }
        else
        {
            <text>Chưa có dữ liệu phòng trong hệ thống.</text>
        }
    </div>
}

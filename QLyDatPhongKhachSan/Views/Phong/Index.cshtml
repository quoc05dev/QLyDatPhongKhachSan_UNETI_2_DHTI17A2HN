@*
    Họ và tên: Đậu Đức Lưu
    Mã sinh viên: 23103100114
    Nội dung thực hiện: CRUD cơ bản quản lý Phòng - Màn hình danh sách (Module 2 Restyle UI)
*@
@model QLyDatPhongKhachSan.ViewModels.PhongListViewModel

@{
    ViewData["Title"] = "Quản lý phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "rooms";

    var vaiTro = Context.Session.GetVaiTro();
    var canQuanLyPhong = vaiTro == "Admin" || vaiTro == "NhanVien";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Quản lý phòng</span>
        <h1>Quản lý danh sách phòng</h1>
        <p>Tìm kiếm, lọc trạng thái, loại phòng, đơn giá và cấu hình danh mục phòng khách sạn.</p>
    </div>
    @if (canQuanLyPhong)
    {
        <a class="admin-primary" asp-action="Create">
            <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            Thêm phòng mới
        </a>
    }
</div>

<article class="dashboard-card data-card">
    <form method="get" asp-action="Index">
        <div class="table-toolbar" style="flex-wrap:wrap;gap:12px;">
            <div class="admin-search" style="min-width:260px;">
                <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo số phòng, loại phòng..." />
            </div>

            <select name="maLoaiPhong" asp-items="@Model.LoaiPhongList">
                <option value="">-- Tất cả loại phòng --</option>
            </select>

            <select name="trangThai" asp-items="@Model.TrangThaiList">
                <option value="">-- Tất cả trạng thái --</option>
            </select>

            <input type="number" name="tang" value="@Model.Tang" placeholder="Tầng" min="1" max="100" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;width:90px;" />

            <input asp-for="GiaMin" type="number" placeholder="Giá từ (₫)" min="0" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;width:120px;" />
            <input asp-for="GiaMax" type="number" placeholder="Giá đến (₫)" min="0" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;width:120px;" />

            <input asp-for="NgayNhan" type="date" title="Ngày nhận phòng" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;" />
            <input asp-for="NgayTra" type="date" title="Ngày trả phòng" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;" />

            <select asp-for="SortOrder" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;">
                <option value="soPhong_asc">Số phòng: Tăng dần</option>
                <option value="soPhong_desc">Số phòng: Giảm dần</option>
                <option value="donGia_asc">Đơn giá: Tăng dần</option>
                <option value="donGia_desc">Đơn giá: Giảm dần</option>
                <option value="tang_asc">Tầng: Tăng dần</option>
                <option value="tang_desc">Tầng: Giảm dần</option>
                <option value="loaiPhong_asc">Loại phòng: A-Z</option>
            </select>

            <button type="submit" class="admin-primary" style="min-height:42px;padding:0 20px;">Lọc</button>
            <a asp-action="Index" class="admin-secondary" style="min-height:42px;padding:0 16px;text-decoration:none;">Xóa lọc</a>
        </div>
        <span asp-validation-for="NgayNhan" class="text-danger small"></span>
        <span asp-validation-for="NgayTra" class="text-danger small"></span>
        <span asp-validation-for="GiaMin" class="text-danger small"></span>
        <span asp-validation-for="GiaMax" class="text-danger small"></span>
    </form>

    <div class="table-result-row">
        <span>Hiển thị kết quả tìm kiếm phòng</span>
        <strong>Tổng số: @Model.TotalItems phòng</strong>
    </div>

    @if (Model.Phongs != null && Model.Phongs.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Số phòng</th>
                        <th>Loại phòng</th>
                        <th>Vị trí &amp; Hướng</th>
                        <th>Đơn giá / đêm</th>
                        <th>Trạng thái</th>
                        <th>Lịch bảo trì</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Phongs)
                    {
                        var badgeClass = item.TrangThai switch
                        {
                            "Trong" => "status-badge--success",
                            "DangSuDung" => "status-badge--info",
                            "BaoTri" => "status-badge--warning",
                            _ => "status-badge--muted"
                        };

                        <tr>
                            <td>
                                <strong>Phòng @item.SoPhong</strong>
                                <small>Mã phòng: #@item.MaPhong</small>
                            </td>
                            <td>
                                <span style="font-weight:600;color:var(--navy-900);">@(item.LoaiPhong != null ? item.LoaiPhong.TenLoai : "—")</span>
                            </td>
                            <td>
                                <span>Tầng @item.Tang</span>
                                @if (!string.IsNullOrWhiteSpace(item.HuongPhong))
                                {
                                    <small style="display:block;color:#6b7480;">@item.HuongPhong</small>
                                }
                            </td>
                            <td>
                                <strong style="color:#b28c49;">@item.DonGia.ToString("N0")₫</strong>
                            </td>
                            <td>
                                <span class="status-badge @badgeClass">
                                    <i></i>@TrangThaiHelper.HienThi(item.TrangThai)
                                </span>
                            </td>
                            <td>
                                @if (item.NgayBaoTri.HasValue)
                                {
                                    <span>@item.NgayBaoTri.Value.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(item.GhiChuBaoTri))
                                    {
                                        <small style="display:block;color:#6b7480;">@item.GhiChuBaoTri</small>
                                    }
                                }
                                else
                                {
                                    <span style="color:#b0b7be;">—</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:8px;">
                                    <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;text-decoration:none;" asp-action="Details" asp-route-id="@item.MaPhong">Chi tiết</a>
                                    @if (canQuanLyPhong)
                                    {
                                        <a class="admin-primary" style="min-height:32px;padding:0 10px;font-size: 11px;text-decoration:none;" asp-action="Edit" asp-route-id="@item.MaPhong">Sửa</a>
                                        <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;color:#c0392b;border-color:#f5c6cb;text-decoration:none;" asp-action="Delete" asp-route-id="@item.MaPhong">Xóa</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index"
                       asp-route-page="@p"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-maLoaiPhong="@Model.MaLoaiPhong"
                       asp-route-tang="@Model.Tang"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-giaMin="@Model.GiaMin"
                       asp-route-giaMax="@Model.GiaMax"
                       asp-route-ngayNhan="@(Model.NgayNhan?.ToString("yyyy-MM-dd"))"
                       asp-route-ngayTra="@(Model.NgayTra?.ToString("yyyy-MM-dd"))"
                       asp-route-sortOrder="@Model.SortOrder"
                       style="text-decoration:none;">
                        <button type="button" class="@(p == Model.CurrentPage ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Không tìm thấy phòng phù hợp</strong>
            <span>Vui lòng thử thay đổi từ khóa hoặc điều kiện lọc.</span>
        </div>
    }
</article>

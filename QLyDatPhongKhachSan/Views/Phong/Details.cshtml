@*
    Họ và tên: Đậu Đức Lưu
    Mã sinh viên: 23103100114
    Nội dung thực hiện: CRUD cơ bản quản lý Phòng - Màn hình chi tiết (Module 2 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.Phong

@{
    ViewData["Title"] = "Chi tiết phòng " + Model.SoPhong;
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "rooms";

    var vaiTro = Context.Session.GetVaiTro();
    var canQuanLyPhong = vaiTro == "Admin" || vaiTro == "NhanVien";

    var badgeClass = Model.TrangThai switch
    {
        "Trong" => "status-badge--success",
        "DangSuDung" => "status-badge--info",
        "BaoTri" => "status-badge--warning",
        _ => "status-badge--muted"
    };
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 2 · Chi tiết phòng</span>
        <h1>Phòng @Model.SoPhong</h1>
        <p>Chi tiết thông tin cấu hình, loại phòng, đơn giá và trạng thái vận hành hiện tại.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
        @if (canQuanLyPhong)
        {
            <a class="admin-primary" asp-action="Edit" asp-route-id="@Model.MaPhong" style="text-decoration:none;">Sửa thông tin</a>
        }
    </div>
</div>

<div class="dashboard-grid" style="grid-template-columns: 2fr 1fr;">
    <article class="dashboard-card" style="padding: 24px;">
        <div class="card-heading" style="margin-bottom: 20px;">
            <div>
                <span>Thông tin tổng quan</span>
                <h2>Chi tiết cấu hình phòng</h2>
            </div>
            <span class="status-badge @badgeClass">
                <i></i>@TrangThaiHelper.HienThi(Model.TrangThai)
            </span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;padding-top:16px;border-top:1px solid #edf0f2;">
            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Số phòng</small>
                <strong style="font-size:18px;font-family:'Playfair Display',serif;color:var(--navy-950);">Phòng @Model.SoPhong</strong>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Loại phòng</small>
                <strong style="font-size:15px;color:#b28c49;">@(Model.LoaiPhong != null ? Model.LoaiPhong.TenLoai : "Chưa xác định")</strong>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tầng &amp; Hướng</small>
                <span style="font-size:13px;font-weight:500;">Tầng @Model.Tang · @(string.IsNullOrWhiteSpace(Model.HuongPhong) ? "Chưa có thông tin" : Model.HuongPhong)</span>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Đơn giá lưu trú</small>
                <strong style="font-size:18px;color:#c9a35d;">@Model.DonGia.ToString("N0")₫ <small style="font-size:10px;color:#8a939d;">/ đêm</small></strong>
            </div>

            <div style="grid-column: span 2;">
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tiện nghi trang bị</small>
                <span style="font-size:12px;color:#4a5568;">@(string.IsNullOrWhiteSpace(Model.TienNghi) ? "Chưa cập nhật danh mục tiện nghi." : Model.TienNghi)</span>
            </div>

            <div style="grid-column: span 2;">
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Ghi chú chung</small>
                <span style="font-size:12px;color:#4a5568;">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú." : Model.GhiChu)</span>
            </div>
        </div>
    </article>

    <article class="dashboard-card" style="padding: 24px;">
        <div class="card-heading" style="margin-bottom: 20px;">
            <div>
                <span>Tình trạng bảo trì</span>
                <h2>Thông tin bảo trì</h2>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:16px;padding-top:16px;border-top:1px solid #edf0f2;">
            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Ngày bảo trì gần nhất</small>
                <strong style="font-size:14px;color:var(--navy-950);">
                    @(Model.NgayBaoTri.HasValue ? Model.NgayBaoTri.Value.ToString("dd/MM/yyyy") : "Chưa có lịch bảo trì")
                </strong>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Nội dung / Ghi chú bảo trì</small>
                <p style="margin-top:4px;font-size:12px;color:#4a5568;">
                    @(string.IsNullOrWhiteSpace(Model.GhiChuBaoTri) ? "Không có ghi chú bảo trì." : Model.GhiChuBaoTri)
                </p>
            </div>
        </div>
    </article>
</div>

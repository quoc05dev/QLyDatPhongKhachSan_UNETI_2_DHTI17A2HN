@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Giao diện lịch sử đặt phòng (Index) & Bộ lọc trạng thái
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongLichSuViewModel
@{
    ViewData["Title"] = "Lịch sử đặt phòng của tôi";
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="KhachHang" asp-action="Profile">Hồ sơ cá nhân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch sử đặt phòng</li>
        </ol>
    </nav>

    <!-- Header & Thao tác -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-check me-2"></i>Lịch sử đặt phòng của tôi
            </h2>
            <p class="text-muted mb-0">Theo dõi thông tin chi tiết, tiến độ xử lý và quản lý đơn đặt phòng của quý khách</p>
        </div>
        <div>
            <a asp-controller="Phong" asp-action="Index" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Đặt phòng mới
            </a>
        </div>
    </div>

    <!-- Thông báo kết quả thao tác -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="flex-grow-1">
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div class="flex-grow-1">
                <strong>Thông báo:</strong> @TempData["ErrorMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thống kê trạng thái & Bộ lọc Pills -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="fw-semibold text-muted me-2 small">
                    <i class="bi bi-funnel me-1"></i>Lọc trạng thái:
                </span>

                <a asp-action="Index" asp-route-trangThaiFilter=""
                   class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(Model.TrangThaiFilter) ? "btn-primary shadow-sm" : "btn-light border")">
                    Tất cả <span class="badge bg-white text-dark ms-1">@Model.TongDon</span>
                </a>

                <a asp-action="Index" asp-route-trangThaiFilter="ChoXuLy"
                   class="btn btn-sm rounded-pill @(Model.TrangThaiFilter == "ChoXuLy" ? "btn-warning text-dark shadow-sm" : "btn-light border")">
                    ⏳ Chờ xử lý <span class="badge bg-warning-subtle text-dark ms-1">@Model.DonChoXuLy</span>
                </a>

                <a asp-action="Index" asp-route-trangThaiFilter="DaXacNhan"
                   class="btn btn-sm rounded-pill @(Model.TrangThaiFilter == "DaXacNhan" ? "btn-info text-dark shadow-sm" : "btn-light border")">
                    ✅ Đã xác nhận <span class="badge bg-info-subtle text-dark ms-1">@Model.DonDaXacNhan</span>
                </a>

                <a asp-action="Index" asp-route-trangThaiFilter="HoanThanh"
                   class="btn btn-sm rounded-pill @(Model.TrangThaiFilter == "HoanThanh" ? "btn-success shadow-sm" : "btn-light border")">
                    🏆 Hoàn thành <span class="badge bg-success-subtle text-dark ms-1">@Model.DonHoanThanh</span>
                </a>

                <a asp-action="Index" asp-route-trangThaiFilter="DaHuy"
                   class="btn btn-sm rounded-pill @(Model.TrangThaiFilter == "DaHuy" ? "btn-secondary shadow-sm" : "btn-light border")">
                    ❌ Đã hủy <span class="badge bg-secondary-subtle text-dark ms-1">@Model.DonDaHuy</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Danh sách đơn đặt phòng -->
    @if (Model.DanhSachDon == null || !Model.DanhSachDon.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3">
            <div class="mb-3">
                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-secondary mb-2">Chưa có đơn đặt phòng nào</h4>
            @if (!string.IsNullOrEmpty(Model.TrangThaiFilter))
            {
                <p class="text-muted mb-4">Không tìm thấy đơn đặt phòng nào phù hợp với bộ lọc trạng thái "<strong>@Model.TrangThaiFilter</strong>".</p>
                <div>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-arrow-clockwise me-1"></i>Xem tất cả đơn
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted mb-4">Quý khách chưa thực hiện đặt phòng nào tại UNETI Hotel. Hãy khám phá và chọn căn phòng ưng ý ngay hôm nay!</p>
                <div>
                    <a asp-controller="Phong" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-door-open me-1"></i>Xem danh sách phòng trống
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small text-uppercase">
                            <th scope="col" class="ps-4">Mã đơn</th>
                            <th scope="col">Phòng</th>
                            <th scope="col">Ngày đặt</th>
                            <th scope="col">Thời gian lưu trú</th>
                            <th scope="col">Số khách</th>
                            <th scope="col">Tổng tiền / Đặt cọc</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DanhSachDon)
                        {
                            <tr>
                                <!-- Mã đơn -->
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@item.MaDatPhong.ToString("D4")</span>
                                </td>

                                <!-- Phòng & Loại phòng -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1 me-2 text-center" style="min-width: 48px;">
                                            @item.SoPhong
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">Phòng @item.SoPhong</div>
                                            <div class="small text-muted">@item.TenLoaiPhong</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Ngày đặt -->
                                <td>
                                    <div class="small text-dark">@item.NgayDat.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">@item.NgayDat.ToString("HH:mm")</div>
                                </td>

                                <!-- Thời gian lưu trú -->
                                <td>
                                    <div class="small text-dark fw-semibold">
                                        @item.NgayNhan.ToString("dd/MM/yyyy") ➔ @item.NgayTraDuKien.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-moon me-1"></i>@item.SoNgayO đêm
                                    </div>
                                </td>

                                <!-- Số khách -->
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-people me-1"></i>@item.SoNguoi người
                                    </span>
                                </td>

                                <!-- Chi phí -->
                                <td>
                                    <div class="fw-bold text-dark">@item.TongTien.ToString("N0") VNĐ</div>
                                    @if (item.TienCoc > 0)
                                    {
                                        <div class="small text-success">
                                            <i class="bi bi-check2 me-1"></i>Cọc: @item.TienCoc.ToString("N0") VNĐ
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted" style="font-size: 0.8rem;">Chưa đặt cọc</div>
                                    }
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    @switch (item.TrangThai)
                                    {
                                        case "ChoXuLy":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ xử lý
                                            </span>
                                            break;
                                        case "DangXuLy":
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                                <i class="bi bi-gear-fill me-1"></i>Đang xử lý
                                            </span>
                                            break;
                                        case "DaXacNhan":
                                            <span class="badge bg-primary px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Đã xác nhận
                                            </span>
                                            break;
                                        case "DangSuDung":
                                            <span class="badge text-white px-3 py-2 rounded-pill" style="background-color: #6f42c1;">
                                                <i class="bi bi-door-open me-1"></i>Đang lưu trú
                                            </span>
                                            break;
                                        case "HoanThanh":
                                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                                <i class="bi bi-check2-all me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "DaHuy":
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@item.TrangThai</span>
                                            break;
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.MaDatPhong" 
                                           class="btn btn-outline-primary" title="Xem chi tiết đơn">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>

                                        @if (item.CoTheHuy)
                                        {
                                            <button type="button" class="btn btn-outline-danger" 
                                                    data-bs-toggle="modal" data-bs-target="#modalHuy-@item.MaDatPhong"
                                                    title="Hủy đơn đặt phòng này">
                                                <i class="bi bi-x-lg me-1"></i>Hủy
                                            </button>
                                        }
                                    </div>

                                    <!-- Modal xác nhận hủy đơn -->
                                    @if (item.CoTheHuy)
                                    {
                                        <div class="modal fade" id="modalHuy-@item.MaDatPhong" tabindex="-1" aria-labelledby="lblHuy-@item.MaDatPhong" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow rounded-4 text-start">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger" id="lblHuy-@item.MaDatPhong">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận hủy đặt phòng
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <p class="mb-2">
                                                            Quý khách có chắc chắn muốn hủy đơn đặt phòng 
                                                            <strong class="text-primary">#@item.MaDatPhong.ToString("D4")</strong> 
                                                            (Phòng @item.SoPhong) không?
                                                        </p>
                                                        <div class="alert alert-warning small mb-0">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            Lưu ý: Thao tác hủy đơn đặt phòng không thể hoàn tác sau khi đã xác nhận.
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                        <form asp-action="Cancel" asp-route-id="@item.MaDatPhong" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                                                                Xác nhận hủy đơn
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

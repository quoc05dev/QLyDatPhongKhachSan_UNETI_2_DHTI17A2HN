@*
    Họ và tên: Anh Tuấn
    Mã sinh viên: 23103100086
    Nội dung thực hiện: Module 3 - Giao diện lịch sử đặt phòng (Index) kèm Phân trang, Sắp xếp & Bộ lọc (Restyle UI)
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongLichSuViewModel
@{
    ViewData["Title"] = "Lịch sử đặt phòng của tôi";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 3 · Lịch sử giao dịch</span>
        <h1>Danh sách đơn đặt phòng</h1>
        <p>Theo dõi thông tin chi tiết, trạng thái xử lý và quản lý lịch sử giao dịch đặt phòng.</p>
    </div>
    <a class="admin-primary" asp-controller="Phong" asp-action="Index" style="text-decoration:none;">
        <svg class="admin-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
        Đặt phòng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="padding:12px 16px;background:#eef6f2;border-left:4px solid #46785e;color:#2e5340;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ✓ @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚠️ @TempData["ErrorMessage"]
    </div>
}

<article class="dashboard-card data-card">
    <div class="table-toolbar" style="flex-wrap:wrap;justify-content:space-between;gap:12px;">
        <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
            <a asp-action="Index" asp-route-trangThaiFilter="" asp-route-sortOrder="@Model.SortOrder"
               class="admin-secondary" style="min-height:36px;padding:0 12px;font-size:9px;text-decoration:none;@(string.IsNullOrEmpty(Model.TrangThaiFilter) ? "background:#102943;color:#fff;border-color:#102943;" : "")">
                Tất cả (@Model.TongDon)
            </a>
            <a asp-action="Index" asp-route-trangThaiFilter="ChoXuLy" asp-route-sortOrder="@Model.SortOrder"
               class="admin-secondary" style="min-height:36px;padding:0 12px;font-size:9px;text-decoration:none;@(Model.TrangThaiFilter == "ChoXuLy" ? "background:#102943;color:#fff;border-color:#102943;" : "")">
                Chờ xử lý (@Model.DonChoXuLy)
            </a>
            <a asp-action="Index" asp-route-trangThaiFilter="DaXacNhan" asp-route-sortOrder="@Model.SortOrder"
               class="admin-secondary" style="min-height:36px;padding:0 12px;font-size:9px;text-decoration:none;@(Model.TrangThaiFilter == "DaXacNhan" ? "background:#102943;color:#fff;border-color:#102943;" : "")">
                Đã xác nhận (@Model.DonDaXacNhan)
            </a>
            <a asp-action="Index" asp-route-trangThaiFilter="HoanThanh" asp-route-sortOrder="@Model.SortOrder"
               class="admin-secondary" style="min-height:36px;padding:0 12px;font-size:9px;text-decoration:none;@(Model.TrangThaiFilter == "HoanThanh" ? "background:#102943;color:#fff;border-color:#102943;" : "")">
                Hoàn thành (@Model.DonHoanThanh)
            </a>
            <a asp-action="Index" asp-route-trangThaiFilter="DaHuy" asp-route-sortOrder="@Model.SortOrder"
               class="admin-secondary" style="min-height:36px;padding:0 12px;font-size:9px;text-decoration:none;@(Model.TrangThaiFilter == "DaHuy" ? "background:#102943;color:#fff;border-color:#102943;" : "")">
                Đã hủy (@Model.DonDaHuy)
            </a>
        </div>

        <form method="get" asp-action="Index" style="display:flex;align-items:center;gap:8px;">
            <input type="hidden" name="trangThaiFilter" value="@Model.TrangThaiFilter" />
            <span style="font-size:9px;font-weight:700;color:#717b85;text-transform:uppercase;">Sắp xếp:</span>
            <select name="sortOrder" onchange="this.form.submit()" style="min-height:36px;padding:0 10px;font-size:9px;border:1px solid #dce0e3;">
                <option value="date_desc" selected="@(Model.SortOrder == "date_desc")">Ngày đặt: Mới nhất</option>
                <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Ngày đặt: Cũ nhất</option>
                <option value="checkin_asc" selected="@(Model.SortOrder == "checkin_asc")">Ngày nhận: Gần nhất</option>
                <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Tổng tiền: Cao → Thấp</option>
                <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Tổng tiền: Thấp → Cao</option>
            </select>
        </form>
    </div>

    <div class="table-result-row">
        <span>Danh sách lịch sử đơn đặt phòng</span>
        <strong>Trang @Model.CurrentPage / @Model.TotalPages (Tổng số @Model.TongDon đơn)</strong>
    </div>

    @if (Model.DanhSachDon != null && Model.DanhSachDon.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày nhận — Ngày trả</th>
                        <th>Số người</th>
                        <th>Tiền cọc</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var don in Model.DanhSachDon)
                    {
                        var badgeClass = don.TrangThai switch
                        {
                            "ChoXuLy" => "status-badge--warning",
                            "DaXacNhan" or "DangXuLy" => "status-badge--info",
                            "HoanThanh" => "status-badge--success",
                            _ => "status-badge--muted"
                        };

                        var tenTrangThai = don.TrangThai switch
                        {
                            "ChoXuLy" => "Chờ xử lý",
                            "DaXacNhan" => "Đã xác nhận",
                            "DangXuLy" => "Đang xử lý",
                            "HoanThanh" => "Hoàn thành",
                            "DaHuy" => "Đã hủy",
                            _ => don.TrangThai
                        };

                        <tr>
                            <td>
                                <strong>#@don.MaDatPhong</strong>
                                <small>Ngày đặt: @don.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <span>@don.NgayNhan.ToString("dd/MM/yyyy") → @don.NgayTraDuKien.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td>@don.SoNguoi người</td>
                            <td>@don.TienCoc.ToString("N0")₫</td>
                            <td><strong style="color:#b28c49;">@don.TongTien.ToString("N0")₫</strong></td>
                            <td>
                                <span class="status-badge @badgeClass"><i></i>@tenTrangThai</span>
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:6px;">
                                    <a class="admin-secondary" style="min-height:30px;padding:0 10px;font-size:9px;text-decoration:none;" asp-action="Details" asp-route-id="@don.MaDatPhong">Chi tiết</a>
                                    @if (don.TrangThai == "ChoXuLy")
                                    {
                                        <form asp-action="HuyDatPhong" asp-route-id="@don.MaDatPhong" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt phòng này?');">
                                            <button type="submit" class="admin-secondary" style="min-height:30px;padding:0 10px;font-size:9px;color:#c0392b;border-color:#f5c6cb;">Hủy đơn</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-pageNumber="@p" asp-route-trangThaiFilter="@Model.TrangThaiFilter" asp-route-sortOrder="@Model.SortOrder" style="text-decoration:none;">
                        <button type="button" class="@(p == Model.CurrentPage ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Chưa có đơn đặt phòng nào</strong>
            <span>Vui lòng chọn tìm kiếm phòng để tạo đơn mới.</span>
        </div>
    }
</article>

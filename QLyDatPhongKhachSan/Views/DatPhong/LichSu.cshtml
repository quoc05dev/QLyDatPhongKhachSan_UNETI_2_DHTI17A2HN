@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Lịch sử đặt phòng (Restyle UI: lọc trạng thái, sắp xếp, phân trang)
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongLichSuViewModel
@{
    ViewData["Title"] = "Lịch sử đặt phòng của tôi";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";
    Func<string, string?, string> pillClass = (value, current) =>
        string.Equals(value, current, StringComparison.OrdinalIgnoreCase) ? "admin-primary" : "admin-secondary";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Lịch sử đặt phòng</span>
        <h1>Đơn đặt phòng của tôi</h1>
        <p>Theo dõi tiến độ xử lý và quản lý các đơn đặt phòng đã thực hiện.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-controller="KhachHang" asp-action="Profile" style="text-decoration:none;">Hồ sơ cá nhân</a>
        <a class="admin-primary" asp-controller="DatPhong" asp-action="Index" style="text-decoration:none;">Đặt phòng mới</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #4f8068;background:#eef6f2;color:#37614b;font-size: 13px;">✓ @TempData["SuccessMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #c0392b;background:#fdecea;color:#a93226;font-size: 13px;">⚠ @TempData["ErrorMessage"]</p>
}

<article class="dashboard-card data-card">
    <div class="table-toolbar" style="flex-wrap:wrap;gap:10px;align-items:center;">
        <a asp-action="LichSu" asp-route-trangThaiFilter="" asp-route-sortOrder="@Model.SortOrder" class="@pillClass("", Model.TrangThaiFilter)" style="min-height:36px;padding:0 14px;text-decoration:none;">Tất cả (@Model.TongDon)</a>
        <a asp-action="LichSu" asp-route-trangThaiFilter="ChoXuLy" asp-route-sortOrder="@Model.SortOrder" class="@pillClass("ChoXuLy", Model.TrangThaiFilter)" style="min-height:36px;padding:0 14px;text-decoration:none;">Chờ xử lý (@Model.DonChoXuLy)</a>
        <a asp-action="LichSu" asp-route-trangThaiFilter="DaXacNhan" asp-route-sortOrder="@Model.SortOrder" class="@pillClass("DaXacNhan", Model.TrangThaiFilter)" style="min-height:36px;padding:0 14px;text-decoration:none;">Đã xác nhận (@Model.DonDaXacNhan)</a>
        <a asp-action="LichSu" asp-route-trangThaiFilter="HoanThanh" asp-route-sortOrder="@Model.SortOrder" class="@pillClass("HoanThanh", Model.TrangThaiFilter)" style="min-height:36px;padding:0 14px;text-decoration:none;">Hoàn thành (@Model.DonHoanThanh)</a>
        <a asp-action="LichSu" asp-route-trangThaiFilter="DaHuy" asp-route-sortOrder="@Model.SortOrder" class="@pillClass("DaHuy", Model.TrangThaiFilter)" style="min-height:36px;padding:0 14px;text-decoration:none;">Đã hủy (@Model.DonDaHuy)</a>

        <form method="get" asp-action="LichSu" style="margin-left:auto;display:flex;align-items:center;gap:8px;">
            <input type="hidden" name="trangThaiFilter" value="@Model.TrangThaiFilter" />
            <span style="font-size: 11px;color:#5d666f;font-weight:700;text-transform:uppercase;">Sắp xếp</span>
            <select name="sortOrder" onchange="this.form.submit()" style="min-height:38px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size: 12px;">
                <option value="date_desc" selected="@(Model.SortOrder == "date_desc" ? "selected" : null)">Ngày đặt: Mới nhất</option>
                <option value="date_asc" selected="@(Model.SortOrder == "date_asc" ? "selected" : null)">Ngày đặt: Cũ nhất</option>
                <option value="checkin_asc" selected="@(Model.SortOrder == "checkin_asc" ? "selected" : null)">Ngày nhận: Gần nhất</option>
                <option value="price_desc" selected="@(Model.SortOrder == "price_desc" ? "selected" : null)">Tổng tiền: Cao → Thấp</option>
                <option value="price_asc" selected="@(Model.SortOrder == "price_asc" ? "selected" : null)">Tổng tiền: Thấp → Cao</option>
            </select>
        </form>
    </div>

    <div class="table-result-row">
        <span>Danh sách đơn đặt phòng của bạn</span>
        <strong>Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalItems đơn</strong>
    </div>

    @if (Model.DanhSachDon == null || !Model.DanhSachDon.Any())
    {
        <div class="empty-table">
            <strong>Chưa có đơn đặt phòng nào</strong>
            <span>
                @if (!string.IsNullOrEmpty(Model.TrangThaiFilter))
                {
                    @:Không tìm thấy đơn đặt phòng nào phù hợp với bộ lọc trạng thái.
                }
                else
                {
                    @:Bạn chưa thực hiện đặt phòng nào tại UNETI Grand. Hãy chọn phòng và đặt ngay.
                }
            </span>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Phòng</th>
                        <th>Ngày đặt</th>
                        <th>Thời gian lưu trú</th>
                        <th>Số khách</th>
                        <th>Tổng tiền / cọc</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DanhSachDon)
                    {
                        <tr>
                            <td><strong>#@item.MaDatPhong.ToString("D4")</strong></td>
                            <td>
                                <strong>Phòng @item.SoPhong</strong>
                                <small>@item.TenLoaiPhong</small>
                            </td>
                            <td>
                                <span>@item.NgayDat.ToString("dd/MM/yyyy")</span>
                                <small>@item.NgayDat.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span>@item.NgayNhan.ToString("dd/MM/yyyy") → @item.NgayTraDuKien.ToString("dd/MM/yyyy")</span>
                                <small>@item.SoNgayO đêm</small>
                            </td>
                            <td>@item.SoNguoi người</td>
                            <td>
                                <strong>@item.TongTien.ToString("N0")₫</strong>
                                <small>@(item.TienCoc > 0 ? $"Cọc: {item.TienCoc:N0}₫" : "Chưa đặt cọc")</small>
                            </td>
                            <td><partial name="_TrangThaiBadge" model="@item.TrangThai" /></td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:8px;">
                                    <a class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;text-decoration:none;" asp-action="Details" asp-route-id="@item.MaDatPhong">Chi tiết</a>
                                    @if (item.CoTheHuy)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.MaDatPhong" method="post" style="display:inline;">
                                            <button type="submit" class="admin-secondary" style="min-height:32px;padding:0 10px;font-size: 11px;color:#c0392b;border-color:#f5c6cb;"
                                                    onclick="return confirm('Bạn có chắc chắn muốn hủy đơn đặt phòng #@item.MaDatPhong.ToString("D4") (Phòng @item.SoPhong)?');">
                                                Hủy
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="LichSu"
                       asp-route-page="@p"
                       asp-route-trangThaiFilter="@Model.TrangThaiFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       style="text-decoration:none;">
                        <button type="button" class="@(p == Model.CurrentPage ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
</article>

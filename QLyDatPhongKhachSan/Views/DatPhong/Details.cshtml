@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Giao diện chi tiết đơn đặt phòng (Details) & Hủy đặt phòng an toàn
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongChiTietViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn đặt phòng #{Model.DatPhong.MaDatPhong:D4}";
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="DatPhong" asp-action="Index">Lịch sử đặt phòng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn #@Model.DatPhong.MaDatPhong.ToString("D4")</li>
        </ol>
    </nav>

    <!-- Thông báo thao tác -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="flex-grow-1">
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div class="flex-grow-1">
                <strong>Thông báo:</strong> @TempData["ErrorMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Banner Trạng thái đơn -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="p-4 @(Model.DatPhong.TrangThai switch {
            "ChoXuLy" => "bg-warning bg-opacity-10 text-dark border-start border-5 border-warning",
            "DangXuLy" => "bg-info bg-opacity-10 text-dark border-start border-5 border-info",
            "DaXacNhan" => "bg-primary bg-opacity-10 text-dark border-start border-5 border-primary",
            "DangSuDung" => "bg-opacity-10 text-white border-start border-5 border-purple",
            "HoanThanh" => "bg-success bg-opacity-10 text-dark border-start border-5 border-success",
            "DaHuy" => "bg-secondary bg-opacity-10 text-dark border-start border-5 border-secondary",
            _ => "bg-light border-start border-5 border-secondary"
        })" style="@(Model.DatPhong.TrangThai == "DangSuDung" ? "background-color: #f3ebf9; border-color: #6f42c1 !important;" : "")">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3">
                        @switch (Model.DatPhong.TrangThai)
                        {
                            case "ChoXuLy": <span>⏳</span>; break;
                            case "DangXuLy": <span>⚙️</span>; break;
                            case "DaXacNhan": <span>✅</span>; break;
                            case "DangSuDung": <span>🏨</span>; break;
                            case "HoanThanh": <span>🏆</span>; break;
                            case "DaHuy": <span>❌</span>; break;
                            default: <span>📋</span>; break;
                        }
                    </div>
                    <div>
                        <div class="small text-uppercase fw-bold text-muted">Trạng thái đơn hàng</div>
                        <h4 class="fw-bold mb-0">
                            @switch (Model.DatPhong.TrangThai)
                            {
                                case "ChoXuLy": <span>Chờ tiếp nhận & xử lý</span>; break;
                                case "DangXuLy": <span>Đang xử lý</span>; break;
                                case "DaXacNhan": <span>Đã xác nhận thành công</span>; break;
                                case "DangSuDung": <span>Đang lưu trú</span>; break;
                                case "HoanThanh": <span>Đã hoàn thành</span>; break;
                                case "DaHuy": <span>Đã hủy</span>; break;
                                default: <span>@Model.DatPhong.TrangThai</span>; break;
                            }
                        </h4>
                    </div>
                </div>

                <div>
                    <span class="badge bg-white text-dark border shadow-sm px-3 py-2 fs-6">
                        Mã đơn: <strong class="text-primary">#@Model.DatPhong.MaDatPhong.ToString("D4")</strong>
                    </span>
                </div>
            </div>

            <!-- Ghi chú diễn giải trạng thái -->
            <div class="mt-3 small text-muted">
                @switch (Model.DatPhong.TrangThai)
                {
                    case "ChoXuLy":
                        <span>Đơn đặt phòng của quý khách đã được ghi nhận và đang chờ bộ phận Lễ tân kiểm tra. Quý khách có thể hủy đơn nếu thay đổi kế hoạch.</span>
                        break;
                    case "DangXuLy":
                        <span>Lễ tân đang kiểm tra phòng và chuẩn bị xác nhận đơn cho quý khách.</span>
                        break;
                    case "DaXacNhan":
                        <span>Phòng đã được giữ chỗ cho quý khách. Vui lòng xuất trình CCCD/Hộ chiếu khi đến nhận phòng tại quầy lễ tân.</span>
                        break;
                    case "DangSuDung":
                        <span>Quý khách hiện đang lưu trú tại khách sạn. Chúc quý khách kỳ nghỉ tuyệt vời!</span>
                        break;
                    case "HoanThanh":
                        <span>Đơn đặt phòng đã được hoàn tất thủ tục thanh toán và trả phòng. Cảm ơn quý khách đã tin tưởng UNETI Hotel!</span>
                        break;
                    case "DaHuy":
                        <span>Đơn đặt phòng này đã được hủy bỏ. Phòng đã được hoàn trả về danh sách sẵn sàng đón khách.</span>
                        break;
                    default:
                        <span>Thông tin cập nhật từ hệ thống quản lý.</span>
                        break;
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Chi tiết phòng, lịch ở, khách hàng -->
        <div class="col-lg-8">
            <!-- 1. Thông tin phòng -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-primary mb-0">
                        <i class="bi bi-door-open me-2"></i>Thông tin phòng đã đặt
                    </h5>
                    @if (Model.Phong != null)
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                            @(Model.Phong.LoaiPhong?.TenLoai ?? "Tiêu chuẩn")
                        </span>
                    }
                </div>

                @if (Model.Phong != null)
                {
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted mb-1">Số phòng</div>
                                <div class="fs-4 fw-bold text-dark">Phòng @Model.Phong.SoPhong</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted mb-1">Đơn giá ngày</div>
                                <div class="fs-4 fw-bold text-primary">@Model.Phong.DonGia.ToString("N0") VNĐ</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Vị trí tầng:</div>
                            <div class="fw-semibold text-dark">Tầng @Model.Phong.Tang @(!string.IsNullOrEmpty(Model.Phong.HuongPhong) ? $" - Hướng {Model.Phong.HuongPhong}" : "")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Sức chứa tối đa:</div>
                            <div class="fw-semibold text-dark">@(Model.Phong.LoaiPhong?.SoNguoiToiDa ?? 2) người lớn</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Phong.TienNghi))
                        {
                            <div class="col-12">
                                <div class="small text-muted">Tiện nghi phòng:</div>
                                <div class="fw-semibold text-dark">@Model.Phong.TienNghi</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border small text-muted mb-0">
                        Thông tin phòng đang cập nhật hoặc chưa được gán.
                    </div>
                }
            </div>

            <!-- 2. Thời gian lưu trú & Số lượng khách -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-calendar-range me-2"></i>Lịch trình lưu trú
                </h5>
                <div class="row g-3 text-center mb-3">
                    <div class="col-md-5">
                        <div class="p-3 bg-light rounded-3">
                            <div class="small text-muted mb-1">📅 Ngày nhận phòng</div>
                            <div class="fw-bold text-dark fs-5">@Model.DatPhong.NgayNhan.ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">Từ 14:00</div>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-center justify-content-center">
                        <div class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
                            ➔ @Model.SoNgayO đêm
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="p-3 bg-light rounded-3">
                            <div class="small text-muted mb-1">📅 Ngày trả phòng dự kiến</div>
                            <div class="fw-bold text-dark fs-5">@Model.DatPhong.NgayTraDuKien.ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">Trước 12:00</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="small text-muted">Số lượng khách đăng ký:</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-people me-1"></i>@Model.DatPhong.SoNguoi người
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">Thời điểm gửi đặt phòng:</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-clock me-1"></i>@Model.DatPhong.NgayDat.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DatPhong.GhiChu))
                    {
                        <div class="col-12">
                            <div class="small text-muted">Ghi chú / Yêu cầu đặc biệt:</div>
                            <div class="p-2 bg-light rounded text-dark fst-italic small">
                                @Model.DatPhong.GhiChu
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 3. Thông tin người đặt phòng -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-person-badge me-2"></i>Thông tin khách hàng
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="small text-muted">Họ và tên khách:</div>
                        <div class="fw-semibold text-dark">@(Model.KhachHang?.HoTen ?? "Chưa rõ")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">Số điện thoại liên hệ:</div>
                        <div class="fw-semibold text-dark">@(Model.KhachHang?.SoDienThoai ?? "Chưa rõ")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">Số CCCD / Hộ chiếu:</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.KhachHang?.CCCD) ? "Chưa cập nhật" : Model.KhachHang.CCCD)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">Email:</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.KhachHang?.Email) ? "Chưa cập nhật" : Model.KhachHang.Email)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng chi phí & Thao tác -->
        <div class="col-lg-4">
            <!-- Thẻ tóm tắt chi phí -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-receipt me-2"></i>Tóm tắt chi phí
                </h5>

                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Đơn giá phòng / ngày:</span>
                    <strong class="text-dark">@(Model.Phong != null ? Model.Phong.DonGia.ToString("N0") : "0") VNĐ</strong>
                </div>

                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Thời gian lưu trú:</span>
                    <strong class="text-dark">@Model.SoNgayO đêm</strong>
                </div>

                <hr class="text-muted opacity-25" />

                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold text-dark">Tổng tiền phòng:</span>
                    <strong class="text-primary fs-5">@Model.DatPhong.TongTien.ToString("N0") VNĐ</strong>
                </div>

                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">Tiền đã đặt cọc:</span>
                    <strong class="text-success">@Model.DatPhong.TienCoc.ToString("N0") VNĐ</strong>
                </div>

                <div class="p-3 bg-light rounded-3 mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-dark">Còn lại cần thanh toán:</span>
                        <span class="fw-bold text-danger fs-5">@Model.ConLaiPhaiThanhToan.ToString("N0") VNĐ</span>
                    </div>
                    <div class="small text-muted mt-1" style="font-size: 0.8rem;">
                        (Thanh toán khi làm thủ tục nhận phòng hoặc trả phòng)
                    </div>
                </div>
            </div>

            <!-- Thao tác hành động -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Thao tác</h5>

                <div class="d-grid gap-2">
                    <!-- Nút quay lại danh sách -->
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Về danh sách lịch sử
                    </a>

                    <!-- Nút Hủy đơn nếu đủ điều kiện -->
                    @if (Model.CoTheHuy)
                    {
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalHuyDon">
                            <i class="bi bi-x-circle me-1"></i>Hủy đơn đặt phòng này
                        </button>

                        <!-- Modal xác nhận hủy -->
                        <div class="modal fade" id="modalHuyDon" tabindex="-1" aria-labelledby="modalHuyDonLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-danger" id="modalHuyDonLabel">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận hủy đặt phòng
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body py-3">
                                        <p class="mb-2">
                                            Quý khách có chắc chắn muốn hủy đơn đặt phòng 
                                            <strong class="text-primary">#@Model.DatPhong.MaDatPhong.ToString("D4")</strong> 
                                            @(Model.Phong != null ? $"(Phòng {Model.Phong.SoPhong})" : "") không?
                                        </p>
                                        <div class="alert alert-warning small mb-0">
                                            <i class="bi bi-info-circle me-1"></i>
                                            <strong>Lưu ý:</strong> Thao tác này sẽ hủy vĩnh viễn đơn đặt phòng và phòng sẽ được mở lại cho khách khác đặt.
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                        <form asp-action="Cancel" asp-route-id="@Model.DatPhong.MaDatPhong" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                                                Xác nhận hủy đơn ngay
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted mb-0">
                            <i class="bi bi-shield-check me-1"></i>
                            Đơn ở trạng thái <strong>@Model.DatPhong.TrangThai</strong> không hỗ trợ hủy trực tuyến. Nếu cần hỗ trợ, vui lòng liên hệ hotline lễ tân.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Giao diện chi tiết đơn đặt phòng (Details) & Hủy đặt phòng an toàn (Restyle UI - nền trắng).
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongChiTietViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.DatPhong.MaDatPhong:D4}";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "customers";

    var (statusColor, statusTone, statusLabel, statusDesc) = Model.DatPhong.TrangThai switch
    {
        "ChoXuLy"    => ("#c9a35d", "warning", "Chờ xử lý",    "Đơn đã ghi nhận, đang chờ lễ tân xử lý. Quý khách có thể hủy nếu thay đổi kế hoạch."),
        "DangXuLy"   => ("#4a9eda", "info",    "Đang xử lý",   "Lễ tân đang kiểm tra phòng và chuẩn bị xác nhận."),
        "DaXacNhan"  => ("#4f8068", "success", "Đã xác nhận",  "Phòng đã được giữ chỗ. Vui lòng xuất trình CCCD khi đến nhận phòng."),
        "DangSuDung" => ("#a06ff0", "info",    "Đang lưu trú", "Quý khách hiện đang lưu trú tại khách sạn. Chúc kỳ nghỉ tuyệt vời!"),
        "HoanThanh"  => ("#4f8068", "success", "Hoàn thành",   "Đơn đã hoàn tất. Cảm ơn quý khách đã tin tưởng UNETI Hotel!"),
        "DaHuy"      => ("#c0392b", "muted",   "Đã hủy",       "Đơn đã bị hủy. Phòng đã được trả về danh sách sẵn sàng."),
        _            => ("#6b7480", "muted",   TrangThaiHelper.HienThi(Model.DatPhong.TrangThai), "")
    };
}

<style>
    .admin-app { background: #ffffff; }

    .bd-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 22px 24px;
        border: 1px solid #e6eaed;
        border-left: 4px solid;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(16, 41, 67, 0.05);
        margin-bottom: 22px;
    }
    .bd-banner__overline { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #6b7480; margin-bottom: 4px; }
    .bd-banner__title { font-family: "Playfair Display", serif; font-size: 21px; color: #172433; margin-bottom: 4px; }
    .bd-banner__desc { font-size: 13px; color: #5d666f; }

    .bd-layout { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }
    @@media (max-width: 820px) { .bd-layout { grid-template-columns: 1fr; } }

    .bd-card {
        background: #fff;
        border: 1px solid #e6eaed;
        border-radius: 6px;
        padding: 22px 24px;
        box-shadow: 0 10px 26px rgba(16, 41, 67, 0.05);
        margin-bottom: 18px;
    }
    .bd-card:last-child { margin-bottom: 0; }
    .bd-card-title {
        font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
        color: #6b7480; padding-bottom: 10px; border-bottom: 1px solid #edf0f2; margin-bottom: 16px;
    }

    .bd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .bd-span2 { grid-column: span 2; }
    @@media (max-width: 560px) { .bd-grid { grid-template-columns: 1fr; } .bd-span2 { grid-column: span 1; } }
    .bd-field small { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7480; margin-bottom: 3px; }
    .bd-field strong { display: block; font-size: 14px; color: #172433; }
    .bd-gold { color: #b28c49 !important; }

    .bd-timeline { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; text-align: center; margin-bottom: 16px; }
    .bd-timeline-box { background: #f7f9fa; border: 1px solid #edf0f2; border-radius: 4px; padding: 14px; }
    .bd-timeline-box small { display: block; font-size: 11px; color: #6b7480; margin-bottom: 4px; }
    .bd-timeline-box strong { display: block; font-size: 17px; color: #172433; }
    .bd-timeline-box span { font-size: 11px; color: #767e88; }
    .bd-timeline-arrow { font-size: 12px; color: #b28c49; white-space: nowrap; }

    .bd-note {
        background: #f7f9fa; border-left: 2px solid #c9a35d; border-radius: 0 4px 4px 0;
        padding: 10px 14px; font-size: 13px; color: #59636d; font-style: italic;
    }

    .bd-summary {
        background: #fff; border: 1px solid #e6eaed; border-radius: 6px; padding: 22px 24px;
        box-shadow: 0 10px 26px rgba(16, 41, 67, 0.05);
        position: sticky; top: 20px;
    }
    .bd-cost-row { display: flex; justify-content: space-between; font-size: 13px; color: #59636d; margin-bottom: 8px; }
    .bd-cost-row strong { color: #172433; }
    .bd-divider { border: none; border-top: 1px solid #edf0f2; margin: 12px 0; }
    .bd-total { background: #fbf7ef; border: 1px solid #efe3cb; border-radius: 4px; padding: 14px 16px; margin: 14px 0 18px; }
    .bd-total small { display: block; font-size: 11px; color: #6b7480; margin-bottom: 4px; }
    .bd-total strong { font-family: "Playfair Display", serif; font-size: 24px; color: #b28c49; }
    .bd-total span { display: block; font-size: 12px; color: #767e88; margin-top: 6px; }

    .bd-btn-back, .bd-btn-cancel {
        display: block; width: 100%; height: 44px; line-height: 44px; text-align: center;
        border-radius: 3px; font-size: 13px; text-decoration: none; transition: all 0.2s;
    }
    .bd-btn-back { border: 1px solid #dce0e3; color: #59636d; background: #fff; margin-bottom: 10px; }
    .bd-btn-back:hover { border-color: #c9a35d; color: #b28c49; }
    .bd-btn-cancel {
        border: 1px solid #f0c2bc; background: #fdecea; color: #c0392b; cursor: pointer;
    }
    .bd-btn-cancel:hover { background: #f9d7d3; }

    .bd-modal-overlay {
        display: none; position: fixed; inset: 0; z-index: 200;
        background: rgba(16, 41, 67, 0.5); align-items: center; justify-content: center; padding: 20px;
    }
    .bd-modal-overlay.show { display: flex; }
    .bd-modal { background: #fff; border-radius: 6px; padding: 26px; max-width: 440px; width: 100%; box-shadow: 0 30px 60px rgba(16, 41, 67, 0.2); }
    .bd-modal h4 { font-family: "Playfair Display", serif; font-size: 18px; color: #c0392b; margin: 0 0 12px; }
    .bd-modal p { font-size: 13px; color: #59636d; margin: 0 0 16px; line-height: 1.6; }
    .bd-modal-warn { background: #fdecea; border: 1px solid #f0c2bc; border-radius: 4px; padding: 10px 12px; font-size: 13px; color: #a93226; margin-bottom: 20px; }
    .bd-modal-actions { display: flex; gap: 10px; }
    .bd-modal-close-btn { flex: 1; height: 40px; background: #fff; border: 1px solid #dce0e3; border-radius: 3px; color: #59636d; cursor: pointer; font-size: 13px; }
    .bd-modal-close-btn:hover { border-color: #adb5bd; }
    .bd-modal-confirm-btn { flex: 1; height: 40px; background: #c0392b; border: none; border-radius: 3px; color: #fff; font-weight: 700; font-size: 13px; cursor: pointer; }
    .bd-modal-confirm-btn:hover { background: #a93226; }
</style>

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Chi tiết đặt phòng</span>
        <h1>Đơn đặt phòng #@Model.DatPhong.MaDatPhong.ToString("D4")</h1>
        <p>Thông tin phòng, lịch trình lưu trú và chi phí của đơn đặt phòng.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a class="admin-secondary" asp-action="LichSu" style="text-decoration:none;">← Lịch sử đặt phòng</a>
        <a class="admin-primary" asp-action="Index" style="text-decoration:none;">Đặt phòng mới</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #4f8068;background:#eef6f2;color:#37614b;font-size: 13px;">✓ @TempData["SuccessMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #c0392b;background:#fdecea;color:#a93226;font-size: 13px;">⚠ @TempData["ErrorMessage"]</p>
}

<div class="bd-banner" style="border-left-color:@statusColor;">
    <div>
        <div class="bd-banner__overline">Trạng thái đơn hàng</div>
        <div class="bd-banner__title">@statusLabel</div>
        @if (!string.IsNullOrEmpty(statusDesc))
        {
            <div class="bd-banner__desc">@statusDesc</div>
        }
    </div>
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <span class="status-badge status-badge--@statusTone"><i></i>@statusLabel</span>
        <span style="font-size: 12px;color:#6b7480;">Mã đơn: <strong style="color:#b28c49;">#@Model.DatPhong.MaDatPhong.ToString("D4")</strong></span>
    </div>
</div>

<div class="bd-layout">
    <!-- Cột trái: thông tin chi tiết -->
    <div>
        <section class="bd-card">
            <div class="bd-card-title">Thông tin phòng đã đặt</div>
            @if (Model.Phong != null)
            {
                <div class="bd-grid">
                    <div class="bd-field">
                        <small>Số phòng</small>
                        <strong class="bd-gold" style="font-family:'Playfair Display',serif;font-size:22px;">Phòng @Model.Phong.SoPhong</strong>
                    </div>
                    <div class="bd-field">
                        <small>Loại phòng</small>
                        <strong class="bd-gold">@(Model.Phong.LoaiPhong?.TenLoai ?? "Tiêu chuẩn")</strong>
                    </div>
                    <div class="bd-field">
                        <small>Đơn giá / đêm</small>
                        <strong class="bd-gold">@Model.Phong.DonGia.ToString("N0")₫</strong>
                    </div>
                    <div class="bd-field">
                        <small>Vị trí &amp; Hướng</small>
                        <strong>Tầng @Model.Phong.Tang @(!string.IsNullOrEmpty(Model.Phong.HuongPhong) ? $"· Hướng {Model.Phong.HuongPhong}" : "")</strong>
                    </div>
                    <div class="bd-field">
                        <small>Sức chứa</small>
                        <strong>@(Model.Phong.LoaiPhong?.SoNguoiToiDa ?? 2) người tối đa</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Phong.TienNghi))
                    {
                        <div class="bd-field bd-span2">
                            <small>Tiện nghi</small>
                            <strong style="font-weight:500;color:#4a5568;">@Model.Phong.TienNghi</strong>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="font-size:13px;color:#6b7480;">Thông tin phòng đang được cập nhật.</p>
            }
        </section>

        <section class="bd-card">
            <div class="bd-card-title">Lịch trình lưu trú</div>
            <div class="bd-timeline">
                <div class="bd-timeline-box">
                    <small>Ngày nhận phòng</small>
                    <strong>@Model.DatPhong.NgayNhan.ToString("dd/MM/yyyy")</strong>
                    <span>Từ 14:00</span>
                </div>
                <div class="bd-timeline-arrow">➔ @Model.SoNgayO đêm</div>
                <div class="bd-timeline-box">
                    <small>Ngày trả phòng</small>
                    <strong>@Model.DatPhong.NgayTraDuKien.ToString("dd/MM/yyyy")</strong>
                    <span>Trước 12:00</span>
                </div>
            </div>
            <div class="bd-grid">
                <div class="bd-field">
                    <small>Số lượng khách</small>
                    <strong>@Model.DatPhong.SoNguoi người</strong>
                </div>
                <div class="bd-field">
                    <small>Thời gian đặt</small>
                    <strong>@Model.DatPhong.NgayDat.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                @if (!string.IsNullOrEmpty(Model.DatPhong.GhiChu))
                {
                    <div class="bd-field bd-span2">
                        <small>Ghi chú / Yêu cầu đặc biệt</small>
                        <div class="bd-note">@Model.DatPhong.GhiChu</div>
                    </div>
                }
            </div>
        </section>

        <section class="bd-card">
            <div class="bd-card-title">Thông tin khách hàng</div>
            <div class="bd-grid">
                <div class="bd-field">
                    <small>Họ và tên</small>
                    <strong>@(Model.KhachHang?.HoTen ?? "Chưa rõ")</strong>
                </div>
                <div class="bd-field">
                    <small>Số điện thoại</small>
                    <strong>@(Model.KhachHang?.SoDienThoai ?? "Chưa rõ")</strong>
                </div>
                <div class="bd-field">
                    <small>CCCD / Hộ chiếu</small>
                    <strong>@(string.IsNullOrEmpty(Model.KhachHang?.CCCD) ? "Chưa cập nhật" : Model.KhachHang.CCCD)</strong>
                </div>
                <div class="bd-field">
                    <small>Email</small>
                    <strong>@(string.IsNullOrEmpty(Model.KhachHang?.Email) ? "Chưa cập nhật" : Model.KhachHang.Email)</strong>
                </div>
            </div>
        </section>
    </div>

    <!-- Cột phải: chi phí & thao tác -->
    <aside class="bd-summary">
        <div class="bd-card-title">Tóm tắt chi phí</div>
        <div class="bd-cost-row">
            <span>Đơn giá / đêm</span>
            <strong>@(Model.Phong != null ? Model.Phong.DonGia.ToString("N0") : "0")₫</strong>
        </div>
        <div class="bd-cost-row">
            <span>Số đêm lưu trú</span>
            <strong>@Model.SoNgayO đêm</strong>
        </div>
        <hr class="bd-divider" />
        <div class="bd-cost-row">
            <span>Tổng tiền phòng</span>
            <strong style="color:#b28c49;font-size:15px;">@Model.DatPhong.TongTien.ToString("N0")₫</strong>
        </div>
        <div class="bd-cost-row">
            <span>Đã đặt cọc</span>
            <strong style="color:#4f8068;">@Model.DatPhong.TienCoc.ToString("N0")₫</strong>
        </div>

        <div class="bd-total">
            <small>Còn lại cần thanh toán</small>
            <strong>@Model.ConLaiPhaiThanhToan.ToString("N0")₫</strong>
            <span>(Thanh toán khi nhận phòng hoặc trả phòng)</span>
        </div>

        <a asp-action="LichSu" class="bd-btn-back">← Về danh sách lịch sử</a>

        @if (Model.CoTheHuy)
        {
            <button type="button" class="bd-btn-cancel" onclick="document.getElementById('modalHuyDon').classList.add('show')">
                ✕ Hủy đơn đặt phòng này
            </button>
        }
        else
        {
            <div style="padding:10px 12px;background:#f7f9fa;border:1px solid #edf0f2;border-radius:3px;font-size: 12px;color:#6b7480;text-align:center;">
                Đơn không hỗ trợ hủy trực tuyến.<br>Liên hệ lễ tân để được hỗ trợ.
            </div>
        }
    </aside>
</div>

@if (Model.CoTheHuy)
{
    <div class="bd-modal-overlay" id="modalHuyDon" onclick="if(event.target===this)this.classList.remove('show')">
        <div class="bd-modal">
            <h4>⚠ Xác nhận hủy đặt phòng</h4>
            <p>Quý khách có chắc chắn muốn hủy đơn đặt phòng <strong style="color:#b28c49">#@Model.DatPhong.MaDatPhong.ToString("D4")</strong>
                @(Model.Phong != null ? $"(Phòng {Model.Phong.SoPhong})" : "") không?</p>
            <div class="bd-modal-warn">
                Thao tác này sẽ hủy yêu cầu đặt phòng và phòng sẽ được giải phóng sẵn sàng đón khách khác.
            </div>
            <div class="bd-modal-actions">
                <button class="bd-modal-close-btn" onclick="document.getElementById('modalHuyDon').classList.remove('show')">Đóng</button>
                <form asp-action="Cancel" asp-route-id="@Model.DatPhong.MaDatPhong" method="post" style="flex:1;display:flex;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bd-modal-confirm-btn" style="width:100%;">Xác nhận hủy</button>
                </form>
            </div>
        </div>
    </div>
}

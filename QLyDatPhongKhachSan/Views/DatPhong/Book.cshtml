@*
// ==========================================
// Họ và tên: Anh Tuấn
// Mã sinh viên: 23103100086
// Nội dung thực hiện: Module 3 - Giao diện đặt phòng (Book) kèm tính toán chi phí realtime (Restyle UI)
// ==========================================
*@

@model QLyDatPhongKhachSan.ViewModels.DatPhongCreateViewModel
@{
    ViewData["Title"] = $"Đặt phòng {Model.SoPhong}";
    Layout = "_HomeLayout";
}

<style>
    .book-wrap {
        min-height: 100vh;
        background: var(--navy-950);
        color: var(--white);
        padding: 0;
    }
    .book-topbar {
        background: rgba(4,15,28,0.95);
        border-bottom: 1px solid rgba(201,163,93,0.2);
        padding: 14px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
    }
    .book-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--white);
    }
    .book-brand-emblem {
        width: 36px;
        height: 40px;
        display: grid;
        place-items: center;
        border: 1px solid var(--gold-500);
        color: var(--gold-400);
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        clip-path: polygon(0 0, 100% 0, 100% 77%, 50% 100%, 0 77%);
    }
    .book-brand-text strong {
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        letter-spacing: 0.08em;
        line-height: 1;
        display: block;
    }
    .book-brand-text small {
        color: var(--gold-400);
        font-size: 8px;
        letter-spacing: 0.36em;
    }
    .book-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255,255,255,0.45);
    }
    .book-breadcrumb a {
        color: rgba(255,255,255,0.45);
        text-decoration: none;
    }
    .book-breadcrumb a:hover { color: var(--gold-400); }
    .book-breadcrumb span { color: rgba(255,255,255,0.25); }

    .book-body {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 60px;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 32px;
        align-items: start;
    }
    @@media (max-width: 820px) {
        .book-body { grid-template-columns: 1fr; }
    }

    .book-section {
        background: rgba(11,27,46,0.7);
        border: 1px solid rgba(201,163,93,0.12);
        border-radius: 6px;
        padding: 28px;
        margin-bottom: 20px;
    }
    .book-section:last-child { margin-bottom: 0; }
    .book-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--gold-400);
        margin: 0 0 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(201,163,93,0.15);
    }

    .book-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
    }
    .book-field:last-child { margin-bottom: 0; }
    .book-field label {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.55);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
    .book-field input,
    .book-field textarea,
    .book-field select {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        background: rgba(4,15,28,0.6);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 3px;
        color: var(--white);
        font-size: 13px;
        box-sizing: border-box;
        transition: border-color 0.2s;
        outline: none;
    }
    .book-field input:focus,
    .book-field textarea:focus {
        border-color: rgba(201,163,93,0.5);
    }
    .book-field textarea {
        height: auto;
        padding: 12px 14px;
        resize: vertical;
    }
    .book-field .val-err {
        color: #e74c3c;
        font-size: 12px;
    }
    .book-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @@media (max-width: 560px) {
        .book-grid-2 { grid-template-columns: 1fr; }
    }

    /* Summary card */
    .book-summary {
        background: rgba(11,27,46,0.85);
        border: 1px solid rgba(201,163,93,0.2);
        border-radius: 6px;
        padding: 28px;
        position: sticky;
        top: 72px;
    }
    .book-room-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, var(--navy-900), var(--navy-800));
        border: 1px solid rgba(201,163,93,0.4);
        border-radius: 6px;
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        font-weight: 700;
        color: var(--gold-400);
        margin-bottom: 12px;
    }
    .book-summary h3 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        margin: 0 0 4px;
    }
    .book-summary-type {
        font-size: 12px;
        color: var(--gold-400);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
    .book-info-list {
        list-style: none;
        padding: 0;
        margin: 16px 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .book-info-list li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 13px;
        color: rgba(255,255,255,0.65);
    }
    .book-info-list li strong { color: rgba(255,255,255,0.9); }
    .book-divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,0.08);
        margin: 16px 0;
    }
    .book-cost-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: rgba(255,255,255,0.6);
        margin-bottom: 8px;
    }
    .book-cost-row strong { color: rgba(255,255,255,0.9); }
    .book-total-box {
        background: rgba(201,163,93,0.08);
        border: 1px solid rgba(201,163,93,0.2);
        border-radius: 4px;
        padding: 14px 16px;
        margin: 16px 0 20px;
    }
    .book-total-label { font-size: 12px; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
    .book-total-amount { font-family: 'Playfair Display', serif; font-size: 26px; color: var(--gold-400); font-weight: 700; }
    .book-remaining { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 4px; }
    .book-remaining span { color: #f5b7b1; font-weight: 600; }

    .book-submit {
        width: 100%;
        height: 48px;
        background: var(--gold-500);
        border: none;
        border-radius: 3px;
        color: var(--navy-950);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }
    .book-submit:hover { background: var(--gold-400); transform: translateY(-1px); }
    .book-back-link {
        display: block;
        text-align: center;
        margin-top: 12px;
        font-size: 13px;
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        transition: color 0.2s;
    }
    .book-back-link:hover { color: var(--gold-400); }

    .book-error-box {
        padding: 12px 16px;
        background: rgba(192,57,43,0.2);
        border: 1px solid rgba(192,57,43,0.5);
        border-radius: 4px;
        color: #f5b7b1;
        font-size: 13px;
        margin-bottom: 20px;
    }
</style>

<div class="book-wrap">
    <nav class="book-topbar">
        <a href="/" class="book-brand">
            <span class="book-brand-emblem">U</span>
            <span class="book-brand-text">
                <strong>UNETI GRAND</strong>
                <small>HOTEL &amp; SPA</small>
            </span>
        </a>
        <div class="book-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>›</span>
            <a asp-controller="DatPhong" asp-action="Index">Đặt phòng</a>
            <span>›</span>
            <span style="color:rgba(255,255,255,0.7);">Đặt phòng @Model.SoPhong</span>
        </div>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="max-width:1100px;margin:20px auto 0;padding:0 24px;">
            <div class="book-error-box">⚠️ @TempData["ErrorMessage"]</div>
        </div>
    }

    <form asp-action="Book" method="post" id="formDatPhong" novalidate>
        @Html.AntiForgeryToken()

        <!-- Hidden fields -->
        <input type="hidden" asp-for="MaPhong" />
        <input type="hidden" asp-for="SoPhong" />
        <input type="hidden" asp-for="TenLoaiPhong" />
        <input type="hidden" asp-for="DonGia" id="txtDonGia" />
        <input type="hidden" asp-for="SoNguoiToiDa" id="txtSoNguoiToiDa" />
        <input type="hidden" asp-for="Tang" />
        <input type="hidden" asp-for="HuongPhong" />
        <input type="hidden" asp-for="TienNghi" />

        <div asp-validation-summary="ModelOnly" class="book-error-box" style="max-width:1100px;margin:20px auto 0;"></div>

        <div class="book-body">
            <!-- Left: Form -->
            <div>
                @if (ViewBag.DanhSachPhongTrong != null)
                {
                    var danhSachPhong = (IEnumerable<QLyDatPhongKhachSan.Models.Phong>)ViewBag.DanhSachPhongTrong;
                    if (danhSachPhong.Any())
                    {
                        <div class="book-section">
                            <h2 class="book-section-title">Chọn phòng đặt</h2>
                            <p style="font-size: 13px;color:rgba(255,255,255,0.55);margin-bottom:12px;">
                                Bạn có thể chọn phòng bên dưới hoặc giữ nguyên phòng mặc định đã chọn (đang có @danhSachPhong.Count() phòng trống sẵn sàng).
                            </p>
                            <div class="book-field">
                                <select id="selectDoiPhong" onchange="if(this.value) window.location.href='@Url.Action("Book", "DatPhong")?maPhong=' + this.value;">
                                    @foreach (var p in danhSachPhong)
                                    {
                                        if (p.MaPhong == Model.MaPhong)
                                        {
                                            <option value="@p.MaPhong" selected>
                                                Phòng @p.SoPhong - @(p.LoaiPhong?.TenLoai ?? "Tiêu chuẩn") - @p.DonGia.ToString("N0") VNĐ/đêm (Tầng @p.Tang, Tối đa @(p.LoaiPhong?.SoNguoiToiDa ?? 2) người)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@p.MaPhong">
                                                Phòng @p.SoPhong - @(p.LoaiPhong?.TenLoai ?? "Tiêu chuẩn") - @p.DonGia.ToString("N0") VNĐ/đêm (Tầng @p.Tang, Tối đa @(p.LoaiPhong?.SoNguoiToiDa ?? 2) người)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                }

                <!-- 1. Thông tin người đặt -->
                <div class="book-section">
                    <h2 class="book-section-title">1. Thông tin người đặt phòng</h2>
                    <div class="book-grid-2">
                        <div class="book-field">
                            <label asp-for="HoTenKhachHang">@Html.DisplayNameFor(m => m.HoTenKhachHang) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="HoTenKhachHang" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="HoTenKhachHang" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="SoDienThoai">@Html.DisplayNameFor(m => m.SoDienThoai) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="SoDienThoai" placeholder="0987 111 222" />
                            <span asp-validation-for="SoDienThoai" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="CCCD">@Html.DisplayNameFor(m => m.CCCD) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="CCCD" placeholder="Số CCCD hoặc Hộ chiếu" />
                            <span asp-validation-for="CCCD" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="Email">@Html.DisplayNameFor(m => m.Email)</label>
                            <input asp-for="Email" type="email" placeholder="example@email.com" />
                            <span asp-validation-for="Email" class="val-err"></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Thời gian lưu trú -->
                <div class="book-section">
                    <h2 class="book-section-title">2. Thời gian lưu trú &amp; Số lượng khách</h2>
                    <div class="book-grid-2">
                        <div class="book-field">
                            <label asp-for="NgayNhan">@Html.DisplayNameFor(m => m.NgayNhan) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="NgayNhan" type="date" id="dtNgayNhan"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NgayNhan" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="NgayTraDuKien">@Html.DisplayNameFor(m => m.NgayTraDuKien) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="NgayTraDuKien" type="date" id="dtNgayTra"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NgayTraDuKien" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="SoNguoi">@Html.DisplayNameFor(m => m.SoNguoi) <span style="color:#e74c3c">*</span></label>
                            <input asp-for="SoNguoi" type="number" min="1" max="@Model.SoNguoiToiDa" />
                            <span style="font-size: 12px;color:rgba(255,255,255,0.4);">Sức chứa tối đa: <strong style="color:var(--gold-400)">@Model.SoNguoiToiDa người</strong></span>
                            <span asp-validation-for="SoNguoi" class="val-err"></span>
                        </div>
                        <div class="book-field">
                            <label asp-for="TienCoc">@Html.DisplayNameFor(m => m.TienCoc)</label>
                            <input asp-for="TienCoc" type="number" step="50000" min="0" id="txtTienCoc" placeholder="0" />
                            <span style="font-size: 12px;color:rgba(255,255,255,0.4);">Có thể để 0 — thanh toán khi nhận phòng</span>
                            <span asp-validation-for="TienCoc" class="val-err"></span>
                        </div>
                    </div>
                    <div class="book-field" style="margin-top:16px;">
                        <label asp-for="GhiChu">@Html.DisplayNameFor(m => m.GhiChu)</label>
                        <textarea asp-for="GhiChu" rows="3"
                                  placeholder="Ghi chú về giờ check-in dự kiến, yêu cầu giường phụ, phòng không hút thuốc..."></textarea>
                        <span asp-validation-for="GhiChu" class="val-err"></span>
                    </div>
                </div>
            </div>

            <!-- Right: Summary -->
            <div class="book-summary">
                <div class="book-room-badge">@Model.SoPhong</div>
                <h3>Phòng @Model.SoPhong</h3>
                <div class="book-summary-type">@Model.TenLoaiPhong</div>

                <ul class="book-info-list">
                    <li>📍 <span>Tầng <strong>@Model.Tang</strong>@(!string.IsNullOrEmpty(Model.HuongPhong) ? $" · Hướng {Model.HuongPhong}" : "")</span></li>
                    <li>👥 <span>Sức chứa tối đa <strong>@Model.SoNguoiToiDa người</strong></span></li>
                    @if (!string.IsNullOrEmpty(Model.TienNghi))
                    {
                        <li>✨ <span><strong>@Model.TienNghi</strong></span></li>
                    }
                </ul>

                <hr class="book-divider" />

                <div class="book-cost-row">
                    <span>Đơn giá / đêm</span>
                    <strong style="color:var(--gold-400)">@Model.DonGia.ToString("N0")₫</strong>
                </div>
                <div class="book-cost-row">
                    <span>Số đêm lưu trú</span>
                    <strong><span id="lblSoDem">1</span> đêm</strong>
                </div>
                <div class="book-cost-row">
                    <span>Tiền đặt cọc</span>
                    <strong style="color:#82d6a5" id="lblTienCoc">0₫</strong>
                </div>

                <div class="book-total-box">
                    <div class="book-total-label">Tổng tiền phòng</div>
                    <div class="book-total-amount" id="lblTongTien">@Model.DonGia.ToString("N0")₫</div>
                    <div class="book-remaining">Còn lại khi nhận phòng: <span id="lblConLai">@Model.DonGia.ToString("N0")₫</span></div>
                </div>

                <button type="submit" class="book-submit">Xác nhận đặt phòng</button>
                <a asp-controller="DatPhong" asp-action="Index" class="book-back-link">← Quay lại danh sách đặt phòng</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dtNgayNhan = document.getElementById("dtNgayNhan");
            const dtNgayTra = document.getElementById("dtNgayTra");
            const txtTienCoc = document.getElementById("txtTienCoc");
            const donGia = parseFloat(document.getElementById("txtDonGia").value) || 0;

            const lblSoDem = document.getElementById("lblSoDem");
            const lblTongTien = document.getElementById("lblTongTien");
            const lblTienCoc = document.getElementById("lblTienCoc");
            const lblConLai = document.getElementById("lblConLai");

            function formatVND(number) {
                return new Intl.NumberFormat('vi-VN').format(Math.max(0, number)) + "₫";
            }

            function tinhToanChiPhi() {
                const nhan = new Date(dtNgayNhan.value);
                const tra = new Date(dtNgayTra.value);

                let soDem = 1;
                if (!isNaN(nhan.getTime()) && !isNaN(tra.getTime())) {
                    const diffTime = tra.getTime() - nhan.getTime();
                    soDem = Math.round(diffTime / (1000 * 60 * 60 * 24));
                    if (soDem < 1) soDem = 1;
                }

                const tongTien = soDem * donGia;
                let tienCoc = parseFloat(txtTienCoc.value) || 0;
                if (tienCoc > tongTien) tienCoc = tongTien;
                const conLai = tongTien - tienCoc;

                lblSoDem.textContent = soDem;
                lblTongTien.textContent = formatVND(tongTien);
                lblTienCoc.textContent = formatVND(tienCoc);
                lblConLai.textContent = formatVND(conLai);
            }

            dtNgayNhan.addEventListener("change", function () {
                if (dtNgayNhan.value) {
                    const nextDay = new Date(dtNgayNhan.value);
                    nextDay.setDate(nextDay.getDate() + 1);
                    const formatted = nextDay.toISOString().split('T')[0];
                    dtNgayTra.min = formatted;
                    if (dtNgayTra.value <= dtNgayNhan.value) {
                        dtNgayTra.value = formatted;
                    }
                }
                tinhToanChiPhi();
            });

            dtNgayTra.addEventListener("change", tinhToanChiPhi);
            txtTienCoc.addEventListener("input", tinhToanChiPhi);

            tinhToanChiPhi();
        });
    </script>
}

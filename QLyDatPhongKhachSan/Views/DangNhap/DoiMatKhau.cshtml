@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Đổi mật khẩu cho tài khoản đang đăng nhập (Restyle UI theo _AdminLayout).
*@
@model QLyDatPhongKhachSan.ViewModels.DoiMatKhauViewModel
@using QLyDatPhongKhachSan.Helpers

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AdminLayout";
    var labelStyle = "font-size: 11px;font-weight:700;color:var(--navy-900);text-transform:uppercase;letter-spacing:0.05em;";
    var inputStyle = "min-height:44px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:13px;";
    var errorStyle = "color:#c0392b;font-size: 12px;";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Tài khoản · Bảo mật</span>
        <h1>Đổi mật khẩu</h1>
        <p>Tài khoản: <strong>@ViewContext.HttpContext.Session.GetTenDangNhap()</strong> — cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
    </div>
    <a class="admin-secondary" asp-controller="Home" asp-action="Index" style="text-decoration:none;">← Về trang chủ</a>
</div>

<div class="dashboard-grid report-grid">
    <article class="dashboard-card" style="padding:28px;max-width:560px;">
        <div class="card-heading" style="margin-bottom:6px;">
            <div><span>Thiết lập</span><h2>Thông tin mật khẩu</h2></div>
        </div>
        <div style="height:1px;background:#edf0f2;margin:16px 0 20px;"></div>

        @if (TempData["SuccessMessage"] != null)
        {
            <p style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #4f8068;background:#eef6f2;color:#37614b;font-size: 13px;">✓ @TempData["SuccessMessage"]</p>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div style="margin-bottom:18px;padding:13px 16px;border-left:3px solid #c0392b;background:#fdecea;color:#a93226;font-size: 13px;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>⚠ @error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="DoiMatKhau" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:18px;">
                <label asp-for="MatKhauHienTai" style="@labelStyle"></label>
                <input asp-for="MatKhauHienTai" type="password" placeholder="Nhập mật khẩu hiện tại..." autofocus style="@inputStyle" />
                <span asp-validation-for="MatKhauHienTai" style="@errorStyle"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:18px;">
                <label asp-for="MatKhauMoi" style="@labelStyle"></label>
                <input asp-for="MatKhauMoi" type="password" placeholder="Mật khẩu mới (ít nhất 6 ký tự)..." style="@inputStyle" />
                <span asp-validation-for="MatKhauMoi" style="@errorStyle"></span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:26px;">
                <label asp-for="XacNhanMatKhau" style="@labelStyle"></label>
                <input asp-for="XacNhanMatKhau" type="password" placeholder="Nhập lại mật khẩu mới..." style="@inputStyle" />
                <span asp-validation-for="XacNhanMatKhau" style="@errorStyle"></span>
            </div>

            <button type="submit" class="admin-primary" style="width:100%;">Xác nhận đổi mật khẩu</button>
        </form>
    </article>

    <article class="dashboard-card revenue-card">
        <div class="card-heading">
            <div><span>Gợi ý</span><h2>Mật khẩu an toàn</h2></div>
        </div>
        <div style="margin-top:18px;font-size: 13px;color:#59636d;line-height:1.9;">
            <div style="display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #edf0f2;"><span style="color:#c9a35d;">✓</span> Dài tối thiểu 6 ký tự, nên kết hợp chữ hoa, chữ thường và số.</div>
            <div style="display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #edf0f2;"><span style="color:#c9a35d;">✓</span> Không trùng với mật khẩu đang sử dụng.</div>
            <div style="display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #edf0f2;"><span style="color:#c9a35d;">✓</span> Không chia sẻ mật khẩu cho người khác.</div>
            <div style="display:flex;gap:10px;padding:9px 0;"><span style="color:#c9a35d;">✓</span> Sau khi đổi, hệ thống yêu cầu đăng nhập lại.</div>
        </div>
    </article>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

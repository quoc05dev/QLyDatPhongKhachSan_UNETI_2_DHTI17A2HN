@*
    Họ và tên: Sinh viên 1
    Mã sinh viên: 23103100091
    Nội dung thực hiện: Giao diện Đổi mật khẩu cho tài khoản đang đăng nhập (Module 1 Restyle UI).
*@
@model QLyDatPhongKhachSan.ViewModels.DoiMatKhauViewModel
@using QLyDatPhongKhachSan.Helpers

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_HomeLayout";
}

<div style="min-height: 100vh; background: var(--navy-950); display: flex; align-items: center; justify-content: center; padding: 40px 20px; color: var(--white); position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(4,15,28,0.95), rgba(11,27,46,0.85)), url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat; opacity: 0.4;"></div>

    <div style="position: relative; z-index: 2; width: 100%; max-width: 440px; background: rgba(11, 27, 46, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(201, 163, 93, 0.25); border-radius: 6px; padding: 36px 32px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);">
        <div style="text-align: center; margin-bottom: 28px;">
            <a href="/" style="display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--white);">
                <span style="width: 40px; height: 44px; display: grid; place-items: center; border: 1px solid var(--gold-500); color: var(--gold-400); font-family: 'Playfair Display', serif; font-size: 24px; clip-path: polygon(0 0, 100% 0, 100% 77%, 50% 100%, 0 77%);">U</span>
                <span style="display: flex; flex-direction: column; align-items: flex-start;">
                    <strong style="font-family: 'Playfair Display', serif; font-size: 18px; letter-spacing: 0.08em; line-height: 1;">UNETI GRAND</strong>
                    <small style="color: var(--gold-400); font-size: 8px; letter-spacing: 0.36em; margin-top: 2px;">HOTEL &amp; SPA</small>
                </span>
            </a>
            <h2 style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 600; margin: 20px 0 6px;">Đổi mật khẩu</h2>
            <p style="color: rgba(255,255,255,0.6); font-size: 13px; margin: 0;">Tài khoản: <strong style="color: var(--gold-400);">@ViewContext.HttpContext.Session.GetTenDangNhap()</strong></p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="padding: 12px 14px; background: rgba(79, 128, 104, 0.2); border: 1px solid rgba(79, 128, 104, 0.5); border-radius: 4px; color: #82d6a5; font-size: 13px; margin-bottom: 20px; text-align: center;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div style="padding: 12px 14px; background: rgba(192, 57, 43, 0.2); border: 1px solid rgba(192, 57, 43, 0.5); border-radius: 4px; color: #f5b7b1; font-size: 13px; margin-bottom: 20px;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>⚠️ @error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="DoiMatKhau" method="post">
            <div style="margin-bottom: 18px;">
                <label asp-for="MatKhauHienTai" style="display: block; font-size: 11px; font-weight: 700; color: var(--gold-400); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;"></label>
                <input asp-for="MatKhauHienTai" type="password" placeholder="Nhập mật khẩu hiện tại..." autofocus style="width: 100%; height: 44px; padding: 0 14px; background: rgba(4, 15, 28, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 3px; color: var(--white); font-size: 13px; box-sizing: border-box;" />
                <span asp-validation-for="MatKhauHienTai" style="color: #e74c3c; font-size: 11px; margin-top: 4px; display: block;"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label asp-for="MatKhauMoi" style="display: block; font-size: 11px; font-weight: 700; color: var(--gold-400); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;"></label>
                <input asp-for="MatKhauMoi" type="password" placeholder="Mật khẩu mới (ít nhất 6 ký tự)..." style="width: 100%; height: 44px; padding: 0 14px; background: rgba(4, 15, 28, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 3px; color: var(--white); font-size: 13px; box-sizing: border-box;" />
                <span asp-validation-for="MatKhauMoi" style="color: #e74c3c; font-size: 11px; margin-top: 4px; display: block;"></span>
            </div>

            <div style="margin-bottom: 28px;">
                <label asp-for="XacNhanMatKhau" style="display: block; font-size: 11px; font-weight: 700; color: var(--gold-400); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;"></label>
                <input asp-for="XacNhanMatKhau" type="password" placeholder="Nhập lại mật khẩu mới..." style="width: 100%; height: 44px; padding: 0 14px; background: rgba(4, 15, 28, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 3px; color: var(--white); font-size: 13px; box-sizing: border-box;" />
                <span asp-validation-for="XacNhanMatKhau" style="color: #e74c3c; font-size: 11px; margin-top: 4px; display: block;"></span>
            </div>

            <button type="submit" class="button button--gold" style="width: 100%; height: 46px; justify-content: center; font-size: 13px; letter-spacing: 0.1em;">
                Xác nhận đổi mật khẩu
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 13px; color: rgba(255,255,255,0.6);">
            <a asp-action="Login" style="color: var(--gold-400); font-weight: 700; text-decoration: none;">← Quay lại đăng nhập</a>
            &nbsp;·&nbsp;
            <a href="/" style="color: rgba(255,255,255,0.5); text-decoration: none;">Về trang chủ</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
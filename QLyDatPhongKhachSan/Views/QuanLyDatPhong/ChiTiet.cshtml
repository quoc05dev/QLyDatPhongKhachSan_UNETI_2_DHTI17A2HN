@* Ho va ten: Nguyen Hai Nam - MSV: 22103100118 *@
@* Noi dung: Module 4 - View chi tiet dat phong, thao tac duyet, check-in, check-out, doi phong va in hoa don *@
@model QLyDatPhongKhachSan.Models.DatPhong

@{
    ViewData["Title"] = "Chi tiết đặt phòng #" + Model.MaDatPhong;

    // Helper map trạng thái sang tiếng Việt
    string MapTrangThai(string? tt) => tt switch
    {
        "ChoXuLy" => "Chờ xử lý",
        "DangXuLy" => "Đang xử lý",
        "DaXacNhan" => "Đã xác nhận",
        "DangSuDung" => "Đang ở",
        "HoanThanh" => "Hoàn thành",
        "DaHuy" => "Đã hủy",
        _ => tt ?? "Không rõ"
    };

    string BadgeClass(string? tt) => tt switch
    {
        "ChoXuLy" => "bg-warning text-dark",
        "DangXuLy" => "bg-secondary",
        "DaXacNhan" => "bg-info text-dark",
        "DangSuDung" => "bg-primary",
        "HoanThanh" => "bg-success",
        "DaHuy" => "bg-danger",
        _ => "bg-secondary"
    };

    bool coTheDoiPhong = Model.TrangThai == "ChoXuLy" || Model.TrangThai == "DangXuLy" || Model.TrangThai == "DaXacNhan";
    var phongDoiKhaDung = ViewBag.PhongDoiKhaDung as Dictionary<int, List<QLyDatPhongKhachSan.Models.Phong>>;
}

<div class="container mt-4">
    <!-- TIÊU ĐỀ IN ẤN (CHỈ HIỂN THỊ KHI IN) -->
    <div class="print-only text-center mb-4">
        <h3 class="fw-bold mb-1">KHÁCH SẠN UNETI HOTEL</h3>
        <p class="mb-1 text-muted small">Địa chỉ: 218 Lĩnh Nam, Hoàng Mai, Hà Nội | Hotline: 1900 6868</p>
        <hr class="my-2" />
        <h4 class="fw-bold text-uppercase mt-2">PHIẾU ĐẶT PHÒNG & HÓA ĐƠN THANH TOÁN</h4>
        <p class="text-muted small">Mã đơn: <strong>#@Model.MaDatPhong</strong> | Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show no-print">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show no-print">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow printable-card">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">ĐƠN ĐẶT PHÒNG #@Model.MaDatPhong</h5>
            <span class="badge @BadgeClass(Model.TrangThai) fs-6">@MapTrangThai(Model.TrangThai)</span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6 class="text-primary fw-bold"><i class="bi bi-person-fill"></i> Thông tin khách hàng:</h6>
                    <p class="mb-1"><strong>Họ tên:</strong> @Model.KhachHang?.HoTen</p>
                    <p class="mb-1"><strong>CCCD / CMND:</strong> @Model.KhachHang?.CCCD</p>
                    <p class="mb-1"><strong>Số điện thoại:</strong> @Model.KhachHang?.SoDienThoai</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-primary fw-bold"><i class="bi bi-calendar-event-fill"></i> Thông tin lưu trú:</h6>
                    <p class="mb-1"><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-1"><strong>Ngày nhận phòng:</strong> @Model.NgayNhan.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-1"><strong>Ngày trả dự kiến:</strong> @Model.NgayTraDuKien.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-1"><strong>Số khách lưu trú:</strong> @Model.SoNguoi người</p>
                </div>
            </div>

            @* Hiển thị Ghi chú / Lý do hủy nếu có *@
            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div class="alert @(Model.TrangThai == "DaHuy" ? "alert-danger" : "alert-secondary") py-2 mb-3">
                    <strong><i class="bi bi-chat-left-text"></i> Ghi chú & Nhật ký xử lý:</strong> @Model.GhiChu
                </div>
            }

            @* Yêu cầu 8.5: Kiểm soát khả năng đáp ứng bằng LINQ đếm dữ liệu liên quan *@
            @if (ViewBag.ThongTinKhaNangDapUng is List<string> khaNangList && khaNangList.Any())
            {
                <div class="alert alert-info py-2 mb-3 no-print">
                    <strong><i class="bi bi-info-circle-fill"></i> Tình trạng khả năng đáp ứng phòng (LINQ kiểm tra):</strong>
                    <ul class="mb-0 ps-3 mt-1">
                        @foreach (var info in khaNangList)
                        {
                            <li>@info</li>
                        }
                    </ul>
                </div>
            }

            <h6 class="fw-bold mt-3 mb-2"><i class="bi bi-door-closed-fill"></i> Danh sách phòng chỉ định:</h6>
            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Số phòng</th>
                            <th>Loại phòng</th>
                            <th>Tầng</th>
                            <th>Đơn giá/ngày</th>
                            <th>Ngày nhận TT</th>
                            <th>Ngày trả TT</th>
                            <th>Số ngày</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                            @if (coTheDoiPhong)
                            {
                                <th class="text-center no-print">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietDatPhongs)
                        {
                            <tr>
                                <td><strong class="text-primary">P.@ct.Phong?.SoPhong</strong></td>
                                <td>@ct.Phong?.LoaiPhong?.TenLoai</td>
                                <td>Tầng @ct.Phong?.Tang</td>
                                <td>@ct.DonGia.ToString("N0") VNĐ</td>
                                <td>@(ct.NgayNhan != default ? ct.NgayNhan.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                <td>@(ct.NgayTra != default ? ct.NgayTra.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                <td>@(ct.SoNgay > 0 ? ct.SoNgay.ToString() : "—")</td>
                                <td>@(ct.ThanhTien > 0 ? ct.ThanhTien.ToString("N0") + " VNĐ" : "—")</td>
                                <td>
                                    @switch (ct.TrangThai)
                                    {
                                        case "ChoNhan":
                                            <span class="badge bg-secondary">Chờ nhận</span>
                                            break;
                                        case "DaNhan":
                                            <span class="badge bg-primary">Đã nhận</span>
                                            break;
                                        case "DaTra":
                                            <span class="badge bg-success">Đã trả</span>
                                            break;
                                        case "DaHuy":
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@ct.TrangThai</span>
                                            break;
                                    }
                                </td>
                                @if (coTheDoiPhong)
                                {
                                    <td class="text-center no-print">
                                        <button type="button" class="btn btn-sm btn-outline-warning" 
                                                data-bs-toggle="modal" data-bs-target="#modalDoiPhong_@ct.MaChiTiet" 
                                                title="Đổi sang phòng trống khác cùng loại">
                                            <i class="bi bi-arrow-left-right"></i> Đổi phòng
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- BẢNG TỔNG HỢP THANH TOÁN (HÓA ĐƠN) -->
            @{
                var tongTien = Model.TongTien;
                var tienCoc = Model.TienCoc;
                var conLai = tongTien - tienCoc;
            }
            <div class="card bg-light mb-4 border">
                <div class="card-body py-3">
                    <div class="row align-items-center text-center">
                        <div class="col-4 border-end">
                            <span class="text-muted d-block small fw-bold">TỔNG TIỀN PHÒNG</span>
                            <span class="fw-bold fs-5 text-primary">@(tongTien > 0 ? tongTien.ToString("N0") + " VNĐ" : "Chờ check-out")</span>
                        </div>
                        <div class="col-4 border-end">
                            <span class="text-muted d-block small fw-bold">TIỀN CỌC ĐÃ TRẢ</span>
                            <span class="fw-bold fs-5 text-info">@tienCoc.ToString("N0") VNĐ</span>
                        </div>
                        <div class="col-4">
                            @if (tongTien > 0)
                            {
                                @if (conLai > 0)
                                {
                                    <span class="text-muted d-block small fw-bold">CÒN PHẢI THANH TOÁN</span>
                                    <span class="fw-bold fs-5 text-danger">@conLai.ToString("N0") VNĐ</span>
                                }
                                else if (conLai == 0)
                                {
                                    <span class="text-muted d-block small fw-bold">TÌNH TRẠNG THANH TOÁN</span>
                                    <span class="fw-bold fs-5 text-success"><i class="bi bi-check-circle-fill"></i> Đã thanh toán đủ</span>
                                }
                                else
                                {
                                    <span class="text-muted d-block small fw-bold">TIỀN THỪA HOÀN LẠI KHÁCH</span>
                                    <span class="fw-bold fs-5 text-warning text-dark">@Math.Abs(conLai).ToString("N0") VNĐ</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted d-block small fw-bold">CÒN PHẢI THANH TOÁN</span>
                                <span class="text-muted fs-6 fst-italic">Tính khi trả phòng</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHỮ KÝ XÁC NHẬN (CHỈ HIỂN THỊ KHI IN) -->
            <div class="print-only mt-5 pt-3">
                <div class="row text-center">
                    <div class="col-6">
                        <p class="fw-bold mb-5">NGƯỜI LẬP PHIẾU / LỄ TÂN</p>
                        <p class="text-muted fst-italic">(Ký và ghi rõ họ tên)</p>
                    </div>
                    <div class="col-6">
                        <p class="fw-bold mb-5">KHÁCH HÀNG XÁC NHẬN</p>
                        <p class="text-muted fst-italic">(Ký và ghi rõ họ tên)</p>
                    </div>
                </div>
            </div>

            <!-- KHU VỰC THAO TÁC LUỒNG TRẠNG THÁI -->
            <div class="border-top pt-3 d-flex gap-2 flex-wrap no-print">
                @* Nút In hóa đơn / Phiếu đặt phòng *@
                <button type="button" class="btn btn-outline-dark" onclick="window.print()">
                    <i class="bi bi-printer"></i> In phiếu / Hóa đơn
                </button>

                @* Bước 1 — Tiếp nhận đơn: ChoXuLy → DangXuLy *@
                @if (Model.TrangThai == "ChoXuLy")
                {
                    <form asp-action="TiepNhanDon" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                        <button type="submit" class="btn btn-info text-white">
                            <i class="bi bi-clipboard-check"></i> Tiếp nhận đơn
                        </button>
                    </form>
                }

                @* Bước 2 — Xác nhận đơn: DangXuLy → DaXacNhan *@
                @if (Model.TrangThai == "DangXuLy")
                {
                    <form asp-action="XacNhanDatPhong" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Xác nhận đặt phòng
                        </button>
                    </form>
                }

                @* Bước 3 — Nhận phòng (Check-in): DaXacNhan → DangSuDung *@
                @if (Model.TrangThai == "DaXacNhan")
                {
                    <form asp-action="CheckIn" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-box-arrow-in-right"></i> Nhận phòng (Check-in)
                        </button>
                    </form>
                }

                @* Bước 4 — Trả phòng (Check-out): DangSuDung → HoanThanh *@
                @if (Model.TrangThai == "DangSuDung")
                {
                    <form asp-action="CheckOut" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                        <button type="submit" class="btn btn-warning text-dark">
                            <i class="bi bi-box-arrow-right"></i> Trả phòng (Check-out)
                        </button>
                    </form>
                }

                @* Từ chối — cho ChoXuLy và DangXuLy *@
                @if (Model.TrangThai == "ChoXuLy" || Model.TrangThai == "DangXuLy")
                {
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalTuChoi">
                        <i class="bi bi-x-lg"></i> Từ chối
                    </button>
                }

                @* Hủy — cho ChoXuLy, DangXuLy, DaXacNhan *@
                @if (Model.TrangThai == "ChoXuLy" || Model.TrangThai == "DangXuLy" || Model.TrangThai == "DaXacNhan")
                {
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalHuy">
                        <i class="bi bi-x-circle"></i> Hủy đặt phòng
                    </button>
                }

                <a asp-action="Index" class="btn btn-secondary ms-auto">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>

@* MODAL ĐỔI PHÒNG CHO TỪNG CHI TIẾT *@
@if (coTheDoiPhong)
{
    @foreach (var ct in Model.ChiTietDatPhongs)
    {
        var phongList = phongDoiKhaDung != null && phongDoiKhaDung.ContainsKey(ct.MaChiTiet) 
            ? phongDoiKhaDung[ct.MaChiTiet] 
            : new List<QLyDatPhongKhachSan.Models.Phong>();

        <div class="modal fade no-print" id="modalDoiPhong_@ct.MaChiTiet" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="DoiPhong" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <input type="hidden" name="maChiTiet" value="@ct.MaChiTiet" />
                    <div class="modal-content">
                        <div class="modal-header bg-warning bg-opacity-25">
                            <h5 class="modal-title">
                                <i class="bi bi-arrow-left-right"></i> Đổi phòng cho khách
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2">
                                <strong>Phòng hiện tại:</strong> P.@ct.Phong?.SoPhong (Tầng @ct.Phong?.Tang - @ct.Phong?.LoaiPhong?.TenLoai)
                            </p>
                            <p class="mb-3 text-muted small">
                                <i class="bi bi-info-circle"></i> Hệ thống chỉ cho phép đổi sang các phòng <strong>cùng Loại phòng</strong> và <strong>còn trống</strong> trong khoảng thời gian từ @Model.NgayNhan.ToString("dd/MM/yyyy") đến @Model.NgayTraDuKien.ToString("dd/MM/yyyy").
                            </p>
                            @if (phongList.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Chọn phòng mới:</label>
                                    <select name="maPhongMoi" class="form-select" required>
                                        <option value="">-- Chọn phòng trống muốn đổi --</option>
                                        @foreach (var p in phongList)
                                        {
                                            <option value="@p.MaPhong">Phòng @p.SoPhong (Tầng @p.Tang - @p.DonGia.ToString("N0") VNĐ/ngày)</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-triangle"></i> Hiện tại không còn phòng trống nào khác cùng loại <strong>@ct.Phong?.LoaiPhong?.TenLoai</strong> trong khoảng thời gian này.
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            @if (phongList.Any())
                            {
                                <button type="submit" class="btn btn-warning">Xác nhận đổi phòng</button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}

<!-- Modal xác nhận lý do hủy -->
<div class="modal fade no-print" id="modalHuy" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="HuyDatPhong" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Xác nhận hủy đặt phòng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Lý do hủy:</label>
                    <textarea name="lyDoHuy" class="form-control" rows="3" required placeholder="Nhập lý do hủy đặt phòng..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal xác nhận lý do từ chối -->
<div class="modal fade no-print" id="modalTuChoi" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="TuChoiDatPhong" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Từ chối đơn đặt phòng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Lý do từ chối:</label>
                    <textarea name="lyDoTuChoi" class="form-control" rows="3" required placeholder="Nhập lý do từ chối đơn..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-outline-danger">Xác nhận từ chối</button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .print-only {
        display: none;
    }
    @@media print {
        header, nav, .navbar, footer, .no-print, .alert.no-print, .btn, .modal {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        body {
            background-color: #fff !important;
            font-size: 13px !important;
            color: #000 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .printable-card {
            border: none !important;
            box-shadow: none !important;
        }
        .card-header {
            background-color: #f8f9fa !important;
            color: #000 !important;
            border-bottom: 2px solid #000 !important;
        }
        .table {
            border-color: #000 !important;
        }
        .table th, .table td {
            border: 1px solid #dee2e6 !important;
        }
    }
</style>
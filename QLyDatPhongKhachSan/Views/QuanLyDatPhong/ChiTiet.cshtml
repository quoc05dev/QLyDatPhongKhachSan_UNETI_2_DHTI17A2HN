@*
    Họ và tên: Nguyễn Hải Nam - MSV: 22103100118
    Nội dung: Module 4 - View chi tiết đặt phòng và các thao tác duyệt, check-in, check-out, hủy (Module 4 Restyle UI)
*@
@model QLyDatPhongKhachSan.Models.DatPhong

@{
    ViewData["Title"] = "Chi tiết đơn #" + Model.MaDatPhong;
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "operations";

    string MapTrangThai(string? tt) => tt switch
    {
        "ChoXuLy" => "Chờ xử lý",
        "DangXuLy" => "Đang xử lý",
        "DaXacNhan" => "Đã xác nhận",
        "DangSuDung" => "Đang ở (Check-in)",
        "HoanThanh" => "Hoàn thành (Check-out)",
        "DaHuy" => "Đã hủy",
        _ => tt ?? "Không rõ"
    };

    string BadgeClass(string? tt) => tt switch
    {
        "ChoXuLy" => "status-badge--warning",
        "DangXuLy" or "DaXacNhan" or "DangSuDung" => "status-badge--info",
        "HoanThanh" => "status-badge--success",
        _ => "status-badge--muted"
    };
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 4 · Chi tiết nghiệp vụ tiếp nhận</span>
        <h1>Chi tiết đơn đặt phòng #@Model.MaDatPhong</h1>
        <p>Kiểm tra thông tin khách hàng, phòng chỉ định, trạng thái giao dịch và thao tác luồng nghiệp vụ.</p>
    </div>
    <a class="admin-secondary" asp-action="Index" style="text-decoration:none;">← Quay lại danh sách</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:12px 16px;background:#eef6f2;border-left:4px solid #46785e;color:#2e5340;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ✓ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚠️ @TempData["Error"]
    </div>
}

@if (TempData["Warning"] != null)
{
    <div style="padding:12px 16px;background:#fff9eb;border-left:4px solid #f39c12;color:#b27b16;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚡ @TempData["Warning"]
    </div>
}

<div class="dashboard-grid" style="grid-template-columns: 2fr 1fr;">
    <article class="dashboard-card" style="padding: 24px;">
        <div class="card-heading" style="margin-bottom: 20px;">
            <div>
                <span>Hồ sơ giao dịch</span>
                <h2>Thông tin đơn &amp; phòng chỉ định</h2>
            </div>
            <span class="status-badge @BadgeClass(Model.TrangThai)">
                <i></i>@MapTrangThai(Model.TrangThai)
            </span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;padding-top:16px;border-top:1px solid #edf0f2;margin-bottom:24px;">
            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Khách hàng</small>
                <strong style="font-size:15px;color:var(--navy-950);">@(Model.KhachHang?.HoTen ?? "—")</strong>
                <small style="display:block;color:#717b85;margin-top:2px;">SĐT: @(Model.KhachHang?.SoDienThoai ?? "—") · CCCD: @(Model.KhachHang?.CCCD ?? "—")</small>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Thời gian lưu trú</small>
                <strong style="font-size:13px;color:var(--navy-950);">@Model.NgayNhan.ToString("dd/MM/yyyy") → @Model.NgayTraDuKien.ToString("dd/MM/yyyy")</strong>
                <small style="display:block;color:#717b85;margin-top:2px;">Số khách: @Model.SoNguoi người · Ngày đặt: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tiền cọc đã thanh toán</small>
                <strong style="font-size:16px;color:#c9a35d;">@Model.TienCoc.ToString("N0")₫</strong>
            </div>

            <div>
                <small style="color:#8a939d;font-size:9px;text-transform:uppercase;font-weight:600;display:block;">Tổng giá trị dự kiến</small>
                <strong style="font-size:18px;color:#46785e;">@(Model.TongTien > 0 ? Model.TongTien.ToString("N0") + "₫" : "—")</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div style="grid-column: span 2;padding:12px;background:#f8fafc;border-left:3px solid #b28c49;border-radius:2px;font-size:12px;">
                    <strong style="color:var(--navy-900);">Ghi chú đơn:</strong> @Model.GhiChu
                </div>
            }
        </div>

        <strong style="font-size:13px;color:var(--navy-900);display:block;margin-bottom:12px;">Danh sách phòng chỉ định:</strong>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Số phòng</th>
                        <th>Loại phòng</th>
                        <th>Tầng</th>
                        <th>Đơn giá</th>
                        <th>Ngày nhận TT</th>
                        <th>Ngày trả TT</th>
                        <th>Số ngày</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ct in Model.ChiTietDatPhongs)
                    {
                        <tr>
                            <td><strong>Phòng @ct.Phong?.SoPhong</strong></td>
                            <td>@(ct.Phong?.LoaiPhong?.TenLoai ?? "—")</td>
                            <td>Tầng @ct.Phong?.Tang</td>
                            <td>@ct.DonGia.ToString("N0")₫</td>
                            <td>@(ct.NgayNhan != default ? ct.NgayNhan.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>@(ct.NgayTra != default ? ct.NgayTra.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>@(ct.SoNgay > 0 ? ct.SoNgay + " ngày" : "—")</td>
                            <td><strong style="color:#b28c49;">@(ct.ThanhTien > 0 ? ct.ThanhTien.ToString("N0") + "₫" : "—")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <article class="dashboard-card" style="padding: 24px;">
        <div class="card-heading" style="margin-bottom: 20px;">
            <div>
                <span>Thao tác luồng trạng thái</span>
                <h2>Vận hành tiếp nhận</h2>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:12px;padding-top:16px;border-top:1px solid #edf0f2;">
            @if (Model.TrangThai == "ChoXuLy")
            {
                <form asp-action="TiepNhanDon" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <button type="submit" class="admin-primary" style="width:100%;">✓ Tiếp nhận đơn</button>
                </form>
            }

            @if (Model.TrangThai == "DangXuLy")
            {
                <form asp-action="XacNhanDatPhong" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <button type="submit" class="admin-primary" style="width:100%;">✓ Xác nhận đặt phòng</button>
                </form>
            }

            @if (Model.TrangThai == "DaXacNhan")
            {
                <form asp-action="CheckIn" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <button type="submit" class="admin-primary" style="width:100%;background:#27ae60;color:#fff;">➔ Nhận phòng (Check-in)</button>
                </form>
            }

            @if (Model.TrangThai == "DangSuDung")
            {
                <form asp-action="CheckOut" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <button type="submit" class="admin-primary" style="width:100%;background:#f39c12;color:#fff;">← Trả phòng (Check-out)</button>
                </form>
            }

            @if (Model.TrangThai == "ChoXuLy" || Model.TrangThai == "DangXuLy" || Model.TrangThai == "DaXacNhan")
            {
                <form asp-action="HuyDatPhong" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <input type="hidden" name="lyDoHuy" value="Hủy từ bảng điều khiển vận hành lễ tân" />
                    <button type="submit" class="admin-secondary" style="width:100%;color:#c0392b;border-color:#f5c6cb;">✕ Hủy đơn đặt phòng</button>
                </form>
            }
        </div>
    </article>
</div>
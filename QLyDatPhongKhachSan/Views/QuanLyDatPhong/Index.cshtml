@*
    Họ và tên: Nguyễn Hải Nam - MSV: 22103100118
    Nội dung: Task 1 - View danh sách tiếp nhận đặt phòng có lọc và phân trang (Module 4 Restyle UI)
*@
@model QLyDatPhongKhachSan.ViewModels.TiepNhanDatPhongViewModel

@{
    ViewData["Title"] = "Tiếp nhận & Quản lý Đặt phòng";
    Layout = "_AdminLayout";
    ViewData["AdminActive"] = "operations";
}

<div class="admin-title-row">
    <div>
        <span class="admin-overline">Module 4 · Quản lý lễ tân &amp; Vận hành</span>
        <h1>Tiếp nhận &amp; Xử lý đặt phòng</h1>
        <p>Quy trình duyệt đơn, xác nhận tiếp nhận, nhận phòng (Check-in) và trả phòng (Check-out).</p>
    </div>
    <a class="admin-primary" asp-controller="Phong" asp-action="Index" style="text-decoration:none;">
        <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
        Tra cứu sơ đồ phòng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:12px 16px;background:#eef6f2;border-left:4px solid #46785e;color:#2e5340;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ✓ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #e74c3c;color:#c0392b;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚠️ @TempData["Error"]
    </div>
}

@if (TempData["Warning"] != null)
{
    <div style="padding:12px 16px;background:#fff9eb;border-left:4px solid #f39c12;color:#b27b16;margin-bottom:20px;font-size:12px;border-radius:2px;">
        ⚡ @TempData["Warning"]
    </div>
}

<article class="dashboard-card data-card">
    <form method="get" asp-action="Index">
        <div class="table-toolbar" style="flex-wrap:wrap;gap:12px;">
            <div class="admin-search" style="min-width:240px;">
                <svg class="admin-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" placeholder="Tên khách, SĐT, Mã đơn..." />
            </div>

            <select name="trangThai">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="ChoXuLy" selected="@(Model.TrangThai == "ChoXuLy")">Chờ xử lý</option>
                <option value="DangXuLy" selected="@(Model.TrangThai == "DangXuLy")">Đang xử lý</option>
                <option value="DaXacNhan" selected="@(Model.TrangThai == "DaXacNhan")">Đã xác nhận</option>
                <option value="DangSuDung" selected="@(Model.TrangThai == "DangSuDung")">Đang ở (Check-in)</option>
                <option value="HoanThanh" selected="@(Model.TrangThai == "HoanThanh")">Hoàn thành (Check-out)</option>
                <option value="DaHuy" selected="@(Model.TrangThai == "DaHuy")">Đã hủy</option>
            </select>

            <select name="maLoaiPhong">
                <option value="">-- Tất cả loại phòng --</option>
                @if (ViewBag.LoaiPhongs != null)
                {
                    foreach (SelectListItem item in ViewBag.LoaiPhongs)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>

            <input type="date" name="tuNgay" value="@(Model.TuNgay.HasValue ? Model.TuNgay.Value.ToString("yyyy-MM-dd") : "")" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:11px;" />
            <input type="date" name="denNgay" value="@(Model.DenNgay.HasValue ? Model.DenNgay.Value.ToString("yyyy-MM-dd") : "")" style="min-height:42px;padding:0 12px;border:1px solid #dce0e3;border-radius:2px;font-size:11px;" />

            <button type="submit" class="admin-primary" style="min-height:42px;padding:0 20px;">Lọc đơn</button>
            <a asp-action="Index" class="admin-secondary" style="min-height:42px;padding:0 16px;text-decoration:none;">Reset</a>
        </div>
    </form>

    <div class="table-result-row">
        <span>Hiển thị tiếp nhận đặt phòng</span>
        <strong>Tổng số: @Model.TongBanGhi đơn (Trang @Model.TrangHienTai / @Model.TongSoTrang)</strong>
    </div>

    @if (Model.DanhSachDatPhong != null && Model.DanhSachDatPhong.Any())
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Thời gian lưu trú</th>
                        <th>Số người</th>
                        <th>Tiền cọc</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DanhSachDatPhong)
                    {
                        var badgeClass = item.TrangThai switch
                        {
                            "ChoXuLy" => "status-badge--warning",
                            "DangXuLy" or "DaXacNhan" => "status-badge--info",
                            "DangSuDung" => "status-badge--info",
                            "HoanThanh" => "status-badge--success",
                            _ => "status-badge--muted"
                        };

                        var tenTrangThai = item.TrangThai switch
                        {
                            "ChoXuLy" => "Chờ xử lý",
                            "DangXuLy" => "Đang xử lý",
                            "DaXacNhan" => "Đã xác nhận",
                            "DangSuDung" => "Đang ở",
                            "HoanThanh" => "Hoàn thành",
                            "DaHuy" => "Đã hủy",
                            _ => item.TrangThai
                        };

                        <tr>
                            <td>
                                <strong>#@item.MaDatPhong</strong>
                                <small>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td><strong style="color:var(--navy-900);">@(item.KhachHang?.HoTen ?? "—")</strong></td>
                            <td>@(item.KhachHang?.SoDienThoai ?? "—")</td>
                            <td>@item.NgayNhan.ToString("dd/MM/yyyy") → @item.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                            <td>@item.SoNguoi người</td>
                            <td>@item.TienCoc.ToString("N0")₫</td>
                            <td>
                                <span class="status-badge @badgeClass"><i></i>@tenTrangThai</span>
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex;gap:6px;">
                                    <a class="admin-primary" style="min-height:30px;padding:0 10px;font-size:9px;text-decoration:none;" asp-action="ChiTiet" asp-route-id="@item.MaDatPhong">Xử lý / Chi tiết</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TongSoTrang > 1)
        {
            <div class="pagination">
                @for (int p = 1; p <= Model.TongSoTrang; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-route-maLoaiPhong="@Model.MaLoaiPhong" style="text-decoration:none;">
                        <button type="button" class="@(p == Model.TrangHienTai ? "active" : "")">@p</button>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-table">
            <strong>Không có đơn tiếp nhận nào</strong>
            <span>Vui lòng thay đổi từ khóa hoặc khoảng ngày tìm kiếm.</span>
        </div>
    }
</article>